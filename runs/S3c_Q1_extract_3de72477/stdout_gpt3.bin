{"completed": true, "response": "<escape>{\n  \"publication\": {\n    \"ref\": \"PMID:36185822; DOI:10.3389/fnsys.2022.995375\",\n    \"title\": \"Abnormal neural oscillations during gait and dual-task in Parkinson's disease\",\n    \"publication_status\": \"review\",\n    \"version_of_candidate\": null,\n    \"study_id_candidate\": \"review_Nwogo_2022\",\n    \"cohort_id_candidate\": \"\",\n    \"cohort_relation_basis\": \"该文为叙述性综述，不是新患者队列研究。其引用的原始研究属于不同研究项目，不能将综述及其引用研究计为独立重复验证。原始研究之间是否存在患者队列重叠，需要依据各原始论文进一步核查。\",\n    \"source_type\": \"secondary\",\n    \"basis\": \"fulltext\",\n    \"fulltext_checked\": true\n  },\n  \"evidence\": [\n\n    {\n      \"eid_local\": \"E01_Chen2019_STN_theta_vulnerability\",\n      \"design\": \"二级转述的原始观察性电生理研究；原始研究：Chen et al., 2019，PMID:31494286，DOI:10.1016/j.nbd.2019.104605。\",\n      \"population\": \"帕金森病患者；研究包括单任务及双任务步行，分析FOG易感步态。综述未转述原始患者的人口学特征。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"本综述没有自有患者队列；引用的原始研究样本分母、有效神经记录数、FOG事件数、试次数及电极触点数均未在综述全文中转述。\",\n      \"endpoint_class\": \"D_susceptibility\",\n      \"event_phase\": \"susceptibility\",\n      \"freezing_phenotype\": \"FOG-vulnerable gait；未报告akinetic、trembling-in-place或其他亚型。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"综述未报告原始研究的Med-On/Med-Off状态及给药时间。\",\n      \"DBS_state_and_parameters\": \"记录来自植入STN DBS电极；综述未报告测试时刺激开关状态、频率、幅度、脉宽及具体触点。特别指出theta活动集中于电极最低触点对。\",\n      \"task\": \"单任务步行和双任务步行；双任务具体认知任务未在本综述中说明。\",\n      \"recording_location\": \"STN局部场电位；theta相关活动位于运动STN DBS电极最低触点对。\",\n      \"measure\": \"STN theta频段相对谱功率；不是burst指标，也不是跨区coherence。\",\n      \"frequency_and_analysis_window\": \"综述总体将theta定义为4–7 Hz；未转述Chen研究的具体分析频带边界、时间窗、基线和归一化细节。\",\n      \"finding\": \"STN theta功率在易冻结步态期间升高，单任务和双任务均有观察。综述将其描述为FOG易感性的频谱相关指标，而非已确认冻结事件的特异性神经标志。\",\n      \"effect_estimate\": \"方向：增加。综述未报告效应量、置信区间或P值。\",\n      \"statistical_unit_and_method\": \"综述未转述患者级、试次级或事件级统计单位，也未报告统计模型。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"全文未报告可复现的数据库、检索式、检索日期、纳入排除标准及筛选流程。\",\n            \"source_locator\": \"全文；未见独立Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对引用的观察性电生理研究进行正式质量或偏倚风险评价。\",\n            \"source_locator\": \"Subcortical oscillations各节及Table 1。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"未报告双人独立数据提取、预设结局或出版偏倚评估。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"这是综述对Chen等人原始研究的转述，不是独立重复队列。易感步态不等于同一试次随后发生的FOG，因此不能将该结果解释为pre_FOG_event_associated。原始研究的iFOG具体算法和分母须回到PMID:31494286核查。\",\n      \"quote\": \"Another study observed increased theta power in the STN LFPs during periods of vulnerable gait in both single-task and dual-task gait in PD patients.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus theta band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E02_Chen2019_STN_beta_vulnerability\",\n      \"design\": \"二级转述的原始观察性电生理研究；原始研究：Chen et al., 2019，PMID:31494286，DOI:10.1016/j.nbd.2019.104605。\",\n      \"population\": \"帕金森病患者；FOG易感步态，包含单任务和双任务步行。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文未转述原始研究各类患者、事件、试次和电极分母；综述本身无患者队列。\",\n      \"endpoint_class\": \"D_susceptibility\",\n      \"event_phase\": \"susceptibility\",\n      \"freezing_phenotype\": \"PDFOG+与PDFOG−；具体FOG运动学亚型未报告。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"unknown；综述未提供该研究测试时的具体药物状态。\",\n      \"DBS_state_and_parameters\": \"STN DBS电极记录；测试刺激状态及频率、幅度、脉宽、触点参数未由综述报告。\",\n      \"task\": \"单任务步行和双任务步行。\",\n      \"recording_location\": \"STN LFP；综述未进一步报告beta效应的具体触点分布。\",\n      \"measure\": \"beta频段相对谱功率；与theta功率分开提取。\",\n      \"frequency_and_analysis_window\": \"综述总体将beta定义为13–30 Hz，并提及约18 Hz的窄带活动；没有报告该研究的具体分析窗口和基线归一化细节。\",\n      \"finding\": \"综述报告PDFOG+在易冻结步态期间具有较高的beta相对功率，单任务和双任务均有观察；约18 Hz窄带活动可能与FOG有关。该结果属于易感性关联，不能据此认定18 Hz活动已经在实际冻结事件中出现。\",\n      \"effect_estimate\": \"方向：PDFOG+易感步态中的beta相对功率较高；约18 Hz关联为定性描述。未报告效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"未转述患者级或试次级统计单位、模型及多重比较校正。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的数据库、检索式、检索日期、纳入排除标准及筛选流程。\",\n            \"source_locator\": \"全文；未见独立Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对引用的观察性电生理研究进行正式质量或偏倚风险评价。\",\n            \"source_locator\": \"Subthalamic nucleus beta band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"未报告双人独立数据提取、预设结局或出版偏倚评估。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"本条与E01来自同一原始研究，不是独立验证。综述没有充分区分易感步态、冻结前同一试次和实际FOG事件。相对功率、绝对功率及窄带峰值不能互换。原始研究需要单独核查iFOG分层和18 Hz分析窗口。\",\n      \"quote\": \"PDFOG + had significantly higher relative power in the beta and theta bands during periods of vulnerable gait in both single and dual-task states.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus beta band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E03_Singh2013_STN_low_beta_freezer_comparison\",\n      \"design\": \"二级转述的原始观察性电生理研究；Singh et al., 2013，Freezing of gait-related oscillatory activity in the human subthalamic nucleus，DOI:10.1016/j.baga.2012.10.002；本综述未提供PMID。\",\n      \"population\": \"帕金森病患者，PDFOG+与PDFOG−组；具体患者数未在综述中报告。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文未转述原始研究的患者、记录、事件、试次或电极分母。\",\n      \"endpoint_class\": \"D_susceptibility\",\n      \"event_phase\": \"non_event_gait\",\n      \"freezing_phenotype\": \"Freezer与Non-Freezer临床分组；FOG具体表现未报告。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"unknown；综述未报告。\",\n      \"DBS_state_and_parameters\": \"STN DBS电极记录；测试刺激状态及参数未在综述中说明。\",\n      \"task\": \"步行；综述没有进一步说明跑步机、直行、转弯或双任务条件。\",\n      \"recording_location\": \"STN LFP。\",\n      \"measure\": \"STN low-beta频段功率；属于平均频谱功率，不是beta burst持续时间或占据率。\",\n      \"frequency_and_analysis_window\": \"综述仅称low beta，未给出该研究的具体频段边界、分析窗口或基线。综述对beta总体定义为13–30 Hz。\",\n      \"finding\": \"PDFOG+患者在步行时表现出高于PDFOG−患者的STN低beta功率。该发现为Freezer与Non-Freezer表型之间的组间关联，不是冻结事件发生前或冻结期间的事件级结果。原始研究DOI:10.1016/j.baga.2012.10.002。\",\n      \"effect_estimate\": \"方向：PDFOG+高于PDFOG−；综述未报告数值效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"综述未报告患者级、试次级统计单位及具体检验方法。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和研究筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对该观察性电生理研究的正式偏倚风险评价。\",\n            \"source_locator\": \"Subthalamic nucleus beta band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"未报告系统化数据提取和选择性报告检查。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"与Chen 2019相比，本研究的组间Freezer表型比较不能直接与易感步态事件级分析等同。低beta功率的增加不代表整个beta频带都增加。该研究与Hell等人的研究存在作者团队及研究机构关联的可能，但本综述没有提供患者重叠证据。\",\n      \"quote\": \"PDFOG + exhibited enhanced low beta frequency power during walking when compared to PDFOG–.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus beta band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E04_Toledo2014_STN_beta_freezer_comparison\",\n      \"design\": \"二级转述的原始观察性电生理研究；Toledo et al., 2014，High beta activity in the subthalamic nucleus and freezing of gait in Parkinson's disease，PMID:24361601，DOI:10.1016/j.nbd.2013.12.005。\",\n      \"population\": \"帕金森病患者，PDFOG+与PDFOG−组；综述没有报告各组人数。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文未转述原始研究各类样本分母。\",\n      \"endpoint_class\": \"D_susceptibility\",\n      \"event_phase\": \"susceptibility\",\n      \"freezing_phenotype\": \"PDFOG+与PDFOG−；亚型未报告。\",\n      \"medication_phenotype\": \"unknown；综述没有明确分类OFF-FOG、ONOFF-FOG或ON-FOG。\",\n      \"experimental_medication_state\": \"该组间比较对应的药物状态未在综述中明确说明。\",\n      \"DBS_state_and_parameters\": \"STN DBS电极；具体测试刺激状态及参数未报告。\",\n      \"task\": \"综述没有明确给出该项组间比较对应的任务或静息状态，不推断为步行。\",\n      \"recording_location\": \"STN LFP；原始研究题名明确涉及STN高beta活动。\",\n      \"measure\": \"STN beta频段功率；综述没有说明绝对功率或相对功率。\",\n      \"frequency_and_analysis_window\": \"综述正文只称beta band，未提供原始分析边界和时间窗；引用原始论文题名为High beta，但不能用题名替代精确频段边界。\",\n      \"finding\": \"PDFOG+患者的STN beta功率高于PDFOG−患者。该结果是患者表型关联，不能直接解释为实际冻结事件期间功率升高。\",\n      \"effect_estimate\": \"方向：PDFOG+较高；综述未报告效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"综述未报告原始研究统计单位和具体方法。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和研究筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对该观察性电生理研究进行正式偏倚风险评价。\",\n            \"source_locator\": \"Subthalamic nucleus beta band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"未报告系统化数据提取及出版偏倚评估。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"本条与E05来自同一原始研究，不应视为两个独立患者队列。综述没有提供该比较的具体测试任务及频段边界，因此不能将它与Singh 2013的low-beta步行结果视为完全相同的实验条件。\",\n      \"quote\": \"reported higher power in the beta band for PDFOG + versus PDFOG–\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus beta band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E05_Toledo2014_STN_beta_levodopa\",\n      \"design\": \"二级转述的原始观察性药物前后比较；Toledo et al., 2014，PMID:24361601，DOI:10.1016/j.nbd.2013.12.005。\",\n      \"population\": \"帕金森病患者，具有FOG表型；具体纳入和分析人数未在综述中报告。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文没有转述原始研究的患者分母、有效神经记录分母或FOG事件计数。\",\n      \"endpoint_class\": \"D_susceptibility\",\n      \"event_phase\": \"susceptibility\",\n      \"freezing_phenotype\": \"FOG患者；具体FOG表现和临床药物反应亚型未报告。\",\n      \"medication_phenotype\": \"unknown；不能仅凭左旋多巴后FOG受到抑制就将患者整体分类为OFF-FOG。\",\n      \"experimental_medication_state\": \"左旋多巴给药前后比较；综述未报告剂量、给药时间及达到ON状态的判定方法。\",\n      \"DBS_state_and_parameters\": \"STN DBS电极；刺激开关状态和具体参数未在综述中报告。\",\n      \"task\": \"综述未明确给出药物前后比较所用任务，不推断为步行或静息。\",\n      \"recording_location\": \"STN LFP。\",\n      \"measure\": \"STN beta频段功率；与临床FOG表现同时观察。\",\n      \"frequency_and_analysis_window\": \"beta频段；综述未提供精确边界、分析窗口、归一化或基线。\",\n      \"finding\": \"左旋多巴给药后，STN beta功率下降，同时FOG事件受到抑制。该结果显示药物状态与神经功率及临床冻结结局共同变化，但综述没有报告事件级神经时间锁定关系。\",\n      \"effect_estimate\": \"beta功率下降，FOG事件受到抑制；综述未提供数值效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"未报告患者级或事件级统计单位及统计检验。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和研究筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对原始药物前后观察研究进行正式偏倚风险评价。\",\n            \"source_locator\": \"Subthalamic nucleus beta band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"未报告药物剂量、测试顺序、盲法、事件识别或预设结局的系统化提取。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"药物前后变化可能同时受到药物状态、运动能力和FOG发生率变化影响。综述没有说明FOG是视频确认、临床评估还是其他方式识别，也没有提供药物剂量和时间，不能据此推断STN beta下降是FOG改善的唯一中介机制。\",\n      \"quote\": \"a reduction in beta power after levodopa administration in conjunction with a suppression of FOG events.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus beta band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E06_Syrkin2017_STN_alpha_entropy_FOG\",\n      \"design\": \"二级转述的原始观察性电生理研究；Syrkin-Nikolau et al., 2017，Subthalamic neural entropy is a feature of freezing of gait in freely moving people with Parkinson's disease，PMID:28890315，DOI:10.1016/j.nbd.2017.09.002。\",\n      \"population\": \"自由活动状态下的帕金森病患者；综述报告PDFOG+与PDFOG−的比较，但没有转述原始样本量。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文未转述该原始研究的患者、事件、试次和触点分母。\",\n      \"endpoint_class\": \"unclear\",\n      \"event_phase\": \"during_FOG\",\n      \"freezing_phenotype\": \"PDFOG+；原文术语为FOG episodes；综述未报告akinetic、trembling-in-place或kinetic无震颤分类。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"综述未报告。\",\n      \"DBS_state_and_parameters\": \"综述未报告该研究测试时的DBS刺激状态及具体参数。\",\n      \"task\": \"STN LFP stepping task；同一引用研究在综述中另被描述为turning and barrier course任务。\",\n      \"recording_location\": \"STN LFP。\",\n      \"measure\": \"alpha频段熵；不是alpha平均功率，也不是beta burst持续时间。综述未说明熵算法。\",\n      \"frequency_and_analysis_window\": \"综述总体将alpha定义为7–13 Hz；未转述原始研究的精确分析频带、熵计算窗口、嵌入维数或归一化参数。\",\n      \"finding\": \"综述报告PDFOG+在FOG episodes期间具有较高的STN alpha entropy。该指标反映时间序列复杂度或不可预测性，不应与alpha功率升高等同。\",\n      \"effect_estimate\": \"方向：FOG期间alpha entropy增加；综述未报告数值效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"综述未转述患者级、事件级统计单位和熵计算方法。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和研究筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对该研究的行为标签、运动学伪迹及重复事件统计进行正式偏倚风险评价。\",\n            \"source_locator\": \"Subthalamic nucleus alpha band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"综述未报告预设熵指标及分析窗口的系统化提取方法。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"综述只明确报告FOG期间alpha entropy增加，没有提供冻结事件的识别方法。因此无法仅凭本综述将该结果归类为视频/临床确认的A_actual_natural或运动学客观识别的B_objective_natural。不能将熵增加解释为alpha平均功率增加。原始研究PMID:28890315应作为独立原始证据核查。\",\n      \"quote\": \"with a higher alpha entropy in PDFOG + during FOG episodes.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus alpha band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E07_Pozzi2019_STN_theta_power_null\",\n      \"design\": \"二级转述的原始观察性事件相关电生理研究；Pozzi et al., 2019，Freezing of gait in Parkinson's disease reflects a sudden derangement of locomotor network dynamics，PMID:31505548，DOI:10.1093/brain/awz141。\",\n      \"population\": \"帕金森病患者；实际步行和FOG episodes比较；综述未报告原始患者分母。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文没有转述该原始研究的患者数、有效神经记录数、FOG事件数、试次数及触点数。\",\n      \"endpoint_class\": \"unclear\",\n      \"event_phase\": \"during_FOG\",\n      \"freezing_phenotype\": \"FOG episodes与effective walking；冻结亚型未报告。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"综述未报告。\",\n      \"DBS_state_and_parameters\": \"STN DBS植入电极；具体测试刺激状态和参数未在综述中说明。\",\n      \"task\": \"实际步行，比较effective walking与FOG episodes。\",\n      \"recording_location\": \"STN LFP；同步记录皮层活动。综述将其描述为STN LFP与scalp EEG同步记录。\",\n      \"measure\": \"STN theta频段平均功率。\",\n      \"frequency_and_analysis_window\": \"综述总体将theta定义为4–7 Hz；原始研究特定分析边界和时间窗未由综述转述。\",\n      \"finding\": \"有效步行与FOG episodes之间没有观察到STN theta功率差异。这是局部STN功率的阴性结果，不能据此推断皮层-STN耦合也没有变化。\",\n      \"effect_estimate\": \"未发现差异；综述未报告具体效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"综述未转述事件级、患者级统计单位或模型。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对原始事件识别、伪迹处理及事件级统计进行正式偏倚风险评价。\",\n            \"source_locator\": \"Subthalamic nucleus theta band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"未报告阴性结局的预设和完整提取流程。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"本条为综述对原始研究的阴性结果转述。局部STN theta功率无差异不代表跨区网络活动无差异，也不代表其他频段没有事件相关变化。综述未提供FOG事件识别标准，endpoint_class保持unclear。\",\n      \"quote\": \"There was no difference between effective walking compared to FOG episodes in both STN theta and alpha power.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus alpha band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E08_Pozzi2019_STN_alpha_power_null\",\n      \"design\": \"二级转述的原始观察性事件相关电生理研究；Pozzi et al., 2019，PMID:31505548，DOI:10.1093/brain/awz141；与E07为同一原始研究。\",\n      \"population\": \"帕金森病患者；effective walking与FOG episodes比较。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文未转述原始研究样本及事件分母。\",\n      \"endpoint_class\": \"unclear\",\n      \"event_phase\": \"during_FOG\",\n      \"freezing_phenotype\": \"FOG episodes；具体亚型未报告。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"unknown\",\n      \"DBS_state_and_parameters\": \"STN DBS植入电极；测试刺激参数未报告。\",\n      \"task\": \"实际步行；effective walking与FOG episodes比较。\",\n      \"recording_location\": \"STN LFP。\",\n      \"measure\": \"STN alpha频段平均功率。\",\n      \"frequency_and_analysis_window\": \"综述总体将alpha定义为7–13 Hz；未报告具体分析窗口和归一化方法。\",\n      \"finding\": \"有效步行与FOG episodes之间没有观察到STN alpha功率差异。此结果与同一研究报告的alpha entropy变化属于不同神经指标，不能相互替代。\",\n      \"effect_estimate\": \"无显著差异的定性报告；综述未提供效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"综述未转述。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对原始事件识别及信号伪迹的正式风险评价。\",\n            \"source_locator\": \"Subthalamic nucleus alpha band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"未报告预设频带结局及数据提取流程。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"与E06为同一原始研究，不是独立重复验证。功率无差异不能推翻熵指标的变化，因为两者描述不同信号属性。综述没有提供原始alpha频带边界及事件分析窗。\",\n      \"quote\": \"There was no difference between effective walking compared to FOG episodes in both STN theta and alpha power.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus alpha band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E09_Pozzi2019_interhemispheric_STN_coupling_null\",\n      \"design\": \"二级转述的原始观察性事件相关电生理研究；Pozzi et al., 2019，PMID:31505548，DOI:10.1093/brain/awz141。\",\n      \"population\": \"帕金森病患者；有效步行与FOG episodes比较。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文未转述患者、事件、试次及触点分母。\",\n      \"endpoint_class\": \"unclear\",\n      \"event_phase\": \"during_FOG\",\n      \"freezing_phenotype\": \"FOG episodes；亚型未报告。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"unknown\",\n      \"DBS_state_and_parameters\": \"双侧STN DBS电极记录；综述没有报告测试刺激参数。\",\n      \"task\": \"步行，比较FOG episodes与effective walking。\",\n      \"recording_location\": \"双侧STN LFP。\",\n      \"measure\": \"双侧STN之间的interhemispheric coupling；具体相干性或其他耦合算法未由综述说明。\",\n      \"frequency_and_analysis_window\": \"综述没有明确指出该阴性耦合结果对应的全部频带、窗口及归一化方法。\",\n      \"finding\": \"FOG episodes与有效步行之间没有观察到STN半球间耦合差异。该结果不能与皮层-STN耦合等同。\",\n      \"effect_estimate\": \"无差异的定性报告；无数值效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"未报告患者级或事件级统计单位及统计方法。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对耦合分析、重复事件和多重比较进行正式风险评价。\",\n            \"source_locator\": \"Subthalamic nucleus theta band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"未报告耦合指标及频带选择的预设标准。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"该结果仅涉及双侧STN耦合，不能推断STN与皮层之间的功能耦合没有改变。综述没有给出具体耦合指标和统计窗口，不能将其解释为所有频段的网络连接均无差异。\",\n      \"quote\": \"no differences in STN theta or interhemispheric STN coupling were observed during FOG episodes when compared to effective walking.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus theta band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E10_Pozzi2019_cortical_STN_alpha_normal_gait\",\n      \"design\": \"二级转述的原始观察性电生理研究；Pozzi et al., 2019，PMID:31505548，DOI:10.1093/brain/awz141。\",\n      \"population\": \"帕金森病患者；有效步行和FOG episodes均涉及该研究，但本条报告正常步行相关活动。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文未转述原始研究分母。\",\n      \"endpoint_class\": \"unclear\",\n      \"event_phase\": \"non_event_gait\",\n      \"freezing_phenotype\": \"FOG患者；正常步行阶段；亚型未报告。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"unknown\",\n      \"DBS_state_and_parameters\": \"STN DBS电极记录；测试刺激参数未报告。\",\n      \"task\": \"正常步行，与FOG episodes比较。\",\n      \"recording_location\": \"皮层-STN网络；综述没有充分区分皮层信号、STN局部信号及跨区耦合的具体贡献。\",\n      \"measure\": \"alpha频段网络活动/功率；综述原文使用alpha power表述，未明确该结果是否为局部功率或耦合指标。\",\n      \"frequency_and_analysis_window\": \"alpha频段；综述总体定义7–13 Hz；具体窗口和归一化未报告。\",\n      \"finding\": \"综述报告正常步行期间皮层-STN网络中的alpha功率较高。该发现提示步行状态存在网络相关alpha活动，但不能据此推断FOG时STN局部alpha功率下降。\",\n      \"effect_estimate\": \"正常步行期间较高；无数值效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"综述未报告。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对原始信号质量、跨区耦合和运动伪迹进行正式偏倚风险评价。\",\n            \"source_locator\": \"Subthalamic nucleus alpha band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"综述未说明该alpha指标的具体算法和预设比较。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"该句的指标描述存在局部功率与网络活动概念上的歧义，不能自动将其解释为STN LFP功率或cortico-STN coherence。该结果与E08不是同一个指标。\",\n      \"quote\": \"alpha power was higher during normal walking in the cortical-STN networks.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus alpha band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n\n    {\n      \"eid_local\": \"E11_Anidi2018_STN_beta_burst_duration_group\",\n      \"design\": \"二级转述的原始观察性电生理研究；Anidi et al., 2018，Neuromodulation targets pathological not physiological beta bursts during gait in Parkinson's disease，PMID:30196050，DOI:10.1016/j.nbd.2018.09.004。\",\n      \"population\": \"帕金森病患者，PDFOG+与PDFOG−；综述未报告患者人数。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文未转述原始研究的患者数、有效STN记录数、事件数、试次数及电极触点数。\",\n      \"endpoint_class\": \"D_susceptibility\",\n      \"event_phase\": \"non_event_gait\",\n      \"freezing_phenotype\": \"PDFOG+与PDFOG−；FOG亚型未报告。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"综述未报告。\",\n      \"DBS_state_and_parameters\": \"植入式Medtronic Activa PC+S sensing neurostimulator；本条组间比较对应的具体刺激状态及参数未由综述说明。\",\n      \"task\": \"步行；综述未明确说明直行、转弯或其他诱发条件。\",\n      \"recording_location\": \"STN LFP。\",\n      \"measure\": \"beta burst持续时间；属于时间域burst特征，不是平均beta功率。\",\n      \"frequency_and_analysis_window\": \"beta频段；综述总体定义为13–30 Hz。burst阈值、持续时间计算方式、分析窗及基线未在综述中报告。\",\n      \"finding\": \"PDFOG+患者步行时具有较长或持续性较强的STN beta bursts，相较PDFOG−患者表现出异常burst持续时间。综述将其描述为FOG相关的病理性神经特征，但没有说明该组间差异是否专门来自实际冻结事件期间。\",\n      \"effect_estimate\": \"方向：PDFOG+的beta burst持续时间较长；未报告数值效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"综述未报告患者级、半球级、试次级或burst级统计单位及模型。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和研究筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对原始研究的样本选择、伪迹处理、burst检测阈值和重复测量进行正式评价。\",\n            \"source_locator\": \"Subthalamic nucleus beta band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"未报告burst持续时间指标的预设及系统化数据提取方法。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"与E12属于同一原始研究，不能视为独立重复。综述没有提供burst持续时间的阈值和统计单位，也没有说明组间差异是否来自实际FOG事件、非冻结步行或两者混合。该研究与Syrkin-Nikolau 2017可能存在患者队列重叠，详见publication.cohort_relation_basis。\",\n      \"quote\": \"sustained beta burst durations in PDFOG + compared to PDFOG– as a pathological neural feature of FOG.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus beta band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E12_Anidi2018_STN_beta_burst_DBS\",\n      \"design\": \"二级转述的原始神经记录与DBS干预研究；Anidi et al., 2018，PMID:30196050，DOI:10.1016/j.nbd.2018.09.004。\",\n      \"population\": \"帕金森病患者，重点涉及PDFOG+患者；综述未报告样本量。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文未转述原始研究的患者、事件、试次及电极分母。\",\n      \"endpoint_class\": \"D_susceptibility\",\n      \"event_phase\": \"non_event_gait\",\n      \"freezing_phenotype\": \"PDFOG+；具体冻结亚型未报告。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"综述未报告。\",\n      \"DBS_state_and_parameters\": \"综述报告DBS期间beta burst持续时间缩短，但未转述刺激频率、幅度、脉宽、触点、刺激方向及各条件具体设置。\",\n      \"task\": \"步行；比较DBS相关神经特征变化及步态运动学变化。\",\n      \"recording_location\": \"STN LFP，Medtronic Activa PC+S sensing neurostimulator。\",\n      \"measure\": \"STN beta burst持续时间；与步态运动学结局分开记录。\",\n      \"frequency_and_analysis_window\": \"beta频段；综述总体定义13–30 Hz。burst检测阈值及时间窗未报告。\",\n      \"finding\": \"DBS期间STN beta burst持续时间缩短，同时步态运动学改善。该结果为神经指标和运动学结局的共同变化，不足以单独证明burst缩短是步态改善的因果中介。\",\n      \"effect_estimate\": \"beta burst持续时间下降，步态运动学改善；综述没有报告变化幅度、CI或P值。\",\n      \"statistical_unit_and_method\": \"综述未报告统计单位、随机化方法、条件顺序或统计模型。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和研究筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"综述没有提供原始干预研究随机化、条件顺序、缺失数据或结局盲法评价。\",\n            \"source_locator\": \"Subthalamic nucleus beta band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"没有提供预设结局、完整干预条件和选择性报告检查。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"这是同一Anidi 2018原始研究的干预相关发现，不应与E11作为两个独立队列。综述没有提供刺激参数及各干预条件的比较细节，不能判断改善是否由特定频率、触点或刺激幅度产生，也不能推断FOG事件减少的具体程度。\",\n      \"quote\": \"The beta burst durations were shortened during DBS along with an improvement in gait kinematics.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus beta band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E13_Singh2013_STN_gamma_walking\",\n      \"design\": \"二级转述的原始观察性电生理研究；Singh et al., 2013，Freezing of gait-related oscillatory activity in the human subthalamic nucleus，DOI:10.1016/j.baga.2012.10.002。\",\n      \"population\": \"帕金森病患者，PDFOG+和PDFOG−两组；综述未提供人数。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文未转述原始研究分母。\",\n      \"endpoint_class\": \"D_susceptibility\",\n      \"event_phase\": \"non_event_gait\",\n      \"freezing_phenotype\": \"PDFOG+和PDFOG−；亚型未报告。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"unknown\",\n      \"DBS_state_and_parameters\": \"STN DBS电极记录；测试刺激状态和参数未在综述中说明。\",\n      \"task\": \"步行。\",\n      \"recording_location\": \"STN LFP。\",\n      \"measure\": \"STN gamma频段功率。\",\n      \"frequency_and_analysis_window\": \"60–90 Hz；综述未报告具体分析窗口、基线及归一化。\",\n      \"finding\": \"PDFOG+与PDFOG−两组在步行期间均表现出STN gamma振荡增加。该发现提示gamma步行调制并非综述所述的FOG+患者独有特征。\",\n      \"effect_estimate\": \"两组均增加；综述未提供两组间差异效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"未报告患者级、试次级统计单位及检验方法。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对原始研究信号伪迹、混杂和重复测量进行正式风险评价。\",\n            \"source_locator\": \"Subthalamic nucleus gamma band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"未报告完整的gamma频段结局提取和选择性报告检查。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"该结果说明gamma功率增加不能仅凭方向作为FOG特异性标志。综述未提供两组效应量，不能判断是否存在组间幅度差异，也不能判断gamma活动是否与冻结事件发生时间相关。\",\n      \"quote\": \"both PDFOG + and PDFOG– displayed an increase of STN gamma oscillations (60–90 Hz) during walking.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus gamma band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E14_Hell2018_STN_alpha_gait_cycle\",\n      \"design\": \"二级转述的原始观察性电生理研究；Hell et al., 2018，Subthalamic oscillatory activity and connectivity during gait in Parkinson's disease，PMID:30035024，DOI:10.1016/j.nicl.2018.05.001。\",\n      \"population\": \"帕金森病患者；综述未提供患者数量或FOG表型构成。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文未转述原始研究患者分母和有效记录分母。\",\n      \"endpoint_class\": \"unclear\",\n      \"event_phase\": \"non_event_gait\",\n      \"freezing_phenotype\": \"综述未报告FOG分组或冻结亚型；该发现是一般步行相关调制。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"综述未报告该alpha调制对应的具体Med-On/Med-Off条件。\",\n      \"DBS_state_and_parameters\": \"Medtronic Activa PC+S sensing neurostimulator；该alpha调制对应的刺激条件和具体参数未在综述中说明。\",\n      \"task\": \"步行；按步态周期分析。\",\n      \"recording_location\": \"双侧STN LFP。\",\n      \"measure\": \"STN alpha频段功率的步态周期锁定调制。\",\n      \"frequency_and_analysis_window\": \"alpha频段；综述总体定义为7–13 Hz。具体步态周期窗口、相位划分和基线未在综述中报告。\",\n      \"finding\": \"STN alpha功率呈现与步态周期锁定的时间调制。该结果属于步行相关生理或技术性调制，综述没有报告它是FOG特异性变化。\",\n      \"effect_estimate\": \"存在步态周期锁定调制；未报告数值效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"综述未报告患者级或步态周期级统计单位及具体方法。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对步态运动伪迹、再传入信号和步态周期重复测量进行正式风险评价。\",\n            \"source_locator\": \"Subthalamic nucleus alpha band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"未报告步态周期分析的预设窗口和完整结果提取方法。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"不是FOG直接证据。综述引用该研究作为STN步行周期调制的背景证据，并不能说明该alpha调制参与冻结发生。必须考虑运动诱发伪迹和再传入信号的可能性。\",\n      \"quote\": \"showed a modulation in alpha frequency power, which was locked to the gait cycle.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus alpha band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E15_Hell2018_STN_high_beta_power_gait\",\n      \"design\": \"二级转述的原始观察性电生理研究；Hell et al., 2018，PMID:30035024，DOI:10.1016/j.nicl.2018.05.001。\",\n      \"population\": \"帕金森病患者；综述未报告FOG患者比例。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文未转述患者、事件、试次和触点分母。\",\n      \"endpoint_class\": \"unclear\",\n      \"event_phase\": \"non_event_gait\",\n      \"freezing_phenotype\": \"未报告FOG分组；一般步行状态。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"综述未报告该具体功率比较的药物条件。\",\n      \"DBS_state_and_parameters\": \"Medtronic Activa PC+S；综述报告DBS状态会影响高beta活动，但没有提供该比较的完整刺激参数。\",\n      \"task\": \"步行，与静息状态比较；具体直行或转弯条件未在综述中说明。\",\n      \"recording_location\": \"STN LFP。\",\n      \"measure\": \"STN high-beta平均功率。\",\n      \"frequency_and_analysis_window\": \"20–30 Hz；综述未提供具体时间窗、归一化方法和患者级分析细节。\",\n      \"finding\": \"STN high-beta功率在步行期间下降。综述还指出刺激状态可能改变这种下降模式。该结果不是FOG事件级结果，不能直接与Freezer和Non-Freezer组间差异视为相互否定。\",\n      \"effect_estimate\": \"步行期间下降；综述未报告效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"未报告患者级、步态周期级或试次级统计单位及方法。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对运动诱发伪迹、刺激状态混杂和重复步态周期的正式风险评价。\",\n            \"source_locator\": \"Subthalamic nucleus beta band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"未报告各刺激状态和步态条件的完整数据提取。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"Hell 2018主要研究一般步行中的STN振荡，并非专门研究FOG。综述明确指出部分步态周期相关信号变化可能来自运动诱发伪迹或再传入活动，因此不能将步行期间beta下降直接解释为病理机制。\",\n      \"quote\": \"a decrease in high beta frequency power (20–30Hz)\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus beta band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E16_Hell2018_STN_high_beta_bilateral_connectivity\",\n      \"design\": \"二级转述的原始观察性电生理研究；Hell et al., 2018，PMID:30035024，DOI:10.1016/j.nicl.2018.05.001。\",\n      \"population\": \"帕金森病患者；一般步行状态，综述未提供FOG分组。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文未转述原始研究分母。\",\n      \"endpoint_class\": \"unclear\",\n      \"event_phase\": \"non_event_gait\",\n      \"freezing_phenotype\": \"未报告。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"unknown\",\n      \"DBS_state_and_parameters\": \"双侧STN植入式记录；刺激状态及参数未由综述完整报告。\",\n      \"task\": \"步行；与静息及不同刺激状态的条件进行比较。\",\n      \"recording_location\": \"双侧STN LFP。\",\n      \"measure\": \"双侧STN高beta频段振荡连接；不是局部平均功率。\",\n      \"frequency_and_analysis_window\": \"高beta相关活动；综述没有给出该耦合指标的具体频带边界和时间窗。\",\n      \"finding\": \"综述报告步行期间双侧振荡连接下降。该变化属于一般步行相关连接调制，不是已确认的FOG事件特异性连接变化。\",\n      \"effect_estimate\": \"方向：下降；无数值效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"综述未转述统计单位和耦合算法。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对双侧信号同步性、伪迹及重复测量的正式风险评价。\",\n            \"source_locator\": \"Subthalamic nucleus beta band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"没有提供完整的连接指标、刺激条件和预设比较。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"该结果不等于FOG期间双侧STN连接必然下降。尤其不能与Pozzi 2019报告的FOG事件期间无interhemispheric STN coupling差异直接合并，因为两篇原始研究的任务、记录条件和比较对象不同。\",\n      \"quote\": \"High beta frequency power (20–30Hz) with bilateral oscillatory connectivity during gait.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus beta band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E17_Hell2018_STN_beta_burst_amplitude\",\n      \"design\": \"二级转述的原始观察性电生理研究；Hell et al., 2018，PMID:30035024，DOI:10.1016/j.nicl.2018.05.001。\",\n      \"population\": \"帕金森病患者；步行与静息状态比较。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文未转述原始研究分母。\",\n      \"endpoint_class\": \"unclear\",\n      \"event_phase\": \"non_event_gait\",\n      \"freezing_phenotype\": \"未报告。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"综述未报告该burst比较的药物状态。\",\n      \"DBS_state_and_parameters\": \"Activa PC+S；比较涉及静息OFF DBS状态，综述未提供完整刺激条件。\",\n      \"task\": \"步行与静息OFF DBS比较。\",\n      \"recording_location\": \"STN LFP。\",\n      \"measure\": \"high-beta burst振幅；与burst持续时间分开提取。\",\n      \"frequency_and_analysis_window\": \"high beta；综述未转述具体burst频带边界、阈值及计算窗口。\",\n      \"finding\": \"步行时整体high-beta burst振幅低于静息OFF DBS状态。该指标与平均谱功率和burst持续时间是不同的神经信号指标。\",\n      \"effect_estimate\": \"方向：下降；综述未报告数值效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"综述未报告burst级或患者级统计单位。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对burst检测、运动伪迹及阈值选择进行正式风险评价。\",\n            \"source_locator\": \"Subthalamic nucleus beta band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"未报告burst振幅完整分布及预设统计方法。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"这是一般步行与静息的比较，不是FOG事件分析。综述提出运动诱发伪迹或再传入信号可能影响此类调制。不能把burst振幅下降解释为FOG改善的直接证据。\",\n      \"quote\": \"A reduction in overall high beta patterns, such as burst amplitude and burst duration, was observed during gait when compared to resting OFF DBS.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus beta band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n    {\n      \"eid_local\": \"E18_Hell2018_STN_beta_burst_duration\",\n      \"design\": \"二级转述的原始观察性电生理研究；Hell et al., 2018，PMID:30035024，DOI:10.1016/j.nicl.2018.05.001。\",\n      \"population\": \"帕金森病患者；步行与静息OFF DBS状态比较。\",\n      \"n_enrolled\": null,\n      \"n_analyzed\": null,\n      \"n_patients_with_FOG\": null,\n      \"n_patients_with_valid_neural_data\": null,\n      \"n_FOG_events\": null,\n      \"n_trials\": null,\n      \"n_electrodes_contacts\": null,\n      \"missing_reason\": \"综述全文未转述原始研究分母。\",\n      \"endpoint_class\": \"unclear\",\n      \"event_phase\": \"non_event_gait\",\n      \"freezing_phenotype\": \"未报告。\",\n      \"medication_phenotype\": \"unknown\",\n      \"experimental_medication_state\": \"综述未报告。\",\n      \"DBS_state_and_parameters\": \"Activa PC+S；比较涉及静息OFF DBS，具体刺激参数未转述。\",\n      \"task\": \"步行与静息OFF DBS比较。\",\n      \"recording_location\": \"STN LFP。\",\n      \"measure\": \"high-beta burst持续时间或lifetime；不是平均beta功率。\",\n      \"frequency_and_analysis_window\": \"high beta；综述未提供具体频带边界、burst检测阈值和持续时间计算方法。\",\n      \"finding\": \"步行时high-beta burst持续时间低于静息OFF DBS状态。该结果与Anidi 2018报告的PDFOG+患者较长beta burst持续时间并非同一比较条件。\",\n      \"effect_estimate\": \"方向：步行期间下降；无数值效应量、CI或P值。\",\n      \"statistical_unit_and_method\": \"综述未报告burst级、患者级统计单位和模型。\",\n      \"risk_of_bias\": {\n        \"tool_or_framework\": \"AMSTAR 2/ROBIS适用性有限；本文为叙述性综述，采用未验证的综述流程审查。\",\n        \"domains\": [\n          {\n            \"domain\": \"文献检索与研究选择\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未报告可复现的检索策略和筛选流程。\",\n            \"source_locator\": \"全文；未见Methods/Search strategy章节。\"\n          },\n          {\n            \"domain\": \"原始研究偏倚风险评价\",\n            \"judgement\": \"not_assessable\",\n            \"reason\": \"未见对burst持续时间计算、伪迹和重复测量进行正式风险评价。\",\n            \"source_locator\": \"Subthalamic nucleus beta band oscillations。\"\n          },\n          {\n            \"domain\": \"数据提取及选择性报告\",\n            \"judgement\": \"unclear\",\n            \"reason\": \"未报告完整的burst持续时间数据提取及选择性报告检查。\",\n            \"source_locator\": \"全文；未见数据提取方法。\"\n          }\n        ],\n        \"overall\": \"not_assessed\"\n      },\n      \"limitations\": \"本条是步行与静息状态比较，不是Freezer与Non-Freezer比较，也不是实际FOG事件内比较。步行相关的burst持续时间缩短可能与运动状态或技术性伪迹有关，不能直接作为与Anidi 2018相矛盾的病理证据。\",\n      \"quote\": \"A reduction in overall high beta patterns, such as burst amplitude and burst duration, was observed during gait when compared to resting OFF DBS.\",\n      \"source_locator\": {\n        \"section\": \"Subcortical oscillations during gait and dual-task > Oscillations in the subthalamic nucleus > Subthalamic nucleus beta band oscillations\",\n        \"page\": null,\n        \"figure_table\": null,\n        \"supplement\": null\n      },\n      \"basis\": \"fulltext\"\n    },\n\n  ],\n  \"cross_study_synthesis\": {\n    \"status\": \"研究者综合，不属于本综述的新增原始患者证据；以下竞争性机制是待检验假设，不应作为原论文直接发现录入。\",\n    \"evidence_conflicts\": [\n      {\n        \"topic\": \"STN beta功率与FOG的关系\",\n        \"observations\": [\n          \"Singh et al. 2013：PDFOG+步行时low-beta功率高于PDFOG−。\",\n          \"Toledo et al. 2014：PDFOG+患者beta功率较高，左旋多巴后beta功率下降并伴随FOG受到抑制。\",\n          \"Chen et al. 2019：FOG易感步态期间beta相对功率增加，单任务和双任务均有观察。\",\n          \"Hell et al. 2018：一般步行期间STN high-beta功率较静息状态下降。\"\n        ],\n        \"interpretation\": \"这些结果不构成严格的直接矛盾。患者表型比较、易感步态比较和步行对静息比较使用了不同的比较基准。low-beta与high-beta也不能合并为单一beta指标。\",\n        \"unresolved\": \"尚不能确定高beta活动是FOG易感性的持续病理特征，还是特定药物、运动状态和任务条件下的短暂活动。\"\n      },\n      {\n        \"topic\": \"STN局部功率与实际冻结事件\",\n        \"observations\": [\n          \"Chen et al. 2019：易感步态期间theta和beta相对功率增加。\",\n          \"Pozzi et al. 2019：effective walking与FOG episodes之间STN theta和alpha功率没有差异。\",\n          \"Pozzi et al. 2019：FOG期间双侧STN耦合没有观察到差异。\"\n        ],\n        \"interpretation\": \"易感性相关的功率变化不一定持续到实际冻结事件。FOG可能存在从易感状态向事件状态转变的动态过程。\",\n        \"unresolved\": \"需要同一患者、同一任务、同一电极和同一分析流程下进行事件前、事件中、恢复期的连续比较。\"\n      },\n      {\n        \"topic\": \"alpha功率与alpha熵\",\n        \"observations\": [\n          \"Syrkin-Nikolau et al. 2017：FOG期间STN alpha entropy增加。\",\n          \"Pozzi et al. 2019：FOG与有效步行之间STN alpha平均功率无差异。\",\n          \"Pozzi et al. 2019：正常步行期间皮层-STN网络alpha活动较高。\"\n        ],\n        \"interpretation\": \"alpha熵和alpha平均功率是不同的信号属性。功率无差异不能否定熵变化，局部STN功率也不能代表皮层-STN网络活动。\",\n        \"unresolved\": \"alpha熵增加究竟是神经网络失稳的表现，还是对步态失稳的代偿性调节，尚未确定。\"\n      },\n      {\n        \"topic\": \"beta burst持续时间与平均beta功率\",\n        \"observations\": [\n          \"Anidi et al. 2018：PDFOG+存在较长的beta burst，DBS期间burst持续时间缩短并伴随步态运动学改善。\",\n          \"Hell et al. 2018：一般步行期间high-beta burst振幅和持续时间较静息OFF DBS状态下降。\"\n        ],\n        \"interpretation\": \"两者比较对象不同。Anidi研究强调Freezer表型及DBS干预；Hell研究强调一般步行与静息状态的差异，且提出运动伪迹解释。\",\n        \"unresolved\": \"burst持续时间的病理意义可能取决于患者表型、运动阶段、刺激状态和检测阈值。\"\n      },\n      {\n        \"topic\": \"gamma活动的FOG特异性\",\n        \"observations\": [\n          \"Singh et al. 2013：PDFOG+与PDFOG−均在步行期间出现STN 60–90 Hz gamma活动增加。\"\n        ],\n        \"interpretation\": \"gamma增加可能主要反映下肢运动相关调制，而非FOG特异性指标。\",\n        \"unresolved\": \"是否存在仅在FOG事件前后出现的gamma瞬态变化，综述没有提供证据。\"\n      }\n    ],\n    \"likely_sources_of_heterogeneity\": [\n      {\n        \"factor\": \"FOG终点定义和事件阶段\",\n        \"details\": \"Freezer与Non-Freezer表型比较、FOG易感步态、实际冻结事件及一般步行不是相同终点。Chen 2019的易感步态结果不能直接与Pozzi 2019的实际事件比较等同。\",\n        \"priority\": \"very_high\"\n      },\n      {\n        \"factor\": \"任务诱发条件\",\n        \"details\": \"单任务、双任务、普通直行、转弯、障碍课程和原地踏步对冻结诱发概率及运动控制要求不同。综述还指出FOG具有随机性，实验室环境可能降低冻结发生概率。\",\n        \"priority\": \"very_high\"\n      },\n      {\n        \"factor\": \"神经信号指标\",\n        \"details\": \"平均谱功率、相对功率、窄带峰值、burst持续时间、burst振幅、entropy及跨区耦合测量的是不同现象。不能将这些指标统称为beta异常或alpha异常。\",\n        \"priority\": \"very_high\"\n      },\n      {\n        \"factor\": \"频带边界\",\n        \"details\": \"low-beta、high-beta及约18 Hz窄带活动的定义并不完全一致。综述没有统一各原始研究的频带边界。\",\n        \"priority\": \"high\"\n      },\n      {\n        \"factor\": \"药物及刺激状态\",\n        \"details\": \"左旋多巴前后、Med-On/Med-Off、DBS-On/DBS-Off以及刺激频率、幅度和触点均可能影响记录。综述没有为所有原始研究提供足够的实验状态信息。\",\n        \"priority\": \"high\"\n      },\n      {\n        \"factor\": \"记录位置及空间分辨率\",\n        \"details\": \"Chen研究的theta活动集中于运动STN电极最低触点对，而不同研究的STN触点位置和覆盖范围未在综述中统一。局部STN功率与皮层-STN网络活动不能互换。\",\n        \"priority\": \"high\"\n      },\n      {\n        \"factor\": \"运动伪迹及再传入活动\",\n        \"details\": \"Hell et al. 2018明确提出部分步态周期锁定的频谱变化可能来自运动诱发伪迹或再传入信号。步行期间的LFP调制不能自动解释为病理性神经活动。\",\n        \"priority\": \"high\"\n      },\n      {\n        \"factor\": \"样本重叠和重复验证\",\n        \"details\": \"Syrkin-Nikolau 2017与Anidi 2018来自Stanford研究团队，具有共同作者、研究中心和Activa PC+S设备背景。可能存在患者队列重叠，但不能据此认定完全相同队列。Singh 2013与Hell 2018也具有Munich研究团队和共同作者关联，患者重叠关系仍为unknown。\",\n        \"priority\": \"high\"\n      }\n    ],\n    \"cohort_deduplication_candidates\": [\n      {\n        \"study_pair\": [\n          \"Syrkin-Nikolau 2017; PMID:28890315\",\n          \"Anidi 2018; PMID:30196050\"\n        ],\n        \"relation\": \"possible_match\",\n        \"cohort_relation\": \"possible_overlap\",\n        \"basis\": \"两项原始研究均来自Stanford团队，均涉及Activa PC+S植入式记录系统，作者存在明显重叠。Anidi 2018原始全文还引用Syrkin-Nikolau 2017作为此前研究，并提及部分患者随疾病进展转变为Freezer。现有依据支持可能存在部分队列重叠，但不足以确认患者级重复。\",\n        \"recommended_handling\": \"在获得两篇原始论文的患者招募日期、基线特征及患者级标识之前，不应作为完全独立的重复验证计数。\"\n      },\n      {\n        \"study_pair\": [\n          \"Singh et al. 2013; DOI:10.1016/j.baga.2012.10.002\",\n          \"Hell et al. 2018; PMID:30035024\"\n        ],\n        \"relation\": \"possible_match\",\n        \"cohort_relation\": \"unknown\",\n        \"basis\": \"研究团队、Munich研究机构及部分作者存在关联，但综述没有提供患者招募时间和患者级重叠证据。\",\n        \"recommended_handling\": \"暂不认定队列重叠，也不在缺乏患者级资料时将其视为确定的独立重复验证。\"\n      },\n      {\n        \"study_pair\": [\n          \"Chen et al. 2019; PMID:31494286\",\n          \"Pozzi et al. 2019; PMID:31505548\"\n        ],\n        \"relation\": \"unknown\",\n        \"cohort_relation\": \"unknown\",\n        \"basis\": \"原始研究涉及不同研究团队和机构，但综述未提供患者级交叉核查资料。\",\n        \"recommended_handling\": \"分别保留原始研究记录，不根据发表年份接近或研究问题相同推断队列关系。\"\n      }\n    ],\n    \"competing_testable_mechanisms\": [\n      {\n        \"mechanism_id\": \"M1_beta_overdrive_vulnerability\",\n        \"name\": \"STN beta过度同步驱动的FOG易感机制\",\n        \"status\": \"hypothesis_not_proven\",\n        \"proposition\": \"STN低beta或高beta活动增强、异常beta burst持续时间延长，可能反映运动网络过度同步，使下肢运动执行受到抑制，提高FOG发生概率。\",\n        \"supporting_evidence\": [\n          \"E02\",\n          \"E03\",\n          \"E04\",\n          \"E05\",\n          \"E11\",\n          \"E12\"\n        ],\n        \"distinguishing_predictions\": [\n          \"同一患者实际FOG发生前，STN beta功率或beta burst持续时间应出现可重复的升高。\",\n          \"beta异常应先于冻结行为，而不只是冻结发生后的伴随变化。\",\n          \"能够选择性缩短病理性beta burst的干预，应降低随后FOG发生率，而不仅改善一般步态速度。\"\n        ],\n        \"testable_design\": \"采用连续双侧STN LFP与同步视频、运动学和肌电记录，按患者内事件进行pre_FOG_event_associated、during_FOG及offset_recovery分段。比较事件前beta功率、burst持续时间及非事件匹配步态，并在随机交叉DBS条件下检验神经变化是否中介FOG发生率变化。\",\n        \"falsification_condition\": \"如果实际FOG发生前没有可重复的beta升高或burst延长，且beta指标与事件发生率无独立关联，则简单的beta过度同步驱动机制受到反证。\"\n      },\n      {\n        \"mechanism_id\": \"M2_phase_transition_instability\",\n        \"name\": \"步态阶段转换与振荡组织失稳机制\",\n        \"status\": \"hypothesis_not_proven\",\n        \"proposition\": \"FOG可能不是持续beta升高状态，而是从易感步态向实际冻结转换时发生的动态振荡组织失稳。易感阶段可能表现为theta/beta功率增加，而实际冻结期间出现alpha entropy增加，局部功率变化未必持续存在。\",\n        \"supporting_evidence\": [\n          \"E01\",\n          \"E02\",\n          \"E06\",\n          \"E07\",\n          \"E08\"\n        ],\n        \"distinguishing_predictions\": [\n          \"同一事件的易感阶段和实际冻结阶段应表现出不同的频谱特征。\",\n          \"alpha entropy的变化可能比平均alpha功率更能区分实际冻结阶段。\",\n          \"事件恢复后，熵和功率指标应呈现与冻结阶段不同的时间变化轨迹。\"\n        ],\n        \"testable_design\": \"建立事件对齐的连续时频分析，使用固定且预注册的频带、滑动窗口和基线，分别计算theta/beta平均功率、alpha entropy、beta burst持续时间及恢复时间。采用患者随机效应的混合模型，避免把多个冻结事件当作独立患者。\",\n        \"falsification_condition\": \"如果各事件阶段的神经指标没有可重复的时间差异，或entropy增加仅由运动伪迹解释，则阶段转换失稳模型不获支持。\"\n      },\n      {\n        \"mechanism_id\": \"M3_cortico_STN_network_coordination\",\n        \"name\": \"皮层-STN网络协调失效机制\",\n        \"status\": \"hypothesis_not_proven\",\n        \"proposition\": \"FOG可能主要来自皮层与STN之间的时间协调失效，而不是STN局部振荡功率本身异常。局部功率可以保持相对稳定，但跨区同步、相位关系或信息传递发生改变。\",\n        \"supporting_evidence\": [\n          \"E07\",\n          \"E08\",\n          \"E09\",\n          \"E10\"\n        ],\n        \"distinguishing_predictions\": [\n          \"FOG发生时，局部STN theta/alpha功率可能没有明显改变，但皮层-STN coherence或相位同步出现事件相关变化。\",\n          \"跨区网络指标应比单一STN功率更好地预测冻结发生。\",\n          \"网络变化可能表现出半球差异，但其方向和侧别需要独立验证。\"\n        ],\n        \"testable_design\": \"同步采集双侧STN LFP和皮层EEG/ECoG，预先定义theta-alpha和beta频带，分别分析局部功率、皮层-STN coherence、相位锁定和双侧STN耦合。将实际冻结事件与成功步行、正常转弯及自主停止进行匹配比较。\",\n        \"falsification_condition\": \"若控制运动伪迹和行为条件后，跨区耦合与FOG发生无关联，而局部功率足以解释事件差异，则网络协调失效机制受到反证。\"\n      },\n      {\n        \"mechanism_id\": \"M4_entropy_compensation_vs_pathology\",\n        \"name\": \"神经熵增加的病理性失稳与代偿性调节竞争机制\",\n        \"status\": \"two_competing_hypotheses\",\n        \"proposition\": \"STN alpha/beta entropy增加可能代表神经活动不可预测性升高，也可能是系统试图通过增加动态复杂性补偿步态控制缺陷。两种解释目前不能区分。\",\n        \"supporting_evidence\": [\n          \"E06\",\n          \"E11\"\n        ],\n        \"distinguishing_predictions\": [\n          \"病理性解释：熵增加先于FOG，且能够独立预测事件发生及严重程度。\",\n          \"代偿性解释：熵增加主要出现在运动控制已经恶化之后，并可能与更好的恢复能力或部分运动学改善相关。\",\n          \"如果仅有冻结期间熵增加而没有时间先后信息，则不能区分因果和代偿解释。\"\n        ],\n        \"testable_design\": \"对同一患者进行连续事件级熵分析，记录FOG发生概率、冻结持续时间、步态对称性和恢复速度；使用滞后分析区分熵变化先于还是晚于行为异常，并通过可控刺激验证改变熵指标是否导致临床结局改变。\",\n        \"falsification_condition\": \"如果熵变化既不预测后续FOG，也不与恢复或步态改善相关，则其作为主要病理机制或代偿机制的解释均缺乏支持。\"\n      },\n      {\n        \"mechanism_id\": \"M5_movement_artifact_reafference\",\n        \"name\": \"步态运动伪迹或感觉再传入造成表观振荡变化\",\n        \"status\": \"methodological_alternative\",\n        \"proposition\": \"部分STN步态相关频谱调制可能由电极运动、身体运动伪迹或感觉再传入引起，而不代表STN神经元群的病理性振荡。\",\n        \"supporting_evidence\": [\n          \"E14\",\n          \"E15\",\n          \"E17\",\n          \"E18\"\n        ],\n        \"distinguishing_predictions\": [\n          \"表观振荡变化与加速度、步态周期和肌电活动高度同步。\",\n          \"采用运动伪迹校正和独立生理信号验证后，部分频谱效应应减弱。\",\n          \"如果某个信号只随运动周期变化，而不随FOG事件状态变化，则其FOG特异性较低。\"\n        ],\n        \"testable_design\": \"同步记录STN LFP、三维加速度、肌电及视频，采用预注册的伪迹处理流程，比较Freezer和Non-Freezer在匹配运动学条件下的信号变化，并设置静息、正常步行、转弯及实际冻结对照。\",\n        \"falsification_condition\": \"若经过独立运动伪迹校正后，神经指标仍然稳定地预测FOG事件，且不能由运动学和肌电变量解释，则纯伪迹机制不足以解释结果。\"\n      }\n    ],\n    \"overall_interpretation\": \"本综述支持STN theta、beta、alpha熵及beta burst特征与帕金森病步态异常和FOG存在关联，但证据的终点层级、任务、信号指标及实验条件存在明显异质性。最重要的区别是FOG易感性与实际冻结事件不能混为一谈。当前不能得出单一的STN beta功率升高机制，也不能把alpha熵增加解释为alpha功率增加。局部振荡幅度、时间动态复杂度和跨区网络耦合应作为不同机制层次独立检验。该文为二级综述，不产生新的独立患者队列，也不能替代对上述原始研究的逐篇全文提取。\"\n  }\n}</escape>", "metadata": {"session_handle": "27abbc93-9550-46d1-8520-c5f20e366513", "session_revision": 0, "session_ttl_max_hours": 6, "job_directory": "D:\\musicclaude\\gpt2agent-safechain\\runs\\gpt3\\pro-bridge-20261113T115109506901Z", "elapsed_seconds": 804.546, "completed_utc": "2026-11-13T12:04:34.056752+00:00", "model": "gpt-6-thinking", "thinking_effort": "max", "temporary": true, "unpersonalized": true, "generation_policy_verified": true, "request_policy": {"model": "gpt-6-thinking", "thinking_effort": "max", "history_and_training_disabled": true, "temporary_chat_requests_personalization": false, "is_do_not_remember": false, "continuation": false, "unpersonalized_inherited_verified": false, "body_sha256": "5e5686bbe37e13771ab13474ffb7759fbd107d987c7021d40b5a4b546b76b2c1", "attachment_count": 0}, "stream_completion": {"sse_done": true, "message_completed": true, "independent_terminal_verified": true}, "profile": "yi/local-codex-auth", "account_sha256": "b3efb6361563c139233ed7b7ef61a7c9afe0bd48d4eb3525dbe31956b024d6da", "transport": "probridge-pure-http", "resume_requests": 0, "topic_connections": 0, "browser_started": false, "Docker_used": false, "automatic_retry": false, "initializer_pss_limit_mib": "not_applicable_no_browser", "attachment_count": 0, "code_sha256": {"tools\\chatgpt_web\\gpt3_cli.py": "96a4cdb6cd5d982f4d1de5b6ba8fae0cf23ee44aa3e41d7fdf6968e3fb590e48", "tools\\chatgpt_web\\gpt3_sessions.py": "83a3ed4ae1efa9f1a2b8ee3f144cc0dc9f668f995a33cc4222308cb3fa31f683", "tools\\chatgpt_web\\gpt3_attachments.py": "eedfa23885000025700f6306b1d1f4582896a7370734be506c156dee532fd7d7"}}, "screenshot_evidence": {"complete": true, "kind": "offline_actual_HTTP_response", "directory": "D:\\musicclaude\\gpt2agent-safechain\\runs\\gpt3\\pro-bridge-20261113T115109506901Z", "files": ["proof-offline.png"], "sha256": {"proof-offline.png": "11196b9f5e647aeea4229fba406aea212352f0ddccb3422ab3e9e67c631d0346"}}}
