  \"reason\": \"样本量较小，招募流程未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"FOG诊断及分组标准未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"信号质量与伪迹\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"摘要指出部分IMU空间参数存在测量误差。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"药物状态及疾病严重程度调整未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"重复测量与伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"步态周期及患者层级统计处理未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"多个步态指标的校正情况未报告。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"模型过拟合与外部验证\",\n                \"judgement\": \"not_applicable\",\n                \"reason\": \"未报告预测模型。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告预注册和完整分析计划。\",\n                \"source_locator\": \"Abstract—Results\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"没有STN信号或FOG事件级神经关联分析。摘要未给出速度变化的独立FOG组间效应量。\",\n          \"quote\": \"diminished spatial parameters of stride length, velocity, and foot clearance\",\n          \"source_locator\": {\n            \"section\": \"Abstract—Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"40871914-E4\",\n          \"design\": \"观察性横断面步态测量研究。\",\n          \"population\": \"30名PD患者，其中15名FOG患者、15名无FOG患者；另有20名健康对照。\",\n          \"n_enrolled\": 50,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": 15,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告实际分析人数、冻结事件数和试次数；IMU不是STN神经记录设备。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"not_reported\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"unknown\",\n          \"DBS_state_and_parameters\": \"未报告。\",\n          \"task\": \"步态测量；具体行走条件未报告。\",\n          \"recording_location\": \"双足IMU；未记录STN。\",\n          \"measure\": \"foot clearance。\",\n          \"frequency_and_analysis_window\": \"未报告。\",\n          \"finding\": \"摘要报告PD患者足部离地间隙下降，并指出运动能力下降在FOG患者中更明显；未给出FOG与非FOG组该指标的独立定量比较。\",\n          \"effect_estimate\": \"未报告组间差值、置信区间或P值。\",\n          \"statistical_unit_and_method\": \"患者级步态参数；统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性可穿戴传感器研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"样本规模较小，招募及排除流程未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"FOG临床诊断及事件标注方法未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"信号质量与伪迹\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"摘要明确指出IMU minimum clearance测量误差较高。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"药物状态及疾病严重程度调整情况未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"重复测量与伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"步态周期的患者内聚类处理未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"多个运动学指标的校正情况未报告。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"模型过拟合与外部验证\",\n                \"judgement\": \"not_applicable\",\n                \"reason\": \"未报告预测模型。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"预注册及完整分析计划未报告。\",\n                \"source_locator\": \"Abstract—Results\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"摘要另外指出IMU minimum clearance测量误差较高，但没有提供误差数值。不能将该运动学测量解释为STN活动或FOG事件级生物标志物。\",\n          \"quote\": \"the minimum clearance showed a higher measurement error\",\n          \"source_locator\": {\n            \"section\": \"Abstract—Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:40871963\",\n        \"title\": \"The Usefulness of Wearable Sensors for Detecting Freezing of Gait in Parkinson's Disease: A Systematic Review.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"系统综述纳入43篇论文，摘要未提供原始研究PMID/DOI清单或患者队列匹配信息。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"40871963-E1\",\n          \"design\": \"Systematic review；PubMed、IEEE Xplore和ACM Digital Library检索；43篇论文纳入综述。\",\n          \"population\": \"PD可穿戴传感器FOG检测研究；纳入研究的患者人数范围为1至205人，摘要未提供总患者数。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"43是研究篇数，不是患者数；摘要未报告跨研究合并患者数、事件数或试次数。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"unclear\",\n          \"freezing_phenotype\": \"not_reported\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"综述提取了ON/OFF药物状态，但摘要未报告具体分布。\",\n          \"DBS_state_and_parameters\": \"未报告STN-DBS或刺激参数。\",\n          \"task\": \"纳入研究包含实验室及自然环境步态任务；各研究任务不一致。\",\n          \"recording_location\": \"腰部、踝部、小腿及足部等可穿戴传感器位置；不是STN神经记录。\",\n          \"measure\": \"加速度计和陀螺仪组合的FOG检测性能，包括sensitivity和specificity。\",\n          \"frequency_and_analysis_window\": \"不同原始研究的信号处理频段、窗口及算法不同；摘要未提供统一参数。\",\n          \"finding\": \"综述指出，加速度计与陀螺仪组合是报告表现最好的传感器配置，FOG检测灵敏度和特异度接近100%。该数值是综述对纳入研究结果的总结，不能视为统一队列的独立验证结果或STN神经指标。\",\n          \"effect_estimate\": \"综述报告nearly 100% sensitivity and specificity；未提供合并效应量、置信区间或具体研究间异质性。\",\n          \"statistical_unit_and_method\": \"研究级综述总结；摘要未报告Meta分析或统一统计模型。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域的摘要级初评。\",\n            \"domains\": [\n              {\n                \"domain\": \"检索范围\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"检索了三个数据库，但摘要未提供完整检索式、灰色文献及注册平台检索情况。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"研究选择\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"报告328篇检索结果及43篇纳入，但未说明是否由两名独立研究者筛选。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"原始研究偏倚评价\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未报告纳入研究的正式偏倚风险评价。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"数据提取\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"报告提取传感器、药物状态、任务和算法等信息，但未说明重复提取及核对程序。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"证据综合\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"接近100%的检测性能未说明是否来自单项研究、特定配置或跨研究合并。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未提供注册方案及完整预设分析清单。\",\n                \"source_locator\": \"Abstract—Results\"\n              }\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"secondary evidence，不是新的患者队列。综述报告的接近100%性能不能直接迁移到STN-LFP或自然环境FOG检测。摘要未给出支持该性能结论的原始研究PMID/DOI。\",\n          \"quote\": \"The best overall sensor configuration reported was the accelerometer and gyroscope setup, achieving nearly 100% sensitivity and specificity for FoG detection.\",\n          \"source_locator\": {\n            \"section\": \"Abstract—Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"40871963-E2\",\n          \"design\": \"Systematic review；43篇研究纳入。\",\n          \"population\": \"在自然环境中进行FOG检测的PD患者研究；摘要报告9篇研究关注real-life context。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"9为研究篇数，不是患者或FOG事件数；摘要未报告自然环境研究的患者总数及事件总数。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"unclear\",\n          \"freezing_phenotype\": \"not_reported\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"各研究可能包含ON/OFF状态；具体分布未报告。\",\n          \"DBS_state_and_parameters\": \"未报告。\",\n          \"task\": \"自然环境、真实生活情境下的FOG检测。\",\n          \"recording_location\": \"可穿戴身体传感器；具体位置在不同研究间不同。\",\n          \"measure\": \"自然环境FOG检测性能及其对噪声和非预期活动的敏感性。\",\n          \"frequency_and_analysis_window\": \"各研究不同，摘要未报告。\",\n          \"finding\": \"仅9篇研究关注真实生活环境FOG检测。综述报告这些研究取得了有希望的结果，但由于信号噪声增加和患者非预期活动，检测表现明显不如实验室环境一致。\",\n          \"effect_estimate\": \"未报告自然环境研究的合并灵敏度、特异度或置信区间。\",\n          \"statistical_unit_and_method\": \"研究级定性综合；具体统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域的摘要级初评。\",\n            \"domains\": [\n              {\n                \"domain\": \"检索范围\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"使用三个数据库，但完整检索策略未提供。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"研究选择\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告独立筛选及分歧解决方法。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"原始研究偏倚评价\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未报告纳入研究的正式偏倚风险评价。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"证据综合\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"自然环境研究的结果以定性描述呈现，未报告研究间异质性分析。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"无法从摘要判断选择性报告。\",\n                \"source_locator\": \"Abstract—Results\"\n              }\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"这是检测方法学的secondary evidence，不涉及STN神经活动。其结果提示实验室与自然环境FOG标签质量可能存在差异，但不能作为STN活动与FOG的直接证据。\",\n          \"quote\": \"Real-life context for FoG detection was the focus of only nine studies that reported promising results but much less consistent performance due to increased signal noise and unexpected patient activity.\",\n          \"source_locator\": {\n            \"section\": \"Abstract—Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:40880117\",\n        \"title\": \"Subthalamic Theta-Alpha Local Field Potentials in OFF-Levodopa Dystonia in Parkinson's Disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告14名双侧STN-DBS患者，但没有提供与其他给定论文可匹配的中心、招募时间及队列信息。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"40880117-E1\",\n          \"design\": \"观察性患者电生理比较研究；按是否存在下肢肌张力障碍比较STN-LFP频谱峰值。\",\n          \"population\": \"14名接受双侧STN-DBS的PD患者，其中4名存在下肢肌张力障碍。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 14,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": 14,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要报告14名纳入患者及28个半球的分析，但未报告电极接触点总数、FOG患者数、FOG事件或试次数。研究的临床表型是dystonia，不是FOG。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"unclear\",\n          \"freezing_phenotype\": \"not_reported\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"OFF-levodopa；具体停药时长及剂量未报告。\",\n          \"DBS_state_and_parameters\": \"所有患者均有双侧STN-DBS及bidirectional DBS设备；记录时刺激是否开启、频率、幅度、脉宽及触点未在摘要中报告。\",\n          \"task\": \"按肌张力障碍存在与否比较STN-LFP频谱；未报告步行或FOG诱发任务。\",\n          \"recording_location\": \"Subthalamic nucleus，双侧STN-LFP。\",\n          \"measure\": \"STN局部场电位最大幅值所对应的频率峰值；不是平均beta功率、beta burst持续时间或相位耦合分析。\",\n          \"frequency_and_analysis_window\": \"Theta-alpha：4–10 Hz；beta：11.5–35 Hz。分析窗口、基线、归一化和滤波细节未在摘要中报告。\",\n          \"finding\": \"在7个与肌张力障碍相关的半球中，3个半球（42.9%）的最大幅值活动位于theta-alpha频段；21个无肌张力障碍相关的半球均表现为beta频段最大STN活动。摘要报告组间P=0.011。\",\n          \"effect_estimate\": \"Dystonia-associated hemispheres：3/7（42.9%）theta-alpha峰值；non-dystonia hemispheres：21/21 beta峰值；P=0.011。未报告置信区间。\",\n          \"statistical_unit_and_method\": \"半球级统计（7个与dystonia相关半球、21个无dystonia相关半球）；具体统计检验未报告。28个半球来自14名患者，摘要未说明患者内聚类校正。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性植入式电生理研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"样本仅14名PD患者，摘要未报告连续入组及完整排除标准。\",\n                \"source_locator\": \"Abstract—Methods/Results\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要说明下肢dystonia，但未说明临床评估量表或诊断判定方法；没有FOG标签。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"信号质量与伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告LFP伪迹剔除、信号质量阈值及接触点质量控制。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"虽然标题指明OFF-levodopa状态，但其他药物、刺激状态及临床特征调整未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"重复测量与伪重复\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"统计以28个半球为单位，来自14名双侧植入患者；摘要未说明患者内相关性的处理。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告频段及其他比较的多重检验校正。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"模型过拟合与外部验证\",\n                \"judgement\": \"not_applicable\",\n                \"reason\": \"摘要未报告机器学习预测模型。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未提供预注册分析计划及完整频谱分析结果。\",\n                \"source_locator\": \"Abstract—Results\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"这是STN神经活动与dystonia的关联证据，不是STN与FOG的关联证据。摘要未报告FOG表型、FOG事件、FOG患者人数或自然步行任务。不能把theta-alpha活动直接解释为FOG生物标志物。半球级统计还需要审查患者内伪重复问题。\",\n          \"quote\": \"In 3/7 hemispheres affected by dystonia (42.9%), maximum amplitude LFP activity occurred in the theta-alpha band (4-10 Hz).\",\n          \"source_locator\": {\n            \"section\": \"Abstract—Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:40884235\",\n        \"title\": \"Differences in configurations of the six-minute walk test for people with Parkinson disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要未提供患者人数、研究中心、招募时间及与其他FOG研究的队列匹配信息。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:40893837\",\n        \"title\": \"The impact of Parkinson's Disease on interlimb coordination: a scoping review of gait adaptability.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"综述纳入14项研究；摘要未提供原始研究PMID/DOI清单或可用于队列匹配的信息。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"40893837-E1\",\n          \"design\": \"Scoping review；检索710项研究，14项符合纳入标准；纳入研究的偏倚风险使用Downs and Black工具评估。\",\n          \"population\": \"PD患者，包括有FOG及无FOG患者；14项研究的合并患者人数未在摘要中报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要报告14项研究而非患者总数；未提供各研究FOG患者人数、事件数或试次数。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"not_reported\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"unknown\",\n          \"DBS_state_and_parameters\": \"未报告STN-DBS或刺激参数。\",\n          \"task\": \"跑台或地面步行；各原始研究任务不完全相同。\",\n          \"recording_location\": \"步态及肢体运动学测量；未报告STN或其他深部核团神经记录。\",\n          \"measure\": \"肢间协调，包括synchronization delays、phase shifts及Phase Coordination Index（PCI）。\",\n          \"frequency_and_analysis_window\": \"不适用；摘要未报告神经信号频段或电生理分析窗口。\",\n          \"finding\": \"综述报告PD患者存在肢间协调障碍，表现为同步延迟增加、相位偏移及PCI升高；这些协调缺陷在FOG患者中尤其明显。\",\n          \"effect_estimate\": \"未报告FOG与非FOG患者的合并效应量、置信区间或P值。\",\n          \"statistical_unit_and_method\": \"综述级定性综合；具体纳入研究的患者级或步态周期级统计单位未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域摘要级初评；原始研究使用Downs and Black工具。\",\n            \"domains\": [\n              {\n                \"domain\": \"检索范围\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"摘要列出五个数据库，但未提供完整检索式及灰色文献检索情况。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"研究选择\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"报告710项研究中14项符合标准，但未说明独立筛选及分歧处理。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"原始研究偏倚评价\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"报告使用Downs and Black工具，但摘要未给出各研究评分和具体偏倚领域。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"证据综合\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要提供定性结果，但没有分组效应量及研究间异质性数据。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未提供预注册方案及完整结果清单。\",\n                \"source_locator\": \"Abstract—Results\"\n              }\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"这是FOG相关运动学协调证据，而非STN神经活动证据。综述没有报告冻结事件级STN-LFP或STN神经元放电。不能把PCI升高直接解释为STN beta或theta-alpha异常。摘要没有列出支持FOG特异性结论的原始研究PMID/DOI。\",\n          \"quote\": \"higher Phase Coordination Index values, particularly among those with freezing of gait.\",\n          \"source_locator\": {\n            \"section\": \"Abstract—Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:40899224\",\n        \"title\": \"Transcutaneous Spinal Magnetic Stimulation Affects Subthalamic Activity in Parkinson's Disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"仅提供题目及Letter类型，无摘要，无法判断研究中心、患者人数、研究设计或与其他研究的队列重叠。\",\n        \"source_type\": \"unclear\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:40913378\",\n        \"title\": \"Cortical and Corticomuscular Beta-Gamma Phase-Amplitude Coupling During Different Locomotion States and the Effects of Levodopa in Parkinson's Disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告30名PD患者，但没有研究中心、招募时间及与其他论文队列匹配的信息。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:40931891\",\n        \"title\": \"Digital Cueing With Laser Shoes Does Not Improve Walking in Parkinson's Disease: Evidence Across Disease Severity and Freezing Status.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告80名PD患者，但没有提供可用于与其他论文匹配的研究中心、招募时间或作者队列声明。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:40967240\",\n        \"title\": \"Multitarget neurostimulation of the deep brain: clinical opportunities, challenges, and emerging technologies.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"综述摘要未提供涉及FOG的STN原始研究PMID/DOI及患者队列信息。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:40982287\",\n        \"title\": \"Long-Term Personalized Adaptive Deep Brain Stimulation in Parkinson Disease: A Nonrandomized Clinical Trial.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告68名PD患者，但未提供与其他给定研究匹配的招募中心、队列时间或FOG分层信息。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:40993190\",\n        \"title\": \"Invasive neurophysiology and whole brain connectomics for neural decoding in patients with brain implants.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告73名不同疾病的植入患者，但没有提供PD患者的独立人数、FOG分层或与其他论文的队列匹配依据。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:41095938\",\n        \"title\": \"Exploring the Effectiveness of Immersive Virtual Reality Rehabilitation for Parkinson's Disease: A Narrative Review.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"叙述性综述摘要未列出FOG相关原始研究PMID/DOI、样本或队列匹配信息。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:41129484\",\n        \"title\": \"Absence of STN Neuronal Activity during MER in DBS Surgery: Diagnostic and Clinical Implications.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告2012至2024年Juntendo University Hospital的624例STN-DBS手术及其中3例特殊病例；没有提供与其他给定论文的患者重叠声明。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"41129484-E1\",\n          \"design\": \"回顾性病例系列；从624例STN-DBS手术中识别3例术中MER未检测到典型STN神经活动的患者。\",\n          \"population\": \"3名男性、60多岁的晚期帕金森综合征患者；最终诊断为或高度怀疑为progressive supranuclear palsy-parkinsonism（PSP-P）。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 3,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"624为手术次数，不是明确报告的独立患者总数；摘要分析3名病例。未报告FOG患者数、FOG事件数、电极接触点数或有效神经信号患者数。未检测到典型活动不等同于记录质量不合格。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"unclear\",\n          \"freezing_phenotype\": \"not_reported\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"术中MER记录的药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"STN-DBS手术期间；2例按照初始手术计划植入电极，1例中止植入。术中刺激参数不适用或未报告。\",\n          \"task\": \"STN-DBS术中多轨迹microelectrode recording；没有自然步行或FOG诱发任务。\",\n          \"recording_location\": \"计划植入的STN轨迹；摘要报告未观察到典型STN神经元放电模式。\",\n          \"measure\": \"术中MER典型STN neuronal firing patterns是否存在；不是LFP频谱功率或beta burst测量。\",\n          \"frequency_and_analysis_window\": \"摘要未报告放电频率、分析窗口或信号归一化方法。\",\n          \"finding\": \"在624例STN-DBS手术中发现3例（0.5%）未检测到典型STN神经活动。三例均有较早期步态障碍，但摘要没有将其定义为FOG；后续均被诊断为或高度怀疑为PSP-P。\",\n          \"effect_estimate\": \"3/624 procedures（0.5%）；属于手术病例发生比例，不是FOG预测效应量。\",\n          \"statistical_unit_and_method\": \"手术次数及患者级病例描述；回顾性病例系列，没有报告推断性统计模型。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；回顾性病例系列及术中神经生理研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"仅选择3例特殊MER阴性病例，属于回顾性罕见病例筛选。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要报告早期gait disturbance，但没有FOG诊断、事件级视频确认或临床冻结评分。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"信号质量与伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要没有说明MER信号质量、噪声、轨迹位置误差及伪迹排除方法。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"病例最终诊断PSP-P，原始PD诊断及其他神经退行性病理可能影响神经活动和步态，但没有对照组。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"重复测量与伪重复\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要没有提供轨迹级统计分析或重复测量模型。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未报告推断性多重比较。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"模型过拟合与外部验证\",\n                \"judgement\": \"not_applicable\",\n                \"reason\": \"没有报告预测模型。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"没有提供预注册及完整病例筛选流程。\",\n                \"source_locator\": \"Abstract—Methods\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"本研究涉及STN神经活动，但患者的步态表现被描述为gait disturbance而非FOG。不能将早期步态障碍等同于冻结事件。病例最终诊断或疑似PSP-P，不能直接外推到特发性PD的FOG机制。没有FOG事件阶段或自然步行同步神经记录。\",\n          \"quote\": \"we identified 3 patients (0.5%) in whom intraoperative MER failed to detect typical STN neuronal activity.\",\n          \"source_locator\": {\n            \"section\": \"Abstract—Methods/Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:41153713\",\n        \"title\": \"Deep Brain Stimulation for Parkinson's Disease-A Narrative Review.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"叙述性综述摘要没有提供涉及STN活动与FOG事件关系的原始研究引文或患者队列信息。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:41174540\",\n        \"title\": \"Characteristics of brain glucose metabolism in Parkinson's disease patients with freezing of gait: a study based on 18F-FDG PET imaging and deep learning.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告18名PD-FOG、11名PD-NFOG和17名健康对照，但未提供研究中心、招募时间及与其他论文队列重叠声明。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"41174540-E1\",\n          \"design\": \"观察性横断面18F-FDG PET脑代谢比较研究。\",\n          \"population\": \"18名PD-FOG患者、11名PD-NFOG患者和17名健康对照。\",\n          \"n_enrolled\": 46,\n          \"n_analyzed\": 46,\n          \"n_patients_with_FOG\": 18,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要报告46名参与者均接受18F-FDG PET，但未单独报告通过影像质量控制并进入最终分析的人数；PET不是STN植入式神经记录，电极数不适用。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"not_reported\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"PET检查时药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"未报告DBS植入或刺激状态。\",\n          \"task\": \"18F-FDG PET检查；是否静息或特定任务条件未在摘要中说明。\",\n          \"recording_location\": \"全脑18F-FDG PET；组间差异主要涉及额叶、顶叶及扣带回。没有报告STN特异性记录结果。\",\n          \"measure\": \"脑区域葡萄糖代谢。\",\n          \"frequency_and_analysis_window\": \"不适用；PET代谢成像，不是LFP频谱分析。\",\n          \"finding\": \"PD-FOG与PD-NFOG之间的PET代谢差异主要位于额叶、顶叶及扣带回。摘要没有报告这些区域代谢升高或降低的具体方向，也没有报告STN区域的独立结果。\",\n          \"effect_estimate\": \"未报告区域代谢差值、置信区间或P值。\",\n          \"statistical_unit_and_method\": \"患者级组间影像比较；具体统计检验、协变量调整及多重比较校正未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性神经影像及分类研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"总样本46人，FOG组18人；招募及排除流程未在摘要中详细说明。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要没有提供FOG诊断标准、临床评估量表或事件级确认方法。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"信号质量与伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"PET采集、预处理、影像质量控制及配准细节未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"药物状态、疾病严重程度和其他代谢影响因素的调整情况未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"重复测量与伪重复\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未报告重复扫描或重复测量分析。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"涉及多个脑区，但未报告影像多重比较校正。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"模型过拟合与外部验证\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"样本规模较小，摘要未报告独立外部验证队列或交叉验证方案。\",\n                \"source_locator\": \"Abstract—Methods/Results\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未提供预注册分析计划及完整影像区域结果。\",\n                \"source_locator\": \"Abstract—Results\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"这是FOG相关脑代谢影像证据，不是STN神经电生理证据。摘要没有报告STN区域的具体代谢方向，也没有冻结事件级记录。额叶、顶叶及扣带回结果不能直接解释为STN异常。\",\n          \"quote\": \"the differences between the PD-FOG group and the PD-NFOG group were mainly located in the frontal lobe, parietal lobe and cingulate gyrus.\",\n          \"source_locator\": {\n            \"section\": \"Abstract—Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"41174540-E2\",\n          \"design\": \"观察性神经影像研究中的机器学习分类分析。\",\n          \"population\": \"18名PD-FOG患者、11名PD-NFOG患者和17名健康对照。\",\n          \"n_enrolled\": 46,\n          \"n_analyzed\": 46,\n          \"n_patients_with_FOG\": 18,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要报告46名参与者接受PET，但没有提供进入FOG分类模型的有效影像人数或独立测试集人数。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"not_reported\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"PET检查药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"未报告。\",\n          \"task\": \"基于18F-FDG PET影像进行FOG类型分类。\",\n          \"recording_location\": \"全脑PET影像；不是STN-LFP记录。\",\n          \"measure\": \"3D convolutional neural network对FOG状态进行分类的诊断准确率。\",\n          \"frequency_and_analysis_window\": \"不适用；PET影像机器学习。\",\n          \"finding\": \"摘要报告3D CNN用于FOG分类的准确率为95.40%。该结果属于影像分类性能，不代表对实际FOG事件的时间预测，也不代表STN神经信号预测能力。\",\n          \"effect_estimate\": \"FOG分类准确率95.40%；摘要未提供灵敏度、特异度、置信区间或外部验证准确率。\",\n          \"statistical_unit_and_method\": \"患者级机器学习分类；3D CNN；训练、验证、测试集划分及模型评估方案未在摘要中报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性神经影像机器学习研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"总样本46人，FOG组18人，样本规模有限。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"FOG诊断标准及标签确认方法未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"信号质量与伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"PET影像预处理及质量控制方法未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"药物状态及临床协变量调整情况未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"重复测量与伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未说明数据划分是否以患者为单位，无法判断同一患者影像是否跨训练和测试集。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"不同模型比较及超参数搜索范围未报告。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"模型过拟合与外部验证\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"小样本下报告较高准确率，但摘要未提供独立外部验证或完整交叉验证信息。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"没有提供预注册模型方案及全部性能指标。\",\n                \"source_locator\": \"Abstract—Results\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"FOG分类准确率不是事件级预测提前量，也不是FOG发生前的STN神经活动证据。不能把95.40%的准确率解释为STN生物标志物性能。摘要未说明外部验证。\",\n          \"quote\": \"The 3D CNN achieved diagnostic accuracies of 90.09% for distinguishing PD and 95.40% for FOG.\",\n          \"source_locator\": {\n            \"section\": \"Abstract—Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:41189627\",\n        \"title\": \"A novel methodological approach to understanding the cortical and subcortical effects of aerobic exercise in Parkinson's disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告单名PD患者的方法学示例，但未提供患者身份匹配、研究中心或与其他论文队列的重叠声明。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:41201655\",\n        \"title\": \"Sensory integration deficits in Parkinson's disease with freezing of gait: cortical network dynamics and paradoxical dopaminergic modulation.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告40名PD患者和23名健康对照，但没有提供研究中心、招募时间及与其他论文队列重叠的信息。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"41201655-E1\",\n          \"design\": \"观察性重复测量fNIRS步行研究；比较不同感觉挑战条件下的皮层激活反应。\",\n          \"population\": \"40名PD患者，其中20名PD-FOG、20名PD-nFOG；另有23名健康对照。\",\n          \"n_enrolled\": 63,\n          \"n_analyzed\": 63,\n          \"n_patients_with_FOG\": 20,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要报告63名参与者完成任务，但没有报告有效fNIRS数据人数、具体试次数或FOG事件数；fNIRS不是STN植入式电极记录。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"not_reported\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"OFF及ON dopaminergic medication；具体药物、剂量、服药时间及停药时长未报告。\",\n          \"DBS_state_and_parameters\": \"摘要未报告DBS植入或刺激。\",\n          \"task\": \"WG：常规地面行走；WF：泡沫表面行走，增加本体感觉挑战；WN：穿过狭窄门，增加视觉空间挑战；WS：斜坡行走，结合本体感觉及视觉空间挑战。各任务均在OFF和ON药物状态下进行。\",\n          \"recording_location\": \"fNIRS记录SMA、M1、S1、SAC、PFC及FEF皮层血流动力学；未记录STN。\",\n          \"measure\": \"感觉需求增加时皮层区域激活反应的适应性变化；本条仅提取activation，不合并connectivity结果。\",\n          \"frequency_and_analysis_window\": \"fNIRS血流动力学信号；摘要未报告频段、时间窗、基线及归一化方法。\",\n          \"finding\": \"PD-FOG患者相较PD-nFOG和健康对照，缺乏随感觉需求增加而产生的适应性皮层激活反应。该结果属于皮层感觉运动适应性异常，不是STN神经活动异常。\",\n          \"effect_estimate\": \"未报告激活差值、效应量、置信区间或P值。\",\n          \"statistical_unit_and_method\": \"患者级组间及重复任务比较；摘要报告使用ANOVA models，但具体模型结构及事后比较未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性重复测量神经影像研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"样本包括20名FOG患者和20名非FOG患者，但招募流程及排除标准未在摘要中说明。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要没有提供FOG诊断标准、视频确认或事件级临床评审方法。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"信号质量与伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告fNIRS运动伪迹剔除、通道质量控制及有效信号人数。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"OFF/ON药物状态存在差异，但剂量、服药时间、测试顺序及混杂因素调整未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"重复测量与伪重复\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"包含四种步行任务和两个药物状态，摘要未提供患者内相关性及重复测量模型的具体结构。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"涉及多个皮层区域、任务及药物状态，未报告多重比较校正。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"模型过拟合与外部验证\",\n                \"judgement\": \"not_applicable\",\n                \"reason\": \"本条为组间激活比较，未报告预测模型。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"没有提供预注册方案及所有脑区、任务的完整统计结果。\",\n                \"source_locator\": \"Abstract—Results\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"FOG患者分组而非事件级冻结标签；没有报告同一试次实际出现FOG的时间点。研究只记录皮层fNIRS，没有STN-LFP或STN单单位活动，不能直接验证STN-FOG机制。\",\n          \"quote\": \"PD-FOG lacked adaptive cortical plasticity (activation/connectivity response) to increasing sensory demands compared to PD-nFOG/HC.\",\n          \"source_locator\": {\n            \"section\": \"Abstract—Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"41201655-E2\",\n          \"design\": \"观察性重复测量fNIRS步行研究；不同感觉挑战下的皮层连接比较。\",\n          \"population\": \"40名PD患者，其中20名PD-FOG、20名PD-nFOG；另有23名健康对照。\",\n          \"n_enrolled\": 63,\n          \"n_analyzed\": 63,\n          \"n_patients_with_FOG\": 20,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告有效fNIRS数据人数及连接分析所使用的具体试次数；未进行STN电极记录。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"not_reported\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"OFF及ON dopaminergic medication；剂量及时间未报告。\",\n          \"DBS_state_and_parameters\": \"未报告DBS。\",\n          \"task\": \"四种步行任务中的WF：Walking-on-Foam，泡沫表面行走，增加本体感觉挑战。\",\n          \"recording_location\": \"fNIRS皮层网络；包括SMA、M1、S1、SAC、PFC和FEF；无STN记录。\",\n          \"measure\": \"WF条件下认知-感觉-运动皮层网络connectivity。\",\n          \"frequency_and_analysis_window\": \"fNIRS连接分析；摘要未报告具体连接算法、时间窗、频段或基线。\",\n          \"finding\": \"在泡沫表面行走（WF）时，PD-FOG患者相较PD-nFOG患者表现出cognitive-sensory/motor hyperconnectivity。\",\n          \"effect_estimate\": \"未报告连接强度差值、置信区间或P值。\",\n          \"statistical_unit_and_method\": \"患者级组间比较；研究报告使用ANOVA models，具体连接统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性重复测量神经影像研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"FOG组20人，招募和排除标准未在摘要中报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"FOG分组标准及事件级确认方法未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"信号质量与伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告fNIRS运动伪迹处理及连接信号质量控制。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"药物状态和感觉挑战均可能影响连接，但药物时间及协变量调整未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"重复测量与伪重复\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"多个任务及药物状态下重复测量，患者内相关性处理细节未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"多个脑区、连接及任务的多重比较校正未报告。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"模型过拟合与外部验证\",\n                \"judgement\": \"not_applicable\",\n                \"reason\": \"本条为连接组间比较，未报告预测模型。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"没有提供全部连接矩阵及预设比较清单。\",\n                \"source_locator\": \"Abstract—Results\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"该结果说明FOG分组与皮层感觉-运动网络连接有关，但不能解释为STN局部振荡增强。摘要未说明该hyperconnectivity是否发生在实际FOG事件期间。\",\n          \"quote\": \"PD-FOG exhibited cognitive-sensory/motor hyperconnectivity versus PD-nFOG during WF.\",\n          \"source_locator\": {\n            \"section\": \"Abstract—Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"41201655-E3\",\n          \"design\": \"观察性重复测量fNIRS步行研究；药物状态比较。\",\n          \"population\": \"40名PD患者，其中20名PD-FOG、20名PD-nFOG；另有23名健康对照。\",\n          \"n_enrolled\": 63,\n          \"n_analyzed\": 63,\n          \"n_patients_with_FOG\": 20,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"有效fNIRS数据人数、FOG事件数和试次数未报告；fNIRS不是STN电极记录。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"not_reported\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"比较OFF与ON dopaminergic medication。\",\n          \"DBS_state_and_parameters\": \"未报告DBS。\",\n          \"task\": \"四种感觉情境步行任务；摘要未将本项药物效应限定到某一个单独任务。\",\n          \"recording_location\": \"fNIRS皮层感觉运动区域，包括SMA、M1、S1、SAC、PFC及FEF；无STN记录。\",\n          \"measure\": \"步行表现（walking performance）。\",\n          \"frequency_and_analysis_window\": \"步态分析时间窗及具体运动学指标未在摘要中报告。\",\n          \"finding\": \"摘要报告药物治疗改善了PD-FOG患者的步行表现。该结果是药物状态相关的临床运动结局，不等同于FOG事件减少，也没有提供STN活动变化。\",\n          \"effect_estimate\": \"未报告步行改善的定量效应量、置信区间或P值。\",\n          \"statistical_unit_and_method\": \"患者级ON/OFF比较；使用ANOVA models，具体步态指标及模型结构未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性重复测量神经影像及步态研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"FOG组20人，招募及排除流程未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"FOG分组标准及事件级冻结确认方法未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"信号质量与伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告步态传感及fNIRS有效信号质量控制。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"药物剂量、服药时间及ON/OFF测试顺序未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"重复测量与伪重复\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"同一患者在两个药物状态和多个任务中重复测量，具体统计处理未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"多个任务和临床指标的多重比较校正未报告。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"模型过拟合与外部验证\",\n                \"judgement\": \"not_applicable\",\n                \"reason\": \"本条为药物状态步态比较，未报告预测模型。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未提供完整预设步态结局及分析计划。\",\n                \"source_locator\": \"Abstract—Results\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"摘要只报告walking performance改善，不能将其直接等同于FOG频率或持续时间减少。没有STN神经记录，不能推断药物对STN振荡的影响。\",\n          \"quote\": \"Medication improved gait but suppressed sensorimotor activation and reduced frontoparietal connectivity in PD-FOG.\",\n          \"source_locator\": {\n            \"section\": \"Abstract—Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"41201655-E4\",\n          \"design\": \"观察性重复测量fNIRS步行研究；ON/OFF药物状态比较。\",\n          \"population\": \"40名PD患者，其中20名PD-FOG、20名PD-nFOG；另有23名健康对照。\",\n          \"n_enrolled\": 63,\n          \"n_analyzed\": 63,\n          \"n_patients_with_FOG\": 20,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告有效fNIRS样本数、FOG事件数及试次数；没有STN植入式记录。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"not_reported\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"OFF与ON dopaminergic medication。\",\n          \"DBS_state_and_parameters\": \"未报告DBS。\",\n          \"task\": \"四种感觉情境步行任务；具体药物效应未在摘要中按单一任务进一步分层。\",\n          \"recording_location\": \"fNIRS皮层感觉运动区域；无STN记录。\",\n          \"measure\": \"皮层sensorimotor activation。\",\n          \"frequency_and_analysis_window\": \"fNIRS血流动力学分析；时间窗和基线未报告。\",\n          \"finding\": \"在PD-FOG患者中，ON药物状态相较OFF状态，sensorimotor activation受到抑制。该结果与步行表现改善同时出现。\",\n          \"effect_estimate\": \"未报告激活变化的定量效应量、置信区间或P值。\",\n          \"statistical_unit_and_method\": \"患者级ON/OFF比较；ANOVA models，具体模型未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性重复测量神经影像研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"样本量有限，招募及排除流程未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"FOG分组标准及实际事件确认方法未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"信号质量与伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"fNIRS运动伪迹和信号质量控制未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"药物剂量、服药时间及测试顺序未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"重复测量与伪重复\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"患者内ON/OFF重复测量的具体模型结构未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"多个皮层区域、任务及状态可能产生多重比较，校正情况未报告。\",\n                \"source_locator\": \"Abstract—Results\"\n              },\n              {\n                \"domain\": \"模型过拟合与外部验证\",\n                \"judgement\": \"not_applicable\",\n                \"reason\": \"本条为组内激活比较，没有报告预测模型。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未提供完整预注册分析计划及所有皮层区域结果。\",\n                \"source_locator\": \"Abstract—Results\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"这是皮层激活而非STN-LFP结果。ON状态激活下降与步行改善并存，不能据此推断STN活动必然降低，也不能将皮层抑制解释为FOG事件增加。\",\n          \"quote\": \"Medication improved gait but suppressed sensorimotor activation\",\n          \"source_locator\": {\n            \"section\": \"Abstract—Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"41201655-E5\",\n          \"design\": \"观察性重复测量fNIRS步行研究；ON/OFF药物状态比较。\",\n          \"population\": \"40名PD患者，其中20名PD-FOG、20名PD-nFOG；另有23名健康对照。\",\n          \"n_enrolled\": 63,\n          \"n_analyzed\": 63,\n          \"n_patients_with_FOG\": 20,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"有效fNIRS数据人数及事件数未报告；没有STN电极记录。\",\n          \"endpoint_class\": \"