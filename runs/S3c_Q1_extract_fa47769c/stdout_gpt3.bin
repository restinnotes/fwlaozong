ype\": \"not_reported\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"OFF dopaminergic medication。\",\n          \"DBS_state_and_parameters\": \"未报告DBS。\",\n          \"task\": \"感觉情境步行任务；OFF药物状态下的FOG关联分析，具体对应任务未在摘要中说明。\",\n          \"recording_location\": \"fNIRS测量M1和SMA皮层区域；无STN记录。\",\n          \"measure\": \"M1-SMA cortical connectivity。\",\n          \"frequency_and_analysis_window\": \"fNIRS连接指标；具体连接算法及分析窗口未报告。\",\n          \"finding\": \"较高的M1-SMA连接与OFF药物状态下的FOG预测有关。摘要未说明这是对同一试次随后实际发生FOG的事件级预测，还是患者级FOG表型分类。\",\n          \"effect_estimate\": \"未报告预测系数、OR、AUC、灵敏度、特异度或置信区间。\",\n          \"statistical_unit_and_method\": \"预测分析；患者级还是事件级统计单位、预测模型和验证方法均未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性神经影像预测研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"FOG组仅20人，招募及排除流程未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告OFF-FOG定义及事件级标签确认方法。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"信号质量与伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"fNIRS信号质量及伪迹处理未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"药物状态及其他临床变量的协变量调整未报告。\",\n                \"source_locator\": \"Abstract—Methods\"\n              },\n              {\n                \"domain\": \"重复测量与伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"无法判断预测模型是否处理患者内重复任务及重复测量。\",\n                \"source_lo