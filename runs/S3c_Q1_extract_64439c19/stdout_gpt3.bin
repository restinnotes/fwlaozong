      \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"39884164-E5\",\n          \"design\": \"静息态STN-LFP与FOG严重程度相关性研究。\",\n          \"population\": \"23名PD患者；FOG组14人。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 23,\n          \"n_patients_with_FOG\": 14,\n          \"n_patients_with_valid_neural_data\": 23,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告实际相关分析人数及电极触点数量。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"FOG severity；具体冻结亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"静息态；药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"STN-LFP；刺激状态未报告。\",\n          \"task\": \"静息态LFP。\",\n          \"recording_location\": \"STN。\",\n          \"measure\": \"alpha burst amplitude。\",\n          \"frequency_and_analysis_window\": \"alpha边界和burst窗口未报告。\",\n          \"finding\": \"alpha burst amplitude与FOG严重程度呈正相关。\",\n          \"effect_estimate\": \"r=0.479，P=0.003。\",\n          \"statistical_unit_and_method\": \"患者级相关性分析；具体统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性电生理相关性研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"样本选择流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"FOG严重程度测量细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"burst信号质量控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"临床混杂因素调整未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"统计层级未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"多重检验校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"与E3中的intermittent alpha相关性为摘要分别报告的结果，不能假定两者使用完全相同的统计定义。\",\n          \"quote\": \"Alpha burst amplitude correlated with FOG severity (r = 0.479, p = 0.003)\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"39884164-E6\",\n          \"design\": \"静息态STN-LFP与运动功能评分相关性研究。\",\n          \"population\": \"23名PD患者。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 23,\n          \"n_patients_with_FOG\": 14,\n          \"n_patients_with_valid_neural_data\": 23,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告POMA相关分析实际人数及触点数量。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"FOG组与非FOG组；POMA为运动功能评估，具体冻结亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"静息态；药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"STN-LFP；刺激状态未报告。\",\n          \"task\": \"静息态LFP及POMA评估。\",\n          \"recording_location\": \"STN。\",\n          \"measure\": \"high-beta burst amplitude。\",\n          \"frequency_and_analysis_window\": \"high-beta边界及burst窗口未报告。\",\n          \"finding\": \"high-beta burst amplitude与POMA指数呈负相关。\",\n          \"effect_estimate\": \"r=-0.411，P=0.014。\",\n          \"statistical_unit_and_method\": \"患者级相关性分析；具体检验方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性电生理相关性研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"样本选择未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"POMA及FOG表型评估细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"信号质量控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"年龄、病程及药物等调整未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"统计层级未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"多重相关性校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"POMA并非FOG事件记录，不能将该相关性解释为冻结事件的直接预测关系。\",\n          \"quote\": \"high beta burst amplitude inversely correlated (r = -0.411, p = 0.014) with the performance-oriented mobility assessment (POMA) index.\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:41105567\",\n        \"title\": \"Efficacy of Unilateral Deep Brain Stimulation for Gait Enhancement in Parkinson's Disease: A Systematic Review and Meta-Analysis.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"not_applicable\",\n        \"cohort_id_candidate\": null,\n        \"cohort_relation_basis\": \"系统综述纳入23项研究，涉及STN、GPi、PPN及VIM等多个靶点，不构成新的患者队列。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"41105567-E1\",\n          \"design\": \"系统综述及Meta分析，比较单侧DBS与对照及双侧DBS。\",\n          \"population\": \"23项研究；涉及STN、GPi、PPN和VIM等靶点；患者总数未在摘要报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告FOG患者总数；研究包含多个刺激靶点。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"原文：freezing of gait；具体冻结表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"单侧DBS；靶点混合，包括STN、GPi、PPN和VIM；具体STN频率和刺激参数未报告。\",\n          \"task\": \"UPDRS gait score、FOG临床评估及步态速度等。\",\n          \"recording_location\": \"无统一神经电生理记录；属于临床刺激结局综述。\",\n          \"measure\": \"FOG及临床步态量表。\",\n          \"frequency_and_analysis_window\": \"刺激频率未报告；临床随访窗口未报告。\",\n          \"finding\": \"描述性综述认为单侧DBS可能改善UPDRS步态评分、FOG及步态速度，但改善程度低于双侧刺激。\",\n          \"effect_estimate\": \"FOG独立合并效应量未报告；Meta分析的步态速度结果为单侧DBS相较对照无显著差异。\",\n          \"statistical_unit_and_method\": \"系统综述；Meta分析主要针对步态速度。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域；仅摘要初评。\",\n            \"domains\": [\n              {\"domain\": \"方案及注册\", \"judgement\": \"some_concerns\", \"reason\": \"报告PROSPERO注册号，但注册细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"文献检索\", \"judgement\": \"some_concerns\", \"reason\": \"报告四个数据库，但完整检索策略未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"研究筛选与数据提取\", \"judgement\": \"not_assessable\", \"reason\": \"双人筛选和提取流程未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"not_assessable\", \"reason\": \"未报告质量评价结果。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"Meta分析及发表偏倚\", \"judgement\": \"some_concerns\", \"reason\": \"步态速度Meta分析不等于FOG的合并效应。\", \"source_locator\": \"Abstract Results\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"该综述包含多个DBS靶点，不能将整体单侧DBS结论直接归因于STN。FOG没有报告独立Meta分析效应量。\",\n          \"quote\": \"unilateral DBS can improve the UPDRS gait score, freezing of gait, and gait velocity\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:41448344\",\n        \"title\": \"Alterations of functional connectivity between hyperdirect pathway regions and outside regions in Parkinson's disease patients with freezing of gait.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"PMID:41448344\",\n        \"cohort_id_candidate\": \"cohort_candidate:PMID:41448344\",\n        \"cohort_relation_basis\": \"摘要报告59名PD患者（33名n-FOG、26名FOG）和30名健康对照。未提供中心、招募日期和患者身份信息。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"41448344-E1\",\n          \"design\": \"静息态fMRI观察性病例对照研究。\",\n          \"population\": \"59名PD患者及30名匹配健康对照；PD组33名n-FOG、26名FOG。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 89,\n          \"n_patients_with_FOG\": 26,\n          \"n_patients_with_valid_neural_data\": 59,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告招募人数及缺失扫描情况；研究使用fMRI，不适用电极数和事件数。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"原文：PD-FOG与PD-nFOG分组；具体冻结亚型和量表未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"静息态；药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"未报告DBS干预；研究为静息态fMRI。\",\n          \"task\": \"静息态fMRI。\",\n          \"recording_location\": \"Hyperdirect pathway相关脑区及其外部连接区域；非STN-LFP记录。\",\n          \"measure\": \"ROI-wise resting-state functional connectivity。\",\n          \"frequency_and_analysis_window\": \"fMRI功能连接分析；频段和时间窗未报告。\",\n          \"finding\": \"HDP内部区域之间的ROI-wise功能连接未观察到组间差异。\",\n          \"effect_estimate\": \"无显著组间差异；具体统计量和P值未报告。\",\n          \"statistical_unit_and_method\": \"患者组间ROI-wise功能连接比较；具体统计模型未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性神经影像研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募及排除标准未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"FOG诊断及分组依据未详细报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"fMRI质量控制及头动处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物、认知及临床因素调整未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"ROI及患者层级统计处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"ROI及体素水平多重比较校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预注册及预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"静息态fMRI的功能连接不等于STN局部神经振荡或STN神经元活动。未报告具体ROI定义和统计量。\",\n          \"quote\": \"No group differences were observed in the ROI-wise functional connectivity among the regions within the HDP.\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"41448344-E2\",\n          \"design\": \"静息态fMRI观察性病例对照研究。\",\n          \"population\": \"59名PD患者及30名健康对照。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 89,\n          \"n_patients_with_FOG\": 26,\n          \"n_patients_with_valid_neural_data\": 59,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告缺失扫描情况；无电极及事件级冻结数据。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"PD患者；包含FOG和非FOG组。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"静息态；药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"未报告DBS干预。\",\n          \"task\": \"静息态fMRI。\",\n          \"recording_location\": \"Hyperdirect pathway与默认模式网络、感觉运动皮层、边缘系统及小脑等区域。\",\n          \"measure\": \"Voxel-wise resting-state functional connectivity。\",\n          \"frequency_and_analysis_window\": \"体素水平功能连接；具体时间窗未报告。\",\n          \"finding\": \"PD患者相较健康对照，HDP与DMN、感觉运动皮层、边缘系统及小脑等区域之间的体素水平功能连接降低。\",\n          \"effect_estimate\": \"具体连接强度差值和P值未报告。\",\n          \"statistical_unit_and_method\": \"PD与健康对照的体素水平比较；具体模型未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性神经影像研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募及排除标准未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"患者分组诊断标准未详细报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"头动及图像质量控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"临床混杂调整未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"体素分析统计处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"体素水平多重比较校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"这是PD与健康对照的整体差异，不能直接解释FOG特异性机制。\",\n          \"quote\": \"significant reduced functional connectivity based on voxel-wise analysis were observed between the HDP and several brain regions\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"41448344-E3\",\n          \"design\": \"PD-FOG与PD-nFOG静息态fMRI组间观察研究。\",\n          \"population\": \"59名PD患者；FOG组26人，n-FOG组33人。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 59,\n          \"n_patients_with_FOG\": 26,\n          \"n_patients_with_valid_neural_data\": 59,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告实际FOG事件和缺失影像数据；无电极记录。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"PD-FOG与PD-nFOG分组；具体冻结亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"静息态；药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"未报告DBS干预。\",\n          \"task\": \"静息态fMRI。\",\n          \"recording_location\": \"HDP与小脑及middle occipital gyrus之间的功能连接。\",\n          \"measure\": \"Voxel-wise resting-state functional connectivity。\",\n          \"frequency_and_analysis_window\": \"静息态功能连接；具体时间窗未报告。\",\n          \"finding\": \"相较PD-nFOG，PD-FOG患者HDP与小脑及middle occipital gyrus之间的功能连接增加。\",\n          \"effect_estimate\": \"具体连接差值、效应量及P值未报告；摘要称其与对侧肢体运动障碍相关。\",\n          \"statistical_unit_and_method\": \"患者组间体素水平功能连接比较；具体统计模型未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性神经影像研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"FOG分组标准未详细报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"影像质量控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物和运动严重度混杂控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"体素及患者层级处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"多重比较校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"该研究为静息态网络连接证据，不是STN局部电生理活动证据。连接增加可能是补偿或病理性变化，摘要不能区分。\",\n          \"quote\": \"PD-FOG showed increased functional connectivity between the HDP and the cerebellum and the middle occipital gyrus\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:41553951\",\n        \"title\": \"Simultaneous High-Frequency Subthalamic and Ultra-Low-Frequency Nigral Deep Brain Stimulation Improved Motor Symptoms and Freezing of Gait in Parkinson's Disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"PMID:41553951\",\n        \"cohort_id_candidate\": \"cohort_candidate:PMID:41553951\",\n        \"cohort_relation_basis\": \"摘要报告6名难治性FOG患者，属于多中心前瞻性单盲研究。未提供具体中心及招募时间，无法判断队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"41553951-E1\",\n          \"design\": \"多中心、前瞻性、单盲双靶点刺激比较研究；摘要未说明随机化。\",\n          \"population\": \"6名具有难治性FOG的PD患者。\",\n          \"n_enrolled\": 6,\n          \"n_analyzed\": 6,\n          \"n_patients_with_FOG\": 6,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告冻结事件数、有效神经记录人数及电极触点数量；主要为临床量表研究。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"原文：refractory FOG；具体冻结表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"FOG量表评估的具体药物状态未报告；MDS-UPDRS-III另报告Med-On和Med-Off结果。\",\n          \"DBS_state_and_parameters\": \"高频STN刺激联合超低频SNr刺激，与STN-only刺激比较；具体频率、幅度、脉宽和触点未报告。\",\n          \"task\": \"临床FOG评估；使用NFOGQ。\",\n          \"recording_location\": \"无直接STN神经电活动记录；报告VTA连接分析。\",\n          \"measure\": \"New Freezing of Gait Questionnaire (NFOGQ)。\",\n          \"frequency_and_analysis_window\": \"STN high-frequency及SNr ultra-low-frequency；具体数值和评估时间未报告。\",\n          \"finding\": \"双靶点刺激相较STN-only显著降低NFOGQ评分。\",\n          \"effect_estimate\": \"P=0.02；效应量和置信区间未报告。\",\n          \"statistical_unit_and_method\": \"患者临床评分比较；具体统计模型未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"ROBINS-I相关域摘要级初评；随机化未报告。\",\n            \"domains\": [\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物状态及治疗顺序未充分报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"参与者选择\", \"judgement\": \"some_concerns\", \"reason\": \"仅纳入6名难治性FOG患者。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"干预分类\", \"judgement\": \"some_concerns\", \"reason\": \"刺激靶点明确，但具体参数未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"偏离干预\", \"judgement\": \"unclear\", \"reason\": \"单盲实施及依从性未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"缺失数据\", \"judgement\": \"unclear\", \"reason\": \"缺失和退出情况未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"结局测量\", \"judgement\": \"some_concerns\", \"reason\": \"使用NFOGQ，但盲法评估细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预注册和预设结局未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"样本仅6人，双靶点干预不能单独确定STN神经活动变化的作用。NFOGQ属于临床表型量表，不是实际冻结事件计数。\",\n          \"quote\": \"Dual-target stimulation significantly outperformed STN-only stimulation in reducing FOG severity (NFOGQ: p = 0.02\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"41553951-E2\",\n          \"design\": \"多中心、前瞻性、单盲双靶点刺激比较研究。\",\n          \"population\": \"6名难治性FOG的PD患者。\",\n          \"n_enrolled\": 6,\n          \"n_analyzed\": 6,\n          \"n_patients_with_FOG\": 6,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告冻结事件数、步态测试次数及神经记录人数。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"原文：refractory FOG。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"FOG量表药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"高频STN刺激联合超低频SNr刺激，与STN-only比较。\",\n          \"task\": \"Gait and Falls Questionnaire (GFQ)临床评估。\",\n          \"recording_location\": \"未报告直接STN-LFP或单/多单位记录。\",\n          \"measure\": \"Gait and Falls Questionnaire。\",\n          \"frequency_and_analysis_window\": \"STN high-frequency及SNr ultra-low-frequency；具体参数未报告。\",\n          \"finding\": \"双靶点刺激相较STN-only显著降低GFQ评分。\",\n          \"effect_estimate\": \"P=0.01；效应量和置信区间未报告。\",\n          \"statistical_unit_and_method\": \"患者临床量表比较；具体统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"ROBINS-I相关域摘要级初评。\",\n            \"domains\": [\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物及干预顺序未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"参与者选择\", \"judgement\": \"some_concerns\", \"reason\": \"样本仅6名难治性FOG患者。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"干预分类\", \"judgement\": \"some_concerns\", \"reason\": \"刺激参数不完整。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"偏离干预\", \"judgement\": \"unclear\", \"reason\": \"单盲实施细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"缺失数据\", \"judgement\": \"unclear\", \"reason\": \"缺失情况未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"结局测量\", \"judgement\": \"some_concerns\", \"reason\": \"使用问卷，评估者盲法细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设结局未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"GFQ是临床量表，不是客观冻结事件记录；不能由该结果推断STN某一频段振荡的变化。\",\n          \"quote\": \"GFQ: p = 0.01 vs. STN-DBS\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42098512\",\n        \"title\": \"Deep brain stimulation for freezing of gait in Parkinson's disease: An updated systematic review, meta-analysis, and a single-center clinical experience.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"PMID:42098512_review_and_single_center_cohort\",\n        \"cohort_id_candidate\": \"cohort_candidate:PMID:42098512_single_center\",\n        \"cohort_relation_basis\": \"论文包含31项研究、905名患者的系统综述及Meta分析，同时报告作者单中心小队列。摘要未提供小队列人数、中心招募时间及原始研究清单，不能确认其与Meta分析纳入队列是否重叠。\",\n        \"source_type\": \"mixed\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"42098512-E1\",\n          \"design\": \"系统综述及Meta分析；合并FOG-Q结果。\",\n          \"population\": \"31项研究、905名患者；其中21项研究提供FOG-Q数据。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 905,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"905为综述总患者数，并非全部均有FOG-Q数据；摘要未报告FOG患者及事件分母。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"FOG-Q临床评分；具体冻结表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"汇总不同Med-On和Med-Off条件。\",\n          \"DBS_state_and_parameters\": \"不同DBS靶点和刺激参数；综述认为high-frequency STN刺激获益较一致，但总体合并效应并非STN单独估计。\",\n          \"task\": \"FOG-Q临床量表。\",\n          \"recording_location\": \"原始研究神经记录位置未在摘要逐项报告。\",\n          \"measure\": \"Freezing of Gait Questionnaire总评分。\",\n          \"frequency_and_analysis_window\": \"多种刺激频率及随访时间；总体合并。\",\n          \"finding\": \"DBS总体上使FOG-Q评分小幅下降。\",\n          \"effect_estimate\": \"MD=-2.99；95% CI=-5.69至-0.29。\",\n          \"statistical_unit_and_method\": \"研究层级Meta分析；均值差及95%置信区间。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域；仅摘要初评。\",\n            \"domains\": [\n              {\"domain\": \"方案及注册\", \"judgement\": \"some_concerns\", \"reason\": \"报告PRISMA，但注册细节未在摘要给出。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"文献检索\", \"judgement\": \"some_concerns\", \"reason\": \"报告四个数据库和检索截止日期，但完整检索策略未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"筛选与提取\", \"judgement\": \"not_assessable\", \"reason\": \"双人筛选及提取流程未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"not_assessable\", \"reason\": \"未报告具体评价结果。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"Meta分析及发表偏倚\", \"judgement\": \"some_concerns\", \"reason\": \"报告合并效应，但各靶点和药物状态存在异质性。\", \"source_locator\": \"Abstract Results\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"该MD为跨靶点、跨条件总体估计，不能直接归因于STN或某一频率。摘要报告高异质性和替代靶点数据不足。\",\n          \"quote\": \"DBS led to a modest decrease in FOG-Q scores (mean difference [MD] = -2.99; 95% CI = -5.69 to -0.29).\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"42098512-E2\",\n          \"design\": \"系统综述及Meta分析；药物OFF条件下刺激开启与关闭的FOG-Q比较。\",\n          \"population\": \"31项研究中的相关Med-Off比较；具体患者分母未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告该分层比较的具体研究数和患者数。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"FOG-Q；具体亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"Med-OFF/Stim-OFF对比Med-OFF/Stim-ON。\",\n          \"DBS_state_and_parameters\": \"不同DBS靶点和参数；高频STN被描述为获益较一致，但该分层MD不应自动视为STN单独效应。\",\n          \"task\": \"FOG-Q量表。\",\n          \"recording_location\": \"未报告。\",\n          \"measure\": \"FOG-Q评分。\",\n          \"frequency_and_analysis_window\": \"Med-Off条件下刺激开启与关闭的临床比较。\",\n          \"finding\": \"药物OFF状态下，开启DBS相较关闭DBS显示更大的FOG-Q改善。\",\n          \"effect_estimate\": \"MD=-5.88；95% CI=-9.28至-2.47。\",\n          \"statistical_unit_and_method\": \"Meta分析；均值差及95%置信区间。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域；仅摘要初评。\",\n            \"domains\": [\n              {\"domain\": \"方案及注册\", \"judgement\": \"some_concerns\", \"reason\": \"注册细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"文献检索\", \"judgement\": \"some_concerns\", \"reason\": \"完整检索策略未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"筛选与提取\", \"judgement\": \"not_assessable\", \"reason\": \"流程未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"not_assessable\", \"reason\": \"具体结果未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"Meta分析及发表偏倚\", \"judgement\": \"some_concerns\", \"reason\": \"跨研究药物和刺激设置异质性较大。\", \"source_locator\": \"Abstract Results\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"该分层比较的靶点混合情况及研究数量未在摘要给出，不能直接解释为STN特异性效果。\",\n          \"quote\": \"The biggest improvement in FOG was seen when stimulation was used while patients were off medication\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"42098512-E3\",\n          \"design\": \"系统综述及Meta分析；药物ON条件下刺激开启与关闭的FOG-Q比较。\",\n          \"population\": \"31项研究中的Med-On相关比较；具体患者数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告该分层的患者数及研究数。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"FOG-Q；具体亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"Med-ON/Stim-OFF对比Med-ON/Stim-ON。\",\n          \"DBS_state_and_parameters\": \"不同DBS靶点及参数；STN高频刺激为综述描述中的较一致获益方案。\",\n          \"task\": \"FOG-Q量表。\",\n          \"recording_location\": \"未报告。\",\n          \"measure\": \"FOG-Q评分。\",\n          \"frequency_and_analysis_window\": \"Med-On条件下刺激开启与关闭比较。\",\n          \"finding\": \"药物ON状态下，开启DBS相较关闭DBS仍显示FOG-Q改善，但效应小于Med-Off条件。\",\n          \"effect_estimate\": \"MD=-2.65；95% CI=-4.99至-0.32。\",\n          \"statistical_unit_and_method\": \"Meta分析；均值差及95%置信区间。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域；仅摘要初评。\",\n            \"domains\": [\n              {\"domain\": \"方案及注册\", \"judgement\": \"some_concerns\", \"reason\": \"注册信息不完整。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"文献检索\", \"judgement\": \"some_concerns\", \"reason\": \"完整检索策略未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"筛选与提取\", \"judgement\": \"not_assessable\", \"reason\": \"流程未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"Meta分析及发表偏倚\", \"judgement\": \"some_concerns\", \"reason\": \"不同靶点及药物状态存在异质性。\", \"source_locator\": \"Abstract Results\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"药物ON状态下的改善不能直接推断为所有ON-FOG患者均获益。\",\n          \"quote\": \"Stimulation during the medication-ON state had smaller effects\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"42098512-E4\",\n          \"design\": \"系统综述及Meta分析；不同药物状态和刺激状态的FOG-Q比较。\",\n          \"population\": \"31项研究中的跨状态比较；具体患者数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告跨状态比较的患者数和研究数。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"FOG-Q；具体亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"Med-ON/Stim-OFF对比Med-OFF/Stim-ON。\",\n          \"DBS_state_and_parameters\": \"不同DBS靶点及参数。\",\n          \"task\": \"FOG-Q量表。\",\n          \"recording_location\": \"未报告。\",\n          \"measure\": \"FOG-Q评分。\",\n          \"frequency_and_analysis_window\": \"跨药物及刺激状态比较。\",\n          \"finding\": \"Med-ON/Stim-OFF与Med-OFF/Stim-ON之间的FOG-Q差异无统计学显著性。\",\n          \"effect_estimate\": \"MD=-0.70；95% CI=-3.88至2.48。\",\n          \"statistical_unit_and_method\": \"Meta分析；均值差及95%置信区间。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域；仅摘要初评。\",\n            \"domains\": [\n              {\"domain\": \"方案及注册\", \"judgement\": \"some_concerns\", \"reason\": \"注册细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"文献检索\", \"judgement\": \"some_concerns\", \"reason\": \"完整检索策略未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"筛选与提取\", \"judgement\": \"not_assessable\", \"reason\": \"流程未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"not_assessable\", \"reason\": \"具体评价未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"Meta分析及发表偏倚\", \"judgement\": \"some_concerns\", \"reason\": \"跨研究状态比较存在异质性。\", \"source_locator\": \"Abstract Results\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"该结果不能证明Med-On/Stim-OFF与Med-Off/Stim-ON等效；置信区间较宽。\",\n          \"quote\": \"there was no significant benefit when comparing Med-ON/Stim-OFF to Med-OFF/Stim-ON\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"42098512-E5\",\n          \"design\": \"单中心临床经验队列；具体研究设计未在摘要说明。\",\n          \"population\": \"作者报告的小型单中心PD队列；患者人数及FOG患者比例未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要仅称small cohort，未提供样本分母、事件数和记录数量。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"FOG-Q评估；具体冻结表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"DBS刺激靶点及参数未在单中心队列结果中单独说明。\",\n          \"task\": \"临床FOG-Q及UPDRS-III评估。\",\n          \"recording_location\": \"未报告神经电生理记录。\",\n          \"measure\": \"FOG-Q评分。\",\n          \"frequency_and_analysis_window\": \"未报告。\",\n          \"finding\": \"作者单中心小队列报告FOG-Q评分显著改善。\",\n          \"effect_estimate\": \"P=0.034；效应量、置信区间和具体比较条件未报告。\",\n          \"statistical_unit_and_method\": \"单中心队列比较；具体统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：单中心临床观察性队列摘要级初评。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"队列人数及纳入标准未报告。\", \"source_locator\": \"Abstract Results\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"FOG-Q评估流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"not_assessable\", \"reason\": \"未报告神经信号记录。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物及刺激参数控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"分析单位及配对方式未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"多结局校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"队列预设方案未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"不能与Meta分析结果混为同一证据。小队列人数、干预条件和对照均未报告，无法判断独立队列及效应大小。\",\n          \"quote\": \"The results of our small cohort showed significant improvement in FOG-Q\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42236313\",\n        \"title\": \"Cognitive and Emotional Determinants of Subthalamic Oscillations During Freezing While Turning in Parkinson's Disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"PMID:42236313\",\n        \"cohort_id_candidate\": \"cohort_candidate:PMID:42236313\",\n        \"cohort_relation_basis\": \"摘要报告13名PD患者，在有效转弯和转弯冻结状态下记录STN-LFP。未报告中心、招募日期和患者身份信息，无法与其他队列匹配。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"42236313-E1\",\n          \"design\": \"患者内转弯冻结与有效转弯比较；采用线性混合效应模型。\",\n          \"population\": \"13名PD患者。\",\n          \"n_enrolled\": 13,\n          \"n_analyzed\": 13,\n          \"n_patients_with_FOG\": 13,\n          \"n_patients_with_valid_neural_data\": 13,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告冻结事件数、转弯试次数及STN触点数。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"during_FOG\",\n          \"freezing_phenotype\": \"原文：freezing while turning；具体akinetic/trembling表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"记录STN-LFP；DBS是否开启、刺激参数及触点未报告。\",\n          \"task\": \"转弯中的冻结（freezing while turning）及有效转弯（effective turning）。\",\n          \"recording_location\": \"STN局部场电位。\",\n          \"measure\": \"theta-band LFP power与焦虑严重程度的关系。\",\n          \"frequency_and_analysis_window\": \"theta边界未报告；冻结转弯期间。\",\n          \"finding\": \"转弯冻结期间，STN theta功率与焦虑严重程度呈正相关；有效转弯时未观察到相同关联。\",\n          \"effect_estimate\": \"摘要未报告相关系数及P值。\",\n          \"statistical_unit_and_method\": \"患者内线性混合效应模型；具体随机效应结构未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性事件相关电生理研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募和排除标准未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"冻结转弯的确认方式未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"LFP伪迹处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"some_concerns\", \"reason\": \"认知、焦虑及其他临床因素可能相关，调整细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"some_concerns\", \"reason\": \"使用线性混合模型，但随机效应结构未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"多个认知、情绪领域及频段比较的校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预注册及预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"摘要未报告theta频段边界、效应量和冻结事件数。没有明确说明冻结是否由视频或临床评审确认，因此endpoint_class保留为unclear。\",\n          \"quote\": \"Subthalamic theta power during FoG while turning was positively associated with anxiety severity\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"42236313-E2\",\n          \"design\": \"患者内转弯冻结与有效转弯比较；线性混合效应模型。\",\n          \"population\": \"13名PD患者。\",\n          \"n_enrolled\": 13,\n          \"n_analyzed\": 13,\n          \"n_patients_with_FOG\": 13,\n          \"n_patients_with_valid_neural_data\": 13,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告事件数、试次数及电极触点数量。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"during_FOG\",\n          \"freezing_phenotype\": \"原文：freezing while turning。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"STN-LFP；刺激状态和参数未报告。\",\n          \"task\": \"转弯冻结与有效转弯。\",\n          \"recording_location\": \"STN。\",\n          \"measure\": \"theta-band LFP power与MoCA认知评分的关系。\",\n          \"frequency_and_analysis_window\": \"theta边界未报告；冻结转弯期间。\",\n          \"finding\": \"转弯冻结期间，STN theta功率与MoCA评分呈负相关，认知表现较差者theta功率较高。\",\n          \"effect_estimate\": \"摘要未报告相关系数及P值。\",\n          \"statistical_unit_and_method\": \"线性混合效应模型；具体随机效应结构未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性电生理相关性研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募框架未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"冻结判定方式未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"LFP伪迹控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"some_concerns\", \"reason\": \"认知及情绪变量可能相关，调整细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"some_concerns\", \"reason\": \"混合模型结构未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"多频段和临床变量比较校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"摘要没有报告相关效应大小，不能据此推断theta振荡导致认知损害或FOG。\",\n          \"quote\": \"negatively associated with MoCA scores\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42571859\",\n        \"title\": \"Gait-cycle-locked cortico-subthalamic signatures underlying freezing of gait and their modulation in Parkinson's disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"PMID:42571859\",\n        \"cohort_id_candidate\": \"cohort_candidate:PMID:42571859\",\n        \"cohort_relation_basis\": \"摘要报告FOG患者在步行期间同步记录皮层和STN-LFP及运动学，但未提供患者人数、中心、招募时间或设备信息，无法判断与其他研究队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"42571859-E1\",\n          \"design\": \"步态周期锁定的皮层-STN同步电生理研究；比较无干预条件下冻结试次与非冻结试次。\",\n          \"population\": \"具有FOG的PD患者；样本人数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告患者人数、冻结试次数、非冻结试次数和有效触点数量。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"原文：freezing trials (FOGT)与non-freezing trials (nFOGT)；具体冻结亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"OFF条件；摘要未明确OFF具体指药物关闭、刺激关闭还是无干预状态。\",\n          \"DBS_state_and_parameters\": \"no-intervention condition (OFF)；随后另行比较HFS和LFS；具体刺激频率、幅度、脉宽及触点未报告。\",\n          \"task\": \"自然步行；以步态周期为分析单位，比较FOGT和nFOGT。\",\n          \"recording_location\": \"皮层LFP，包括primary somatosensory cortex (S1)和superior parietal lobule (SPL)；同时记录STN-LFP。\",\n          \"measure\": \"S1和SPL cortical low-beta power。\",\n          \"frequency_and_analysis_window\": \"low-beta边界未报告；以步态周期为分析单位。\",\n          \"finding\": \"OFF条件下FOGT相较nFOGT表现为S1和SPL的low-beta振荡中断/异常。\",\n          \"effect_estimate\": \"摘要未报告效应量和P值。\",\n          \"statistical_unit_and_method\": \"步态周期为分析单位；具体模型及患者内重复测量处理未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性及刺激条件比较电生理研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"患者招募及分析分母未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"FOGT标签生成和确认方法未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"皮层和STN信号伪迹处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物、步速和其他临床因素控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"some_concerns\", \"reason\": \"以步态周期为分析单位，但患者内聚类处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"多脑区、频段及步态相位校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"unclear\", \"reason\": \"预测标志物的独立验证未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预注册和预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"摘要将FOGT与nFOGT作为比较单位，但未明确冻结标签是否经过视频/临床确认。OFF状态定义不完整，不能将其自动等同于Med-Off/Stim-Off。\",\n          \"quote\": \"FOGT showed aberrant gait parameters compared to nFOGT, along with disrupted lowbeta oscillations in primary somatosensory cortex (S1) and superior parietal lobule (SPL).\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"42571859-E2\",\n          \"design\": \"STN高频刺激干预后的步态周期锁定皮层神经活动比较。\",\n          \"population\": \"具有FOG的PD患者；人数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告患者数、试次数和电极触点数。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"原文：freezing-susceptible walking及FOGT；具体亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"high-frequency STN-DBS；具体频率、幅度、脉宽及触点未报告。\",\n          \"task\": \"步态周期锁定步行分析；重点为double support phase。\",\n          \"recording_location\": \"superior parietal lobule (SPL)皮层信号；同时记录STN和皮层LFP。\",\n          \"measure\": \"SPL low-beta power。\",\n          \"frequency_and_analysis_window\": \"low-beta边界未报告；double support phase。\",\n          \"finding\": \"HFS逆转了double support phase期间SPL low-beta功率的病理性降低。\",\n          \"effect_estimate\": \"摘要未报告效应量和P值。\",\n          \"statistical_unit_and_method\": \"步态周期相位锁定比较；具体统计模型未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：刺激条件比较电生理研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"样本人数及招募方式未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"冻结标签确认方法未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"信号质量控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物状态及干预顺序未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"some_concerns\", \"reason\": \"步态周期嵌套于患者，具体处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"脑区、相位和频段校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"预测模型验证未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"没有提供HFS频率数值、刺激参数及SPL功率变化的定量效应。\",\n          \"quote\": \"HFS reversed pathological lowbeta power reduction in SPL during the double support phase\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"42571859-E3\",\n          \"design\": \"STN低频刺激干预后的步态周期锁定皮层神经活动比较。\",\n          \"population\": \"具有FOG的PD患者；人数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告患者、试次及触点数量。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"原文：freezing-susceptible walking；具体亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"low-frequency STN-DBS；具体频率、幅度、脉宽及触点未报告。\",\n          \"task\": \"步态周期锁定步行分析；比较stance phase和swing phase。\",\n          \"recording_location\": \"primary somatosensory cortex (S1)；同时记录STN和皮层LFP。\",\n          \"measure\": \"S1 phase-dependent oscillatory activity。\",\n          \"frequency_and_analysis_window\": \"具体频段边界未报告；stance与swing阶段。\",\n          \"finding\": \"LFS恢复了S1在stance phase和swing phase之间的相位依赖性振荡。\",\n          \"effect_estimate\": \"摘要未报告效应量和P值。\",\n          \"statistical_unit_and_method\": \"步态周期相位锁定分析；具体统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：刺激条件比较电生理研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"患者招募和样本数未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"FOG试次确认方法未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"LFP伪迹处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物及刺激条件顺序未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"some_concerns\", \"reason\": \"步态周期重复测量处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"相位和频段比较校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"摘要没有报告恢复程度和LFS具体频率，不能与HFS结果进行定量比较。\",\n          \"quote\": \"LFS restored phase-dependent oscillations between the stance phase and swing phase in S1.\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"42571859-E4\",\n          \"design\": \"STN高频与低频刺激的步态临床结局比较。\",\n          \"population\": \"具有FOG的PD患者；人数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告样本量、冻结事件数和临床评分具体数据。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"原文：freezing severity；具体亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"HFS和LFS STN-DBS；具体频率及刺激参数未报告。\",\n          \"task\": \"步行及FOG严重程度评估。\",\n          \"recording_location\": \"STN刺激；同时记录皮层及STN-LFP。\",\n          \"measure\": \"步态损害及FOG严重程度。\",\n          \"frequency_and_analysis_window\": \"HFS与LFS比较；评估时间窗未报告。\",\n          \"finding\": \"HFS和LFS均减轻步态损害及冻结严重程度；摘要指出LFS产生更广泛的调节效果。\",\n          \"effect_estimate\": \"未报告具体效应量及P值。\",\n          \"statistical_unit_and_method\": \"患者临床结局比较；具体统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：刺激条件比较研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"样本分母未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"FOG严重程度评估方法未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"not_assessable\", \"reason\": \"该证据为临床结局，不涉及特定信号质量判断。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物和干预顺序未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"患者内比较方法未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"多个刺激条件和临床结局的校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设结局未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"摘要没有报告HFS与LFS直接比较的显著性及FOG具体效应量。\",\n          \"quote\": \"Both HFS and LFS mitigated gait impairment and freezing severity, with LFS exerting broader effects\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"42571859-E5\",\n          \"design\": \"左旋多巴干预前后皮层-STN相干性比较。\",\n          \"population\": \"具有FOG的PD患者；人数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告药物前后有效患者数、试次数及触点数。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"原文：freezing-susceptible walking及gait recovery；具体冻结亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"levodopa administration前后；剂量及时间未报告。\",\n          \"DBS_state_and_parameters\": \"STN-LFP记录；刺激状态及参数未报告。\",\n          \"task\": \"步行及左旋多巴给药后步态恢复评估。\",\n          \"recording_location\": \"S1皮层与STN。\",\n          \"measure\": \"S1-STN theta coherence。\",\n          \"frequency_and_analysis_window\": \"theta边界未报告；步态周期锁定分析。\",\n          \"finding\": \"异常S1-STN theta coherence可被左旋多巴调节，并伴随步态恢复。\",\n          \"effect_estimate\": \"摘要未报告相干性变化的效应量及P值。\",\n          \"statistical_unit_and_method\": \"药物前后相干性比较；具体统计模型未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：药物干预相关电生理研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"药物配对分析样本未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"步态恢复及FOG标签定义未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"皮层和STN信号伪迹处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"some_concerns\", \"reason\": \"左旋多巴同时改变运动表现和神经活动。\", \"source_locator\": \"Abstract Results\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"步态周期和患者内配对处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"频段和相干性比较校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"左旋多巴同时改变神经活动和步态，摘要不能确定theta coherence变化是步态恢复的原因还是伴随结果。\",\n          \"quote\": \"abnormal theta coherence between S1 and STN could be modulated by levodopa, accompanied by gait recovery.\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42909654\",\n        \"title\": \"STN-SNr co-stimulation in Parkinson's disease: a systematic review and meta-analysis of motor and freezing-of-gait outcomes.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"not_applicable\",\n        \"cohort_id_candidate\": null,\n        \"cohort_relation_basis\": \"系统综述纳入10项研究，共109名unique evaluable participants；另有2个单患者病例报告作叙述性总结。不是独立患者队列。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"42909654-E1\",\n          \"design\": \"系统综述及Meta分析；STN-SNr联合刺激与STN-only刺激比较。\",\n          \"population\": \"10项研究中的6项提供FOG数据，共86名参与者；全部综述包含109名unique evaluable participants，另有2例单患者病例报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 86,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"86为FOG分析参与者数，不代表86人均有事件级冻结记录；摘要未报告FOG患者及事件数。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"原文：freezing-of-gait outcomes；具体冻结亚型和量表未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"纳入研究的药物状态未在该合并结果中逐项报告。\",\n          \"DBS_state_and_parameters\": \"STN-SNr co-stimulation对比STN-only stimulation；具体频率、幅度、脉宽和触点未报告。\",\n          \"task\": \"临床FOG结局比较。\",\n          \"recording_location\": \"综述纳入研究的神经记录位置未逐项报告。\",\n          \"measure\": \"FOG临床结局；Meta分析以Hedges' g汇总。\",\n          \"frequency_and_analysis_window\": \"刺激参数及随访窗口未在摘要逐项报告。\",\n          \"finding\": \"STN-SNr联合刺激相较STN-only未显示一致的额外FOG获益。\",\n          \"effect_estimate\": \"Hedges' g=-0.23；95% CI=-1.04至0.59；I²_total=85.6%；GRADE certainty为very low。\",\n          \"statistical_unit_and_method\": \"研究层级Meta分析；考虑配对数据和研究内依赖性。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域及GRADE；仅摘要初评。\",\n            \"domains\": [\n              {\"domain\": \"方案及注册\", \"judgement\": \"some_concerns\", \"reason\": \"报告PROSPERO注册及PRISMA 2020，但完整方案未提供。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"文献检索\", \"judgement\": \"some_concerns\", \"reason\": \"报告六个数据库和检索截止日期，但检索式未提供。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"筛选与提取\", \"judgement\": \"low\", \"reason\": \"摘要明确报告两名评审者独立筛选和提取。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"unclear\", \"reason\": \"摘要未给出各研究具体偏倚风险结果。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"Meta分析及发表偏倚\", \"judgement\": \"some_concerns\", \"reason\": \"FOG异质性很高，发表偏倚分析未报告。\", \"source_locator\": \"Abstract Results\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"FOG结果异质性高，GRADE确定性极低。该比较估计的是联合SNr刺激的增量效果，而非STN刺激相对无刺激的总体效果。\",\n          \"quote\": \"FoG showed no additional benefit across six studies (86 participants; Hedges' g -0.23, 95% CI -1.04 to 0.59; I²_total = 85.6%)\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"42909654-E2\",\n          \"design\": \"系统综述及Meta分析；STN-SNr联合刺激与STN-only刺激比较。\",\n          \"population\": \"7项研究，共73名参与者。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 73,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要报告UPDRS-III参与者数，但未报告FOG患者和事件数量。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"非特异性运动评分；并非FOG事件终点。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"各研究药物状态未逐项报告。\",\n          \"DBS_state_and_parameters\": \"STN-SNr联合刺激对比STN-only。\",\n          \"task\": \"UPDRS-III临床运动评分。\",\n          \"recording_location\": \"未报告神经电生理记录。\",\n          \"measure\": \"UPDRS-III。\",\n          \"frequency_and_analysis_window\": \"未报告。\",\n          \"finding\": \"STN-SNr联合刺激相较STN-only未显示总体UPDRS-III额外改善。\",\n          \"effect_estimate\": \"MD=-0.10；95% CI=-1.01至0.81；I²=0%；GRADE certainty为low。\",\n          \"statistical_unit_and_method\": \"研究层级Meta分析；考虑配对数据。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域及GRADE；仅摘要初评。\",\n            \"domains\": [\n              {\"domain\": \"方案及注册\", \"judgement\": \"some_concerns\", \"reason\": \"注册和方案细节不完整。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"文献检索\", \"judgement\": \"some_concerns\", \"reason\": \"完整检索策略未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"筛选与提取\", \"judgement\": \"low\", \"reason\": \"报告两名评审者独立筛选及提取。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"unclear\", \"reason\": \"各原始研究评价结果未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"Meta分析及发表偏倚\", \"judgement\": \"some_concerns\", \"reason\": \"发表偏倚细节未报告。\", \"source_locator\": \"Abstract Results\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"UPDRS-III不是FOG特异性终点，不能替代FOG结果。\",\n          \"quote\": \"UPDRS-III showed no between-group difference across seven studies (73 participants; MD -0.10, 95% CI -1.01 to 0.81; I² = 0%)\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"42909654-E3\",\n          \"design\": \"系统综述及Meta分析；次要基线比较。\",\n          \"population\": \"纳入STN-SNr联合刺激研究的参与者；具体用于FOG基线比较的人数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告次要基线比较的具体参与者数。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"FOG临床评分；具体表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"摘要未明确各研究药物状态。\",\n          \"DBS_state_and_parameters\": \"STN-SNr联合刺激与刺激关闭或基线状态比较。\",\n          \"task\": \"FOG临床评分。\",\n          \"recording_location\": \"未报告神经记录。\",\n          \"measure\": \"FOG效应，Hedges' g。\",\n          \"frequency_and_analysis_window\": \"未报告。\",\n          \"finding\": \"与刺激关闭或基线比较时，联合刺激显示FOG改善，但该比较不能识别SNr刺激相对于STN-only的增量效果。\",\n          \"effect_estimate\": \"Hedges' g=-0.60；摘要未报告该次要比较的置信区间。\",\n          \"statistical_unit_and_method\": \"研究层级Meta分析；次要基线比较。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域及GRADE；仅摘要初评。\",\n            \"domains\": [\n              {\"domain\": \"方案及注册\", \"judgement\": \"some_concerns\", \"reason\": \"注册信息存在，完整方案未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"文献检索\", \"judgement\": \"some_concerns\", \"reason\": \"完整检索策略未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"筛选与提取\", \"judgement\": \"low\", \"reason\": \"两名评审者独立筛选和提取。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"unclear\", \"reason\": \"原始研究具体评价未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"Meta分析及发表偏倚\", \"judgement\": \"some_concerns\", \"reason\": \"基线比较不能分离SNr增量效应，FOG异质性高。\", \"source_locator\": \"Abstract Results\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"基线或刺激关闭比较无法证明额外SNr刺激本身有效；应与STN-only主动对照结果分开。\",\n          \"quote\": \"Improvements versus stimulation-off or baseline cannot establish an incremental SNr effect.\",\n          \"source_locator\": {\"section\": \"Abstract Conclusions\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"DOI:10.1101/2022.08.23.504923\",\n        \"title\": \"The aperiodic exponent of subthalamic field potentials reflects excitation/inhibition balance in Parkinsonism: a cross-species study in vivo\",\n        \"publication_status\": \"preprint\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"DOI:10.1101/2022.08.23.504923\",\n        \"cohort_id_candidate\": \"cohort_candidate:DOI:10.1101/2022.08.23.504923\",\n        \"cohort_relation_basis\": \"跨物种研究，包含多巴胺耗竭大鼠及清醒PD患者STN-LFP数据。摘要未报告动物和人类样本数，也未提供可与其他论文核对的患者中心、招募时间及设备信息。是否存在正式发表版本为unknown。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"2022PREPRINT-E1\",\n          \"design\": \"跨物种体内电生理实验；多巴胺耗竭大鼠。\",\n          \"population\": \"多巴胺耗竭大鼠；动物数量及具体模型信息未在摘要报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"动物实验部分；患者分母和FOG患者数不适用。摘要未报告动物数、试次数和电极数。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"未报告FOG；研究对象为实验性帕金森样大鼠。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"多巴胺耗竭模型；具体处理方案未报告。\",\n          \"DBS_state_and_parameters\": \"动物STN记录；DBS干预参数未报告。\",\n          \"task\": \"体内STN-LFP记录及基底节网络活动分析。\",\n          \"recording_location\": \"大鼠STN局部场电位。\",\n          \"measure\": \"aperiodic exponent及30–100 Hz LFP power。\",\n          \"frequency_and_analysis_window\": \"30–100 Hz功率；aperiodic exponent拟合频段和窗口未报告。\",\n          \"finding\": \"在多巴胺耗竭大鼠中，较高aperiodic exponent与较低STN神经元放电水平及偏向抑制的E/I平衡相关。\",\n          \"effect_estimate\": \"摘要未报告定量效应量及P值。\",\n          \"statistical_unit_and_method\": \"动物及神经元层级分析；具体统计单位和方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：实验动物电生理研究；不适用临床观察性研究的全部域。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"动物数量及纳入标准未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"not_assessable\", \"reason\": \"未研究FOG行为标签。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"电生理质量控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"模型处理及其他网络因素控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"动物、神经元及试次层级处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"频段和神经元指标比较校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告临床预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预注册和预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"这是动物E/I机制研究，不包含FOG行为终点，不能作为STN神经活动与人类FOG之间的直接证据。\",\n          \"quote\": \"higher aperiodic exponents tally with lower levels of STN neuron firing and a balance tipped towards inhibition.\",\n          \"source_locator\": {\"section\": \"Abstract\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"2022PREPRINT-E2\",\n          \"design\": \"清醒PD患者STN-LFP观察性研究，结合跨物种机制分析。\",\n          \"population\": \"清醒PD患者；人数未在摘要报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告患者人数、FOG表型及有效记录触点数。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"未报告FOG患者分组或冻结事件；不能将研究解释为FOG研究。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"摘要称较高aperiodic exponent伴随dopaminergic medication；具体剂量和时间未报告。\",\n          \"DBS_state_and_parameters\": \"摘要称较高aperiodic exponent伴随STN-DBS；具体频率、幅度、脉宽及触点未报告。\",\n          \"task\": \"清醒状态STN-LFP记录。\",\n          \"recording_location\": \"人类STN局部场电位。\",\n          \"measure\": \"aperiodic exponent及30–100 Hz功率。\",\n          \"frequency_and_analysis_window\": \"30–100 Hz；aperiodic拟合频段和分析窗口未报告。\",\n          \"finding\": \"清醒PD患者接受多巴胺能药物和STN-DBS时，aperiodic exponent较高；作者认为该结果与STN兴奋/抑制平衡变化一致。\",\n          \"effect_estimate\": \"摘要未报告患者数、效应量、P值及置信区间。\",\n          \"statistical_unit_and_method\": \"患者级LFP分析；具体配对方式和统计模型未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：临床观察性电生理研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"患者人数及招募流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"not_assessable\", \"reason\": \"未报告FOG行为标签或事件。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"LFP伪迹处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物与DBS作用及其交互未充分说明。\", \"source_locator\": \"Abstract Results\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"患者内重复记录处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"aperiodic及功率指标校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告FOG预测模型或外部验证。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预注册及预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"摘要没有报告FOG患者、FOG量表或事件级冻结数据。该研究支持STN非周期性谱特征与药物/DBS状态的关系，但不支持其与FOG的直接关系。预印本状态不等同于偏倚风险判断。\",\n          \"quote\": \"higher exponents accompany dopaminergic medication and deep brain stimulation (DBS) of STN\",\n          \"source_locator\": {\"section\": \"Abstract\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"DOI:10.1101/2023.10.31.565053\",\n        \"title\": \"Auditory cues modulate the short timescale dynamics of STN activity during stepping in Parkinson's disease\",\n        \"publication_status\": \"preprint\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"DOI:10.1101/2023.10.31.565053\",\n        \"cohort_id_candidate\": \"cohort_candidate:DOI:10.1101/2023.10.31.565053\",\n        \"cohort_relation_basis\": \"摘要报告8名PD患者进行原地踏步和听觉提示实验。未提供研究中心、招募时间和设备信息，无法与其他STN步态研究确认队列重叠。是否存在正式发表版本为unknown。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"2023PREPRINT-E1\",\n          \"design\": \"患者内听觉提示前、提示中及提示后STN-LFP动态观察研究；采用Hidden Markov Models。\",\n          \"population\": \"8名PD患者。\",\n          \"n_enrolled\": 8,\n          \"n_analyzed\": 8,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": 8,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告FOG患者数、冻结事件数、踏步试次数和电极触点数；研究没有报告FOG结局。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"未报告FOG或FOG-like事件；研究对象为PD患者原地踏步。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"STN-LFP记录；DBS是否开启及刺激参数未报告。\",\n          \"task\": \"stepping in place with auditory cueing。\",\n          \"recording_location\": \"STN局部场电位。\",\n          \"measure\": \"beta burst fractional occupancy及state lifetimes。\",\n          \"frequency_and_analysis_window\": \"beta 15–30 Hz；HMM状态分为pre-sound、on-sound及post-sound；具体时间窗未报告。\",\n          \"finding\": \"听觉提示期间及提示后，beta bursts发生率下降，表现为fractional occupancy和state lifetimes减少。\",\n          \"effect_estimate\": \"摘要未报告具体数值、效应量及P值。\",\n          \"statistical_unit_and_method\": \"HMM识别动态脑状态；患者内事件和试次统计单位未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性步态电生理及提示干预研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募和纳入流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"not_assessable\", \"reason\": \"未研究FOG事件或FOG行为标签。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"STN-LFP质量和运动伪迹处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物状态和听觉提示其他效应控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"患者内提示试次统计处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"HMM状态和多个频段比较校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"unclear\", \"reason\": \"HMM状态数及模型验证方法未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预注册和预设分析方案未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"原地踏步不是自然直立行走中的实际FOG任务。摘要未报告FOG事件，因此不能将听觉提示抑制beta bursts直接解释为减少FOG。\",\n          \"quote\": \"The occurrence of β bursts was suppressed during and after auditory cues.\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"2023PREPRINT-E2\",\n          \"design\": \"患者内听觉提示前、提示中及提示后STN-LFP动态观察研究；采用Hidden Markov Models。\",\n          \"population\": \"8名PD患者。\",\n          \"n_enrolled\": 8,\n          \"n_analyzed\": 8,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": 8,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告FOG患者数、冻结事件数和试次数；没有FOG结局。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"未报告FOG或FOG-like现象。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"STN-LFP记录；刺激状态及参数未报告。\",\n          \"task\": \"原地踏步及听觉提示。\",\n          \"recording_location\": \"STN局部场电位。\",\n          \"measure\": \"alpha transient fractional occupancy及state lifetimes。\",\n          \"frequency_and_analysis_window\": \"alpha频段边界未报告；pre-sound、on-sound、post-sound HMM状态。\",\n          \"finding\": \"与beta相反，alpha transients在听觉提示期间及提示后增加，表现为fractional occupancy和state lifetimes增加。\",\n          \"effect_estimate\": \"摘要未报告数值效应量及P值。\",\n          \"statistical_unit_and_method\": \"HMM动态脑状态分析；具体统计单位未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性步态电生理及提示干预研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"样本选择流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"not_assessable\", \"reason\": \"未研究FOG事件。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"LFP质量控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物及提示相关混杂因素未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"患者内重复试次处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"多个频段和HMM状态比较校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"unclear\", \"reason\": \"HMM模型验证及状态稳定性未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析方案未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"alpha transient增加并不能单独证明其具有抗FOG或促FOG作用。该研究没有实际冻结事件终点。\",\n          \"quote\": \"α transients showed the opposite effect, with fractional occupancy and state lifetimes increasing during and after auditory cues.\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "1e376a5e-f593-4371-aae6-85c7a3ce277c", "session_revision": 0, "session_ttl_max_hours": 6, "job_directory": "D:\\musicclaude\\gpt2agent-safechain\\runs\\gpt3\\pro-bridge-20261113T130056593219Z", "elapsed_seconds": 821.0, "completed_utc": "2026-11-13T13:14:37.610062+00:00", "model": "gpt-6-thinking", "thinking_effort": "max", "temporary": true, "unpersonalized": true, "generation_policy_verified": true, "request_policy": {"model": "gpt-6-thinking", "thinking_effort": "max", "history_and_training_disabled": true, "temporary_chat_requests_personalization": false, "is_do_not_remember": false, "continuation": false, "unpersonalized_inherited_verified": false, "body_sha256": "e839024a187a09146047f605b4d2a6d642c32645670d9ddb942d136533712d30", "attachment_count": 0}, "stream_completion": {"sse_done": true, "message_completed": true, "independent_terminal_verified": true}, "profile": "yi/local-codex-auth", "account_sha256": "b3efb6361563c139233ed7b7ef61a7c9afe0bd48d4eb3525dbe31956b024d6da", "transport": "probridge-pure-http",