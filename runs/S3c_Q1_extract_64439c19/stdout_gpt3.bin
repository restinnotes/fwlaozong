   \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"患者筛选未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"some_concerns\", \"reason\": \"模拟冻结范式的具体标签验证未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"信号质量控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"术中及药物状态控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"事件和试次层级统计未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"时间频率多重比较校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"theta频段边界及定量效应未报告。\",\n          \"quote\": \"an increase in pathological beta and theta rhythms\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"31665229-E4\",\n          \"design\": \"术中虚拟现实步态冻结与自主停止对照比较。\",\n          \"population\": \"8名接受STN-DBS手术的PD患者。\",\n          \"n_enrolled\": 8,\n          \"n_analyzed\": 8,\n          \"n_patients_with_FOG\": 8,\n          \"n_patients_with_valid_neural_data\": 8,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告冻结和自主停止事件数量及试次数。\",\n          \"endpoint_class\": \"C_virtual_simulated\",\n          \"event_phase\": \"during_FOG\",\n          \"freezing_phenotype\": \"原文：pathological freezing；对照为purposeful stopping。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"术中STN微电极记录；刺激参数未报告。\",\n          \"task\": \"虚拟现实冻结行为与有目的的自主停止比较。\",\n          \"recording_location\": \"STN微电极。\",\n          \"measure\": \"STN病理性活动及其时间频率特征。\",\n          \"frequency_and_analysis_window\": \"beta和theta频段边界未报告；冻结起始相关时间窗口。\",\n          \"finding\": \"病理性冻结相关STN活动特征可与有目的的自主停止区分。\",\n          \"effect_estimate\": \"摘要未报告分类准确率、效应量或P值。\",\n          \"statistical_unit_and_method\": \"两类行为状态的神经活动比较；具体分类及统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：术中观察性电生理研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"纳入及选择流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"some_concerns\", \"reason\": \"使用已验证范式，但自主停止与冻结的标注细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"伪迹处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"两种行为的运动及任务差异控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"事件和试次层级处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"时间频率分析校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"unclear\", \"reason\": \"区分性能及独立验证未报告。\", \"source_locator\": \"Abstract Results\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"摘要仅报告可区分的定性结论，没有报告分类性能、样本外验证或具体神经特征阈值。\",\n          \"quote\": \"discernible from that of volitional stopping\",\n          \"source_locator\": {\"section\": \"Abstract Results and Conclusions\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39223361\",\n        \"title\": \"Efficacy of subthalamic deep brain stimulation programming strategies for gait disorders in Parkinson's disease: a systematic review and meta-analysis.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"not_applicable\",\n        \"cohort_id_candidate\": null,\n        \"cohort_relation_basis\": \"系统综述识别36篇文章，其中21篇纳入Meta分析；不构成新的独立患者队列。摘要未列出原始研究PMID/DOI。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39223361-E1\",\n          \"design\": \"系统综述及Meta分析，比较五类STN-DBS编程策略。\",\n          \"population\": \"36篇研究被纳入综述，其中21篇进入Meta分析；患者总数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告Meta分析总患者数、FOG患者数和事件数。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"原文：FOG-Q；具体冻结亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"低频刺激获益在联合多巴胺能治疗时尤其明显；具体Med-On/Med-Off定义未报告。\",\n          \"DBS_state_and_parameters\": \"STN低频刺激（LFS）；频率数值、幅度、脉宽及触点未报告。\",\n          \"task\": \"FOG-Q临床量表评估。\",\n          \"recording_location\": \"综述纳入研究的神经记录位置未逐项报告。\",\n          \"measure\": \"FOG Questionnaire评分。\",\n          \"frequency_and_analysis_window\": \"低频刺激；具体频率及随访窗口未报告。\",\n          \"finding\": \"综述Meta分析认为低频STN-DBS对FOG-Q有积极效果，尤其是在联合多巴胺能治疗时。\",\n          \"effect_estimate\": \"摘要未提供FOG-Q合并均值差、置信区间或P值；报告研究间显著异质性。\",\n          \"statistical_unit_and_method\": \"研究层级Meta分析；具体模型和异质性数值未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域；仅摘要初评。\",\n            \"domains\": [\n              {\"domain\": \"方案及注册\", \"judgement\": \"not_assessable\", \"reason\": \"注册和预设方案未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"文献检索\", \"judgement\": \"some_concerns\", \"reason\": \"报告PubMed、Embase和Lilacs，但检索策略未提供。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"研究筛选与数据提取\", \"judgement\": \"not_assessable\", \"reason\": \"双人筛选和提取流程未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"not_assessable\", \"reason\": \"未报告具体评价结果。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"Meta分析及发表偏倚\", \"judgement\": \"some_concerns\", \"reason\": \"报告显著异质性，但具体模型和发表偏倚检验未报告。\", \"source_locator\": \"Abstract Results\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"低频刺激的具体参数、FOG-Q合并效应及药物分层数据未在摘要提供。显著异质性限制了统一效应解释。\",\n          \"quote\": \"low-frequency STN-DBS demonstrated positive outcomes in total UPDRS-III score and FOG-Q, especially when combined with dopaminergic therapy.\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39470410\",\n        \"title\": \"Supraspinal contributions to defective antagonistic inhibition and freezing of gait in Parkinson's disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"PMID:39470410\",\n        \"cohort_id_candidate\": \"cohort_candidate:PMID:39470410\",\n        \"cohort_relation_basis\": \"摘要描述慢性记录STN-LFP并同步采集EMG和步态运动学的PD患者，但未提供样本数、研究中心及招募时间，无法判断与其他步态电生理研究是否重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39470410-E1\",\n          \"design\": \"自然步行中的同步STN-LFP、下肢表面EMG及运动学观察研究；包含自主停止对照。\",\n          \"population\": \"PD患者；样本数未在摘要报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告患者数、冻结事件数、步行试次数及记录触点数量。\",\n          \"endpoint_class\": \"B_objective_natural\",\n          \"event_phase\": \"pre_FOG_event_associated\",\n          \"freezing_phenotype\": \"原文：freezing of gait；转入冻结时存在拮抗肌协同异常；具体akinetic/trembling表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"使用慢性STN-LFP记录；DBS是否开启、频率、幅度、脉宽及触点未报告。\",\n          \"task\": \"自然步行及冻结；另设置internally generated volitional stops作为对照。\",\n          \"recording_location\": \"STN局部场电位；下肢拮抗肌表面EMG。\",\n          \"measure\": \"STN oscillatory activation-deactivation activity。\",\n          \"frequency_and_analysis_window\": \"具体振荡频段未报告；摘要明确涉及冻结发生前的神经活动。\",\n          \"finding\": \"STN振荡活动在冻结发生前出现特异性activation-deactivation异常。\",\n          \"effect_estimate\": \"摘要未报告频段特异效应量、P值及置信区间。\",\n          \"statistical_unit_and_method\": \"事件相关分析；患者、冻结事件及步态周期统计单位未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性自然步行电生理研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"患者招募及选择流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"some_concerns\", \"reason\": \"同步运动学和EMG支持客观识别，但视频/临床确认方式未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"LFP及EMG伪迹剔除流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物、步速及运动严重度控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"事件和患者内重复测量模型细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"频段、肌肉及时间窗口比较校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"摘要未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预注册及预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"摘要没有给出频段边界、冻结事件数量和具体分析时间窗。虽然记录了步态运动学和EMG，但未明确报告视频或临床评审确认。\",\n          \"quote\": \"specific activation-deactivation abnormalities of oscillatory activity of the subthalamic nucleus both before and during a freeze.\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"39470410-E2\",\n          \"design\": \"自然步行中的事件相关STN-LFP观察研究。\",\n          \"population\": \"PD患者；样本数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告患者数、冻结事件数及触点数量。\",\n          \"endpoint_class\": \"B_objective_natural\",\n          \"event_phase\": \"during_FOG\",\n          \"freezing_phenotype\": \"原文：freezing of gait；具体表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"慢性STN-LFP记录；刺激状态及参数未报告。\",\n          \"task\": \"自然步行中的实际冻结。\",\n          \"recording_location\": \"STN局部场电位。\",\n          \"measure\": \"STN oscillatory activation-deactivation activity。\",\n          \"frequency_and_analysis_window\": \"频段边界未报告；冻结期间分析。\",\n          \"finding\": \"STN振荡活动在冻结期间出现特异性activation-deactivation异常。\",\n          \"effect_estimate\": \"摘要未报告效应量和P值。\",\n          \"statistical_unit_and_method\": \"事件相关分析；具体统计模型未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性自然步行电生理研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募框架未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"some_concerns\", \"reason\": \"运动学及EMG记录支持冻结识别，但确认标准未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"LFP伪迹控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物及步态因素控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"患者内事件相关性处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"频段和时间窗校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预注册未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"摘要没有给出具体频段及冻结期间神经活动的量化结果。\",\n          \"quote\": \"both before and during a freeze.\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"39470410-E3\",\n          \"design\": \"自然步行事件相关STN-肌肉同步分析。\",\n          \"population\": \"PD患者；样本数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告患者数、事件数和记录通道数。\",\n          \"endpoint_class\": \"B_objective_natural\",\n          \"event_phase\": \"pre_FOG_event_associated\",\n          \"freezing_phenotype\": \"原文：turning into freezing；涉及腓肠肌异常激活及拮抗肌共同收缩。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"慢性STN-LFP记录；DBS状态和参数未报告。\",\n          \"task\": \"自然步行中转弯并进入冻结；同步记录STN和腓肠肌。\",\n          \"recording_location\": \"STN LFP与gastrocnemius surface EMG。\",\n          \"measure\": \"subthalamo-muscular coherence。\",\n          \"frequency_and_analysis_window\": \"相干性频段边界未报告；冻结发生前的时间窗口。\",\n          \"finding\": \"冻结发生前，STN与腓肠肌之间的相干性增加；摘要进一步报告丘脑底核-脊髓回路可将异常时间模式传递至脊髓运动神经元。\",\n          \"effect_estimate\": \"相干性增加的效应量及P值未报告。\",\n          \"statistical_unit_and_method\": \"同步分析及相干性分析；具体统计模型未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性电生理及同步分析研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募和纳入标准未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"some_concerns\", \"reason\": \"步态运动学和EMG支持事件识别，但确认标准未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"同步信号伪迹控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物及步态速度因素控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"患者内事件重复测量处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"肌肉和频段相干性校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"这是冻结前STN-肌肉同步关系的直接事件相关证据，但摘要没有报告具体相干频段、效应量及时间滞后。\",\n          \"quote\": \"increased subthalamo-muscular coherence with the gastrocnemius muscles before the freeze.\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39884164\",\n        \"title\": \"Alpha and high beta subthalamic intermittent activity correlates with freezing of gait severity in Parkinson's disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"PMID:39884164\",\n        \"cohort_id_candidate\": \"cohort_candidate:PMID:39884164\",\n        \"cohort_relation_basis\": \"摘要明确报告23人队列，其中FOG组14人、非FOG组9人。未提供中心、招募日期及设备信息，不能与2014年或其他STN-LFP研究确认队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39884164-E1\",\n          \"design\": \"静息状态STN-LFP观察性病例对照研究。\",\n          \"population\": \"23名PD患者；FOG组14人，n-FOG组9人。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 23,\n          \"n_patients_with_FOG\": 14,\n          \"n_patients_with_valid_neural_data\": 23,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告冻结事件数、静息记录试次数和电极触点数量。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"原文：patients with FOG；严重程度以FOG score评估；具体akinetic/trembling表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"静息记录药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"STN-LFP记录；刺激状态及参数未报告。\",\n          \"task\": \"静息态LFP记录。\",\n          \"recording_location\": \"STN局部场电位。\",\n          \"measure\": \"alpha bandpower。\",\n          \"frequency_and_analysis_window\": \"alpha频段边界未报告；静息态功率分析。\",\n          \"finding\": \"FOG组alpha bandpower高于非FOG组。\",\n          \"effect_estimate\": \"FOG：0.331±0.087；n-FOG：0.248±0.089；P=0.011。\",\n          \"statistical_unit_and_method\": \"患者级FOG组与非FOG组比较；具体检验方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性电生理研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募及组别构建流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear