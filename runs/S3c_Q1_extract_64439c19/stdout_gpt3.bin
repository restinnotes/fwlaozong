_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"静息态；药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"STN-LFP；刺激状态未报告。\",\n          \"task\": \"静息态。\",\n          \"recording_location\": \"STN。\",\n          \"measure\": \"intermittent/burst alpha amplitude。\",\n          \"frequency_and_analysis_window\": \"alpha边界及burst检测阈值未报告；静息态。\",\n          \"finding\": \"FOG组intermittent alpha amplitude高于非FOG组。\",\n          \"effect_estimate\": \"FOG：0.610±0.068；n-FOG：0.524±0.086；P=0.005。\",\n          \"statistical_unit_and_method\": \"患者组间比较；具体检验方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性电生理研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"FOG分组依据未详细报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"信号质量控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物及临床因素控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"患者和通道层级处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"多个burst特征校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"摘要没有报告burst定义、检测阈值和患者内重复测量处理。\",\n          \"quote\": \"intermittent (b