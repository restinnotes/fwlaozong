{"completed": true, "response": "<escape>{\n  \"papers\": [\n    {\n      \"publication\": {\n        \"ref\": \"PMID:18420482\",\n        \"title\": \"STN-DBS frequency effects on freezing of gait in advanced Parkinson disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"PMID:18420482\",\n        \"cohort_id_candidate\": \"cohort_candidate:PMID:18420482\",\n        \"cohort_relation_basis\": \"摘要报告13名严重步态障碍PD患者，但未提供中心、招募时间及其他研究队列信息，无法判断与其他论文是否重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"18420482-E1\",\n          \"design\": \"盲法STN-DBS参数比较研究；摘要未说明随机化、分配隐藏及交叉顺序。\",\n          \"population\": \"13名报告严重步态障碍的晚期PD患者。\",\n          \"n_enrolled\": 13,\n          \"n_analyzed\": 13,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告明确的FOG患者人数、冻结事件数及测试次数；未报告神经记录，电极数不适用。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"unclear\",\n          \"freezing_phenotype\": \"原文：severe gait disorders、freezing episodes；具体冻结表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"摘要未报告测试时药物状态。\",\n          \"DBS_state_and_parameters\": \"STN-DBS；60 Hz高电压条件，目标为与130 Hz条件维持相同总刺激能量；高电压中位数3.7 V；对照为off-stimulation。脉宽、触点及方向性未报告。\",\n          \"task\": \"步态及冻结事件评估；具体步行任务和冻结判定程序未报告。\",\n          \"recording_location\": \"无神经电生理记录；不适用。\",\n          \"measure\": \"freezing episodes数量。\",\n          \"frequency_and_analysis_window\": \"60 Hz；刺激频率条件比较；事件统计窗口未报告。\",\n          \"finding\": \"60 Hz高电压、等能量刺激条件下的冻结事件数显著低于off-stimulation条件。\",\n          \"effect_estimate\": \"方向：减少FOG事件；P值、绝对事件数、相对变化及置信区间均未在摘要报告。\",\n          \"statistical_unit_and_method\": \"患者内刺激条件比较；具体统计单位及检验方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"ROBINS-I相关域的摘要级初评；随机化信息不足。\",\n            \"domains\": [\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物状态及刺激条件顺序未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"参与者选择\", \"judgement\": \"some_concerns\", \"reason\": \"仅纳入严重步态障碍患者，代表性有限。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"干预分类\", \"judgement\": \"unclear\", \"reason\": \"各刺激参数明确，但分配过程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"偏离干预\", \"judgement\": \"unclear\", \"reason\": \"盲法已提及，执行及依从性未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"缺失数据\", \"judgement\": \"unclear\", \"reason\": \"缺失测量及排除情况未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"结局测量\", \"judgement\": \"unclear\", \"reason\": \"冻结事件的判定及评估者一致性未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预注册和预设分析方案未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"没有全文核查。不能确认冻结事件是否经视频或临床评审，也不能判断60 Hz相对于130 Hz的直接统计比较是否显著。无神经活动记录，不能作为STN振荡与FOG关系的直接证据。\",\n          \"quote\": \"The number of freezing episodes was significantly lower at the 60-Hz \\\"high voltage/equivalent energy\\\"\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"18420482-E2\",\n          \"design\": \"盲法STN-DBS参数比较研究；摘要未说明随机化、分配隐藏及交叉顺序。\",\n          \"population\": \"13名报告严重步态障碍的晚期PD患者。\",\n          \"n_enrolled\": 13,\n          \"n_analyzed\": 13,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告FOG患者具体人数、事件数及测试次数；未进行神经记录。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"unclear\",\n          \"freezing_phenotype\": \"原文：freezing episodes；具体表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"unknown\",\n          \"DBS_state_and_parameters\": \"130 Hz高电压条件，中位数3.7 V；对照为off-stimulation。另比较常规电压，中位数3 V；脉宽、触点未报告。\",\n          \"task\": \"步态及冻结事件评估；具体任务未报告。\",\n          \"recording_location\": \"无神经电生理记录。\",\n          \"measure\": \"freezing episodes数量。\",\n          \"frequency_and_analysis_window\": \"130 Hz；高电压条件；事件统计窗口未报告。\",\n          \"finding\": \"130 Hz高电压刺激条件下的冻结事件数高于off-stimulation条件。\",\n          \"effect_estimate\": \"方向：增加FOG事件；具体效应量、P值及置信区间未报告。\",\n          \"statistical_unit_and_method\": \"患者内条件比较；统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"ROBINS-I相关域的摘要级初评。\",\n            \"domains\": [\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物状态及条件顺序未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"参与者选择\", \"judgement\": \"some_concerns\", \"reason\": \"仅纳入严重步态障碍患者。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"干预分类\", \"judgement\": \"unclear\", \"reason\": \"刺激参数明确，分配过程不明。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"偏离干预\", \"judgement\": \"unclear\", \"reason\": \"盲法执行细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"缺失数据\", \"judgement\": \"unclear\", \"reason\": \"缺失情况未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"结局测量\", \"judgement\": \"unclear\", \"reason\": \"冻结事件判定方法未报告。\", \"source_locator\": \"Abstract Results\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析方案未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"摘要未提供130 Hz高电压与60 Hz高电压的直接效应估计。不能据此推断所有130 Hz刺激均恶化FOG。\",\n          \"quote\": \"and higher at the 130-Hz/high voltage than for \\\"off stimulation.\\\"\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:19815246\",\n        \"title\": \"[Deep brain stimulation and gait disorders in Parkinson disease].\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"not_applicable\",\n        \"cohort_id_candidate\": null,\n        \"cohort_relation_basis\": \"综述性论文，不构成独立患者队列。摘要没有列出被转述原始研究的PMID或DOI，无法建立具体原始研究对应关系。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"19815246-E1\",\n          \"design\": \"叙述性综述。\",\n          \"population\": \"综述所涉及的PD患者；原始研究样本及队列数量未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告原始研究样本分母及具体研究引用。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"原文：levodopa-responsive gait disorders and FOG；具体冻结亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"左旋多巴反应性步态障碍；具体测试药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"STN stimulation；频率、幅度、脉宽及触点未报告。\",\n          \"task\": \"临床步态障碍及FOG评估；具体任务未报告。\",\n          \"recording_location\": \"原始研究神经记录位置未在摘要列明。\",\n          \"measure\": \"临床步态障碍及FOG改善情况。\",\n          \"frequency_and_analysis_window\": \"未报告。\",\n          \"finding\": \"综述认为STN刺激可以改善左旋多巴反应性步态障碍和FOG。\",\n          \"effect_estimate\": \"定性描述；无独立效应量、置信区间或P值。\",\n          \"statistical_unit_and_method\": \"综述性叙述；原始统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"ROBIS/AMSTAR 2相关域；仅摘要，无法完整评价。\",\n            \"domains\": [\n              {\"domain\": \"研究问题与纳入标准\", \"judgement\": \"not_assessable\", \"reason\": \"摘要未报告详细纳入标准。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"文献检索\", \"judgement\": \"not_assessable\", \"reason\": \"检索数据库及策略未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"研究筛选与数据提取\", \"judgement\": \"not_assessable\", \"reason\": \"筛选和提取流程未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"not_assessable\", \"reason\": \"原始研究质量评价未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"综合与选择性报告\", \"judgement\": \"not_assessable\", \"reason\": \"未报告系统综合方法和发表偏倚分析。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"这是二级证据，不能视为新的患者队列或独立重复验证。未报告具体原始研究PMID/DOI，不能核实效应大小及患者重叠。\",\n          \"quote\": \"Stimulation of the subthalamic nucleus (STN) improves levodopa-responsive gait disorders and FOG.\",\n          \"source_locator\": {\"section\": \"Abstract State of art\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"19815246-E2\",\n          \"design\": \"叙述性综述。\",\n          \"population\": \"综述涉及的接受STN刺激的PD患者；原始队列数量未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告原始研究样本量。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"原文：worsening of gait and FOG；具体冻结表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"左旋多巴与STN刺激的临床疗效比较；具体药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"STN stimulation；具体参数未报告。\",\n          \"task\": \"临床步态及FOG评估。\",\n          \"recording_location\": \"未报告神经记录。\",\n          \"measure\": \"STN刺激后步态和FOG临床变化。\",\n          \"frequency_and_analysis_window\": \"未报告。\",\n          \"finding\": \"综述指出部分患者在STN刺激后步态恶化，也有患者在左旋多巴治疗下的步态改善优于STN刺激。\",\n          \"effect_estimate\": \"定性描述；无患者人数、效应量及P值。\",\n          \"statistical_unit_and_method\": \"综述性叙述；未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"ROBIS/AMSTAR 2相关域；仅摘要，无法完整评价。\",\n            \"domains\": [\n              {\"domain\": \"研究问题与纳入标准\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"文献检索\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"研究筛选与数据提取\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"综合与选择性报告\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"属于临床反应异质性的综述性陈述，没有给出患者级分层、刺激参数或比较效应量。\",\n          \"quote\": \"some patients worsen after STN stimulation and others are better improved under levodopa than under STN stimulation.\",\n          \"source_locator\": {\"section\": \"Abstract State of art\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"19815246-E3\",\n          \"design\": \"叙述性综述。\",\n          \"population\": \"接受STN刺激的PD患者；具体原始队列未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告患者及原始研究分母。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"原文：levodopa-resistant gait disorders and FOG。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"左旋多巴抵抗表型；具体测试状态未报告。\",\n          \"DBS_state_and_parameters\": \"STN stimulation；参数未报告。\",\n          \"task\": \"临床步态障碍和FOG评估。\",\n          \"recording_location\": \"未报告。\",\n          \"measure\": \"左旋多巴抵抗性步态障碍及FOG对STN刺激的临床反应。\",\n          \"frequency_and_analysis_window\": \"未报告。\",\n          \"finding\": \"综述认为左旋多巴抵抗性步态障碍和FOG通常不受益于STN刺激。\",\n          \"effect_estimate\": \"定性结论；无效应量及P值。\",\n          \"statistical_unit_and_method\": \"综述性叙述。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"ROBIS/AMSTAR 2相关域；仅摘要。\",\n            \"domains\": [\n              {\"domain\": \"文献检索\", \"judgement\": \"not_assessable\", \"reason\": \"检索策略未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"研究筛选\", \"judgement\": \"not_assessable\", \"reason\": \"筛选流程未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"数据提取\", \"judgement\": \"not_assessable\", \"reason\": \"提取流程未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"没有给出左旋多巴抵抗性FOG的操作性定义，也没有量化无效比例。\",\n          \"quote\": \"Levodopa-resistant gait disorders and FOG do not usually benefit from STN stimulation.\",\n          \"source_locator\": {\"section\": \"Abstract State of art\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"19815246-E4\",\n          \"design\": \"叙述性综述。\",\n          \"population\": \"罕见左旋多巴诱发FOG的PD患者；人数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告患者数和事件数。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"原文：levodopa-induced FOG。\",\n          \"medication_phenotype\": \"biphasic\",\n          \"experimental_medication_state\": \"左旋多巴治疗及其减量或停止；具体剂量未报告。\",\n          \"DBS_state_and_parameters\": \"STN stimulation；具体参数未报告。\",\n          \"task\": \"临床FOG评估。\",\n          \"recording_location\": \"未报告。\",\n          \"measure\": \"左旋多巴诱发FOG及减少左旋多巴治疗后的临床变化。\",\n          \"frequency_and_analysis_window\": \"未报告。\",\n          \"finding\": \"综述提出，在罕见的左旋多巴诱发FOG病例中，STN刺激可能通过允许减少或停止左旋多巴治疗而间接改善FOG。\",\n          \"effect_estimate\": \"定性描述；未报告效应量。\",\n          \"statistical_unit_and_method\": \"综述性叙述。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"ROBIS/AMSTAR 2相关域；仅摘要。\",\n            \"domains\": [\n              {\"domain\": \"文献检索\", \"judgement\": \"not_assessable\", \"reason\": \"检索方法未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"研究筛选\", \"judgement\": \"not_assessable\", \"reason\": \"筛选方法未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"数据提取\", \"judgement\": \"not_assessable\", \"reason\": \"提取方法未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"综合与报告\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"属于间接治疗机制的综述性描述，不能视为STN活动与FOG的直接神经生理证据。\",\n          \"quote\": \"STN stimulation may be indirectly effective, as it enables reduction or arrest of the levodopa treatment.\",\n          \"source_locator\": {\"section\": \"Abstract State of art\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:24361601\",\n        \"title\": \"High beta activity in the subthalamic nucleus and freezing of gait in Parkinson's disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"PMID:24361601\",\n        \"cohort_id_candidate\": \"cohort_candidate:PMID:24361601\",\n        \"cohort_relation_basis\": \"摘要明确报告p-FOG组14人、n-FOG组8人。未报告中心、招募时间和患者身份，不能确认与其他STN-LFP研究是否存在队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"24361601-E1\",\n          \"design\": \"患者组间观察性神经电生理研究，包含左旋多巴干预前后比较。\",\n          \"population\": \"22名植入STN慢性刺激电极的PD患者；p-FOG组14人，n-FOG组8人。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 22,\n          \"n_patients_with_FOG\": 14,\n          \"n_patients_with_valid_neural_data\": 22,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要报告组别分母及神经信号分析人数；未报告冻结事件数、试次数和电极触点数量。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"原文：patients with freezing of gait (p-FOG)；具体akinetic/trembling表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"组间比较的基线药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"患者植入STN慢性DBS电极；神经记录时DBS是否开启及刺激参数未报告。\",\n          \"task\": \"STN及皮层EEG振荡活动评估；具体行为任务未报告。\",\n          \"recording_location\": \"STN局部神经信号及皮层EEG。\",\n          \"measure\": \"STN high-beta band power。\",\n          \"frequency_and_analysis_window\": \"low beta为13–20 Hz；high-beta边界未报告；功率分析窗口未报告。\",\n          \"finding\": \"p-FOG患者STN high-beta功率高于n-FOG患者。\",\n          \"effect_estimate\": \"F=11.6，P=0.002；具体功率均值、差值及置信区间未报告。\",\n          \"statistical_unit_and_method\": \"患者组间比较；摘要报告F统计量，具体模型及患者内重复测量处理未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性电生理研究领域级初评。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募框架及连续纳入情况未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"FOG分组判定及评审一致性未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"信号质量及伪迹剔除流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"病程、药物及临床严重度调整未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"患者级与电极/通道级统计单位未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"频段及脑区比较的校正策略未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"摘要未报告预测模型或外部验证。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预注册及预设分析方案未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"这是Freezer与Non-freezer患者分组关联，而不是同一冻结事件前后的神经活动证据。摘要没有说明基线药物及DBS状态，不能排除临床状态混杂。\",\n          \"quote\": \"p-FOG patients showed higher power in the high-beta band (F=11.6, p=0.002)\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"24361601-E2\",\n          \"design\": \"患者内左旋多巴干预前后神经电生理比较。\",\n          \"population\": \"植入STN慢性刺激电极的PD患者；研究总样本22人，其中FOG组14人。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 22,\n          \"n_patients_with_FOG\": 14,\n          \"n_patients_with_valid_neural_data\": 22,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告具体配对分析人数、事件数和电极触点数量。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"原文：FOG；具体冻结表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"l-dopa administration后；剂量、给药时间及具体基线状态未报告。\",\n          \"DBS_state_and_parameters\": \"植入STN-DBS电极；测试时刺激状态及参数未报告。\",\n          \"task\": \"左旋多巴给药前后神经振荡及FOG临床状态比较。\",\n          \"recording_location\": \"STN LFP及皮层EEG。\",\n          \"measure\": \"STN high-beta band power。\",\n          \"frequency_and_analysis_window\": \"high-beta频率边界及分析窗口未报告。\",\n          \"finding\": \"左旋多巴给药后high-beta活动显著降低，同时FOG受到抑制。\",\n          \"effect_estimate\": \"F=4.6，P=0.042；功率变化幅度未报告。\",\n          \"statistical_unit_and_method\": \"药物前后比较；摘要报告F统计量，具体模型未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性电生理及药物状态比较。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"配对分析样本及纳入流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"FOG抑制的事件级确认方法未报告。\", \"source_locator\": \"Abstract Results\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"伪迹处理流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"some_concerns\", \"reason\": \"药物干预同时改变FOG和STN活动，其他同步变化未说明。\", \"source_locator\": \"Abstract Results\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"患者内配对及电极层级统计方法未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"频段及相干性多重比较校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析方案未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"左旋多巴同时改变临床FOG和神经活动，摘要不能证明high-beta降低是FOG改善的中介原因。缺少事件级时间锁定分析。\",\n          \"quote\": \"significantly reduced after l-dopa administration along with suppression of FOG\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"24361601-E3\",\n          \"design\": \"皮层-STN频段相干性空间分布观察研究。\",\n          \"population\": \"植入STN慢性刺激电极的PD患者；总样本22人。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 22,\n          \"n_patients_with_FOG\": 14,\n          \"n_patients_with_valid_neural_data\": 22,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告相干性分析的具体患者数、通道数及试次数。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"FOG患者分组；具体表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"相干性分析时药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"植入STN-DBS电极；记录时刺激状态未报告。\",\n          \"task\": \"皮层EEG-STN神经活动分析；具体任务未报告。\",\n          \"recording_location\": \"STN及不同位置的皮层EEG电极。\",\n          \"measure\": \"high-beta及low-beta cortico-STN coherence的空间分布。\",\n          \"frequency_and_analysis_window\": \"low-beta为13–20 Hz；high-beta边界和相干性分析窗口未报告。\",\n          \"finding\": \"High-beta cortico-STN coherence在中线皮层EEG电极处最大；low-beta coherence在外侧电极处最大。\",\n          \"effect_estimate\": \"空间分布差异χ²=20.60；摘要所给P值文本不完整，记为null。\",\n          \"statistical_unit_and_method\": \"不同皮层电极位置的频段相干性分布比较；摘要报告χ²检验。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性电生理研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募及分析样本选择未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"unclear\", \"reason\": \"FOG表型定义未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"EEG/LFP伪迹处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物及临床因素调整未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"电极位置和患者内相关性处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"多个电极及频段比较的校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析计划未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"该结果描述频段空间分布，并不等同于证明high-beta相干性直接导致FOG。摘要没有提供具体电极数量、效应量和完整P值。\",\n          \"quote\": \"High-beta cortico-STN coherence was maximal for midline cortical EEG electrodes\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:25540305\",\n        \"title\": \"Low-frequency stimulation of STN-DBS reduces aspiration and freezing of gait in patients with PD.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"PMID:25540305\",\n        \"cohort_id_candidate\": \"cohort_candidate:PMID:25540305\",\n        \"cohort_relation_basis\": \"摘要报告7名持续FOG患者，未报告研究中心、招募时间或可供跨论文匹配的患者特征。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"25540305-E1\",\n          \"design\": \"随机、双盲、患者内三条件STN-DBS比较研究；单日完成评估。\",\n          \"population\": \"7名接受双侧STN-DBS、常规130 Hz刺激和多巴胺能药物治疗后仍有FOG的PD患者。\",\n          \"n_enrolled\": 7,\n          \"n_analyzed\": 7,\n          \"n_patients_with_FOG\": 7,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要报告7名患者；FOG事件数和Stand-Walk-Sit具体试次数未报告；未进行神经记录。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"原文：FOG persistent despite routine 130-Hz stimulation and dopaminergic medication；具体亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"Med-On。\",\n          \"DBS_state_and_parameters\": \"双侧STN-DBS；130 Hz、60 Hz及DBS off三种条件；幅度、脉宽及触点未报告。\",\n          \"task\": \"FOG questionnaire及Stand-Walk-Sit Test；同日三种刺激条件下评估。\",\n          \"recording_location\": \"无神经电生理记录。\",\n          \"measure\": \"FOG问卷及Stand-Walk-Sit步态测试。\",\n          \"frequency_and_analysis_window\": \"60 Hz与130 Hz；临床FOG量表和步态测试窗口未报告。\",\n          \"finding\": \"Med-On状态下，与常规130 Hz相比，60 Hz刺激显著减少FOG。\",\n          \"effect_estimate\": \"方向：60 Hz优于130 Hz；FOG具体数值、效应量及P值未在摘要报告。\",\n          \"statistical_unit_and_method\": \"患者内配对比较；摘要说明采用paired t test分析60 Hz与130 Hz，其他条件比较使用Bonferroni校正。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"RoB 2摘要级初评。\",\n            \"domains\": [\n              {\"domain\": \"随机化过程\", \"judgement\": \"some_concerns\", \"reason\": \"报告随机化，但序列生成和分配隐藏未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"偏离预定干预\", \"judgement\": \"some_concerns\", \"reason\": \"报告双盲，但盲法执行和成功情况未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"缺失结局数据\", \"judgement\": \"unclear\", \"reason\": \"缺失数据及退出情况未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"结局测量\", \"judgement\": \"some_concerns\", \"reason\": \"FOG包含问卷和步态测试，评估者盲法未明确。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"未提供预注册和完整预设结局清单。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"仅7名患者；FOG为次要结局。摘要没有报告FOG事件级确认、具体量表效应值和刺激幅度。\",\n          \"quote\": \"It also significantly reduced FOG, and axial and parkinsonian symptoms.\",\n          \"source_locator\": {\"section\": \"Abstract Methods and Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"25540305-E2\",\n          \"design\": \"随机双盲刺激条件比较后进行3–8周临床随访。\",\n          \"population\": \"7名持续FOG的双侧STN-DBS患者。\",\n          \"n_enrolled\": 7,\n          \"n_analyzed\": 7,\n          \"n_patients_with_FOG\": 7,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告随访实际完成人数、事件数和试次数；未进行神经记录。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"原文：FOG persistent despite routine 130-Hz stimulation；具体亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"随访期间药物状态未在摘要明确说明。\",\n          \"DBS_state_and_parameters\": \"60 Hz最佳刺激条件被维持3–8周；平均评估时间约6周。其他参数未报告。\",\n          \"task\": \"维持60 Hz刺激后的FOG及临床症状随访。\",\n          \"recording_location\": \"无神经电生理记录。\",\n          \"measure\": \"FOG及轴性、帕金森运动症状。\",\n          \"frequency_and_analysis_window\": \"60 Hz；随访3–8周，平均约6周。\",\n          \"finding\": \"60 Hz刺激带来的临床获益在平均6周随访时仍然存在。\",\n          \"effect_estimate\": \"持续时间平均约6周；FOG随访效应量和P值未报告。\",\n          \"statistical_unit_and_method\": \"患者随访比较；具体统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"RoB 2摘要级初评。\",\n            \"domains\": [\n              {\"domain\": \"随机化过程\", \"judgement\": \"some_concerns\", \"reason\": \"随机化细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"偏离预定干预\", \"judgement\": \"some_concerns\", \"reason\": \"长期刺激维持及依从性未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"缺失结局数据\", \"judgement\": \"unclear\", \"reason\": \"随访完成情况未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"结局测量\", \"judgement\": \"unclear\", \"reason\": \"随访FOG评估者盲法未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预注册和预设随访结局未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"摘要没有提供随访时的独立对照条件，不能确认6周持续获益的精确效应及其是否由其他同期治疗变化解释。\",\n          \"quote\": \"The benefits at 60-Hz stimulation persisted over the average 6-week assessment.\",\n          \"source_locator\": {\"section\": \"Abstract Methods and Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:26887333\",\n        \"title\": \"Subthalamic stimulation may inhibit the beneficial effects of levodopa on akinesia and gait.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"PMID:26887333\",\n        \"cohort_id_candidate\": \"cohort_candidate:PMID:26887333\",\n        \"cohort_relation_basis\": \"多中心研究，摘要报告17名出现STN-DBS相关步态和/或运动不能恶化的患者，其中12名完成完整评估。未报告各中心人数及招募时间。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"26887333-E1\",\n          \"design\": \"多中心、选择性病例队列及患者内五条件临床比较研究；是否随机化未报告。\",\n          \"population\": \"17名STN-DBS后出现步态和/或运动不能恶化且停刺激后可逆的PD患者；12名完成完整评估。\",\n          \"n_enrolled\": 17,\n          \"n_analyzed\": 12,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"5名未完成完整评估；原因未在摘要报告。FOG患者具体人数和事件数未报告；无神经记录。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"原文：worsening of gait and/or akinesia following STN-DBS；FOG采用临床量表评估，具体冻结亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"关键比较为on-drug；另有off-drug条件。\",\n          \"DBS_state_and_parameters\": \"STN-DBS；比较off-DBS、best-compromise-DBS及诱发最明显步态恶化的worsening-DBS。对worsening contact进行单极触点测试；具体频率、幅度及脉宽未报告。恶化触点主要位于STN背侧和前方的前部zona incerta及Forel fields H2。\",\n          \"task\": \"Stand-Walk-Sit Test及FOG临床量表；包括五种药物和刺激状态组合。\",\n          \"recording_location\": \"无LFP或单/多单位记录；刺激触点解剖定位涉及STN背侧和前部区域。\",\n          \"measure\": \"FOG临床评分。\",\n          \"frequency_and_analysis_window\": \"刺激频率及分析窗口未报告。\",\n          \"finding\": \"on-drug/on-worsening-DBS条件相较on-drug/off-DBS条件显著恶化FOG。\",\n          \"effect_estimate\": \"P=0.02；效应量及置信区间未报告。\",\n          \"statistical_unit_and_method\": \"患者内五条件比较；具体统计检验未在摘要报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"ROBINS-I摘要级初评。\",\n            \"domains\": [\n              {\"domain\": \"混杂\", \"judgement\": \"some_concerns\", \"reason\": \"药物状态有条件控制，但刺激触点并非随机选择。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"参与者选择\", \"judgement\": \"high\", \"reason\": \"仅纳入已经发生可逆刺激相关恶化的病例。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"干预分类\", \"judgement\": \"unclear\", \"reason\": \"刺激条件定义明确，具体参数未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"偏离干预\", \"judgement\": \"unclear\", \"reason\": \"条件执行及依从性未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"缺失数据\", \"judgement\": \"some_concerns\", \"reason\": \"17人中仅12人完成完整评估，缺失原因不明。\", \"source_locator\": \"Abstract Results\"},\n              {\"domain\": \"结局测量\", \"judgement\": \"some_concerns\", \"reason\": \"使用临床量表，但评估者盲法未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析方案未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"high\"\n          },\n          \"limitations\": \"这是针对刺激诱发恶化病例的选择性队列，不能估计一般STN-DBS患者发生FOG恶化的风险。该研究没有记录STN神经活动，不能直接证明某种振荡机制。\",\n          \"quote\": \"The on-drug/on-worsening-DBS condition compared with the on-drug/off-DBS condition worsened\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:27766724\",\n        \"title\": \"Effect of high-frequency subthalamic neurostimulation on gait and freezing of gait in Parkinson's disease: a systematic review and meta-analysis.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"not_applicable\",\n        \"cohort_id_candidate\": null,\n        \"cohort_relation_basis\": \"系统综述纳入16项步态研究和6项FOG研究，不构成新的独立患者队列。摘要未提供纳入原始研究的PMID/DOI。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"27766724-E1\",\n          \"design\": \"系统综述及Meta分析；UPDRS gait item研究的汇总。\",\n          \"population\": \"16项研究提供UPDRS gait item数据；患者总数未在摘要报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要报告研究数量，不报告患者总数和事件级数据。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"UPDRS gait item所评估的临床步态障碍；具体FOG表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"Med-Off/Stim-On与baseline Med-Off。\",\n          \"DBS_state_and_parameters\": \"双侧STN-DBS；综述题目所述high-frequency stimulation；各原始研究具体频率未报告。\",\n          \"task\": \"UPDRS gait item临床评分。\",\n          \"recording_location\": \"未报告原始研究神经记录位置。\",\n          \"measure\": \"UPDRS gait item评分。\",\n          \"frequency_and_analysis_window\": \"6–15个月随访。\",\n          \"finding\": \"Med-Off/Stim-On相较baseline Med-Off，步态评分由2.43降至0.96，提示步态改善。\",\n          \"effect_estimate\": \"2.43→0.96；摘要报告P<0.05，置信区间未报告。\",\n          \"statistical_unit_and_method\": \"研究层级Meta分析；具体合并模型未在摘要报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域；仅摘要初评。\",\n            \"domains\": [\n              {\"domain\": \"方案及注册\", \"judgement\": \"not_assessable\", \"reason\": \"注册及方案未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"文献检索\", \"judgement\": \"unclear\", \"reason\": \"摘要提及Medline Ovid，但完整检索策略未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"筛选及提取\", \"judgement\": \"not_assessable\", \"reason\": \"双人筛选和提取流程未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"not_assessable\", \"reason\": \"原始研究质量评价未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"Meta分析及发表偏倚\", \"judgement\": \"not_assessable\", \"reason\": \"异质性和发表偏倚检验细节未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"该结果是临床UPDRS步态项目评分，不是事件级FOG记录。摘要没有给出患者总数和原始研究效应分布。\",\n          \"quote\": \"STN-DBS significantly improved gait on average from 2.43 to 0.96\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"27766724-E2\",\n          \"design\": \"系统综述及Meta分析。\",\n          \"population\": \"16项提供UPDRS gait item数据的研究；患者总数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告患者总数。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"临床步态障碍；具体表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"Med-Off/Stim-On与baseline Med-Off。\",\n          \"DBS_state_and_parameters\": \"双侧STN-DBS；刺激频率在纳入研究间未逐项报告。\",\n          \"task\": \"UPDRS gait item评分。\",\n          \"recording_location\": \"未报告。\",\n          \"measure\": \"UPDRS gait item评分。\",\n          \"frequency_and_analysis_window\": \"24–48个月随访。\",\n          \"finding\": \"Med-Off/Stim-On相较baseline Med-Off，步态评分由2.53降至1.31。\",\n          \"effect_estimate\": \"2.53→1.31；P<0.05。\",\n          \"statistical_unit_and_method\": \"研究层级Meta分析；具体模型未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域；仅摘要初评。\",\n            \"domains\": [\n              {\"domain\": \"方案及注册\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"文献检索\", \"judgement\": \"unclear\", \"reason\": \"完整检索策略未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"筛选及提取\", \"judgement\": \"not_assessable\", \"reason\": \"流程未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"Meta分析及发表偏倚\", \"judgement\": \"not_assessable\", \"reason\": \"具体分析方法未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"不能从临床量表平均变化推断具体冻结事件的变化。\",\n          \"quote\": \"from 2.53 to 1.31\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"27766724-E3\",\n          \"design\": \"系统综述及Meta分析。\",\n          \"population\": \"16项提供UPDRS gait item数据的研究；患者总数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告患者总数。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"临床步态障碍；具体表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"Med-Off/Stim-On与baseline Med-Off。\",\n          \"DBS_state_and_parameters\": \"双侧STN-DBS；原始研究刺激参数未报告。\",\n          \"task\": \"UPDRS gait item评分。\",\n          \"recording_location\": \"未报告。\",\n          \"measure\": \"UPDRS gait item评分。\",\n          \"frequency_and_analysis_window\": \">48个月随访。\",\n          \"finding\": \"Med-Off/Stim-On相较baseline Med-Off，步态评分由2.56降至1.40。\",\n          \"effect_estimate\": \"2.56→1.40；P<0.05。\",\n          \"statistical_unit_and_method\": \"研究层级Meta分析。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域；仅摘要初评。\",\n            \"domains\": [\n              {\"domain\": \"方案及注册\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"文献检索\", \"judgement\": \"unclear\", \"reason\": \"完整策略未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"筛选及提取\", \"judgement\": \"not_assessable\", \"reason\": \"流程未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"Meta分析及发表偏倚\", \"judgement\": \"not_assessable\", \"reason\": \"分析细节未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"属于长期临床步态评分汇总，不等同于事件级冻结频率。\",\n          \"quote\": \"from 2.56 to 1.40\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"27766724-E4\",\n          \"design\": \"系统综述及Meta分析。\",\n          \"population\": \"6项提供UPDRS FOG item数据的研究；患者总数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要仅报告研究数量，未报告FOG患者分母。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"UPDRS item 14所评估的临床FOG；具体冻结表型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"Med-Off/Stim-On与Med-On/Stim-On分别分析。\",\n          \"DBS_state_and_parameters\": \"双侧STN-DBS；原始刺激参数未逐项报告。\",\n          \"task\": \"UPDRS item 14 FOG临床评分。\",\n          \"recording_location\": \"未报告。\",\n          \"measure\": \"FOG临床评分。\",\n          \"frequency_and_analysis_window\": \"长期随访；摘要指出Med-Off/Stim-On下超过4年仍有获益。\",\n          \"finding\": \"综述认为STN-DBS在Med-Off/Stim-On条件下对FOG的改善可持续超过4年，而Med-On状态未发现明确获益。\",\n          \"effect_estimate\": \"FOG长期效应量及置信区间未报告。\",\n          \"statistical_unit_and_method\": \"Meta分析；具体FOG合并效应未在摘要给出。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域；仅摘要初评。\",\n            \"domains\": [\n              {\"domain\": \"方案及注册\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"文献检索\", \"judgement\": \"unclear\", \"reason\": \"完整策略未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"筛选及提取\", \"judgement\": \"not_assessable\", \"reason\": \"流程未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"原始研究偏倚风险\", \"judgement\": \"not_assessable\", \"reason\": \"未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"Meta分析及发表偏倚\", \"judgement\": \"not_assessable\", \"reason\": \"FOG分析细节未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"摘要没有给出FOG item的具体效应量；不能将步态item的数值直接替代FOG效应。\",\n          \"quote\": \"robust improvement of gait and FOG by STN-DBS for more than 4 years in the Med-Off/Stim-On condition.\",\n          \"source_locator\": {\"section\": \"Abstract Results and Conclusions\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:31494286\",\n        \"title\": \"Subthalamic nucleus oscillations correlate with vulnerability to freezing of gait in patients with Parkinson's disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"PMID:31494286\",\n        \"cohort_id_candidate\": \"cohort_candidate:PMID:31494286\",\n        \"cohort_relation_basis\": \"摘要未报告患者总数、中心、招募时间和电极设备细节，不能与其他STN步态LFP研究进行队列匹配。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"31494286-E1\",\n          \"design\": \"步行任务中的观察性STN-LFP研究；采用躯干加速度计算iFOG。\",\n          \"population\": \"PD患者；样本人数未在摘要报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告患者数、有效LFP人数、冻结事件数、步态试次数及电极触点数量。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"原文：FOG-vulnerable gait；iFOG由躯干加速度计算；不是摘要明确报告的临床确认实际冻结事件。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"记录STN区域LFP；DBS刺激是否开启及参数未报告。\",\n          \"task\": \"单任务自然步行（single-task gait, ST）。\",\n          \"recording_location\": \"STN区域LFP；theta活动的增加定位于ventral STN和/或SNr。\",\n          \"measure\": \"low-beta LFP power。\",\n          \"frequency_and_analysis_window\": \"low beta 15–21 Hz；iFOG定义的易冻结步态时期；具体时间窗未报告。\",\n          \"finding\": \"单任务步行中，FOG易感步态时期的low-beta功率高于正常步态时期；low-beta增加在STN区域呈分布性。\",\n          \"effect_estimate\": \"摘要未报告效应量及P值。\",\n          \"statistical_unit_and_method\": \"基于iFOG区分易冻结与正常步态；患者/步态周期层级统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性电生理/预测研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募框架及样本分母未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"some_concerns\", \"reason\": \"使用躯干加速度iFOG，但验证标准及阈值未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"LFP质量和运动伪迹处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物状态及临床因素控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"步态周期和患者内相关性处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"多个频段和STN位置的校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"unclear\", \"reason\": \"iFOG指标外部验证及预测性能未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预注册及预设分析方案未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"这是FOG易感步态与正常步态的关联，不是实际FOG事件前的时间锁定证据。iFOG属于客观加速度指标，摘要未报告其阈值或视频确认。\",\n          \"quote\": \"Greater LFP power in the low beta (15-21 Hz) and theta (5-8 Hz) bands were noted during periods of vulnerable gait\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"31494286-E2\",\n          \"design\": \"步行任务中的观察性STN-LFP研究。\",\n          \"population\": \"PD患者；样本人数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告患者、事件及试次数。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"原文：FOG-vulnerable gait。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"STN区域LFP；刺激状态未报告。\",\n          \"task\": \"单任务步行（ST）。\",\n          \"recording_location\": \"ventral STN and/or SNr区域。\",\n          \"measure\": \"theta-band LFP power。\",\n          \"frequency_and_analysis_window\": \"theta 5–8 Hz；易冻结步态时期；具体分析窗口未报告。\",\n          \"finding\": \"单任务步行中，易冻结步态时期theta活动增加，且增加具有局灶性，定位于ventral STN和/或SNr。\",\n          \"effect_estimate\": \"摘要未报告效应量及P值。\",\n          \"statistical_unit_and_method\": \"基于iFOG划分步态易感时期；具体统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性电生理/预测研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"some_concerns\", \"reason\": \"iFOG指标验证细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"LFP伪迹处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物和临床因素控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"患者及步态周期层级处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"频段及解剖区域多重比较未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"unclear\", \"reason\": \"预测模型验证未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析方案未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"摘要没有区分ventral STN与SNr的独立贡献，不能将结果全部归因于STN。\",\n          \"quote\": \"the increase in theta activity was focal and found in ventral STN and/or substantia nigra (SNr) in ST.\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"31494286-E3\",\n          \"design\": \"双任务步行中的观察性STN-LFP研究。\",\n          \"population\": \"PD患者；样本人数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告样本、试次及事件数量。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"原文：FOG-vulnerable gait。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"STN区域LFP；刺激状态未报告。\",\n          \"task\": \"双任务步行（dual-task gait, DT）。\",\n          \"recording_location\": \"STN区域。\",\n          \"measure\": \"low-beta LFP power。\",\n          \"frequency_and_analysis_window\": \"low beta 15–21 Hz；易冻结步态时期；具体时间窗未报告。\",\n          \"finding\": \"双任务步行中，FOG易感步态时期low-beta功率高于正常步态时期。\",\n          \"effect_estimate\": \"摘要未报告效应量及P值。\",\n          \"statistical_unit_and_method\": \"iFOG步态时期比较；统计单位和模型未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性电生理研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募流程未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"some_concerns\", \"reason\": \"iFOG阈值及外部验证未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"运动伪迹处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物和认知负荷等因素控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"患者内步态周期处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"频段校正策略未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"unclear\", \"reason\": \"iFOG模型验证细节未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析方案未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"不能将双任务下的易冻结步态直接等同于实际冻结事件。\",\n          \"quote\": \"Greater LFP power in the low beta (15-21 Hz) and theta (5-8 Hz) bands were noted during periods of vulnerable gait in both ST and DT states.\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"31494286-E4\",\n          \"design\": \"双任务步行中的观察性STN-LFP研究。\",\n          \"population\": \"PD患者；样本人数未报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告患者数、试次数及事件数。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"原文：FOG-vulnerable gait。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"STN区域LFP；刺激状态未报告。\",\n          \"task\": \"双任务步行（DT）。\",\n          \"recording_location\": \"STN区域；双任务下theta活动的具体空间分布未报告。\",\n          \"measure\": \"theta-band LFP power。\",\n          \"frequency_and_analysis_window\": \"theta 5–8 Hz；易冻结步态时期；具体窗口未报告。\",\n          \"finding\": \"双任务步行中，FOG易感步态时期theta功率增加。\",\n          \"effect_estimate\": \"摘要未报告独立效应量及P值。\",\n          \"statistical_unit_and_method\": \"iFOG步态时期比较；具体方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：观察性电生理研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"招募框架未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"some_concerns\", \"reason\": \"iFOG验证细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"伪迹处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"药物及任务相关混杂控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"步态周期层级分析未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"频段及任务比较校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"unclear\", \"reason\": \"模型验证未报告。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"摘要没有报告双任务theta信号的独立空间定位和效应量。\",\n          \"quote\": \"in both ST and DT states.\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:31665229\",\n        \"title\": \"Hitting the brakes: pathological subthalamic nucleus activity in Parkinson's disease gait freezing.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"PMID:31665229\",\n        \"cohort_id_candidate\": \"cohort_candidate:PMID:31665229\",\n        \"cohort_relation_basis\": \"摘要报告8名接受STN-DBS手术的患者，采用术中虚拟现实步态范式和微电极记录。未报告中心及招募时间，无法确认与其他研究队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"31665229-E1\",\n          \"design\": \"术中虚拟现实步态诱发实验，结合微电极和EMG记录。\",\n          \"population\": \"8名接受STN-DBS手术的PD患者。\",\n          \"n_enrolled\": 8,\n          \"n_analyzed\": 8,\n          \"n_patients_with_FOG\": 8,\n          \"n_patients_with_valid_neural_data\": 8,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告冻结事件数、实验试次数和微电极数量。\",\n          \"endpoint_class\": \"C_virtual_simulated\",\n          \"event_phase\": \"during_FOG\",\n          \"freezing_phenotype\": \"原文：freezing behaviour；伴随典型异常下肢肌肉放电；具体akinetic/trembling亚型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"术中药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"STN-DBS手术期间术中记录；治疗性刺激是否开启及参数未报告。\",\n          \"task\": \"经验证的虚拟现实步态范式，术中诱发freezing behaviour。\",\n          \"recording_location\": \"STN微电极记录。\",\n          \"measure\": \"STN multi-unit activity。\",\n          \"frequency_and_analysis_window\": \"多单位放电活动；冻结起始附近的实时分析；具体时间窗未报告。\",\n          \"finding\": \"冻结行为与STN病理性多单位活动的瞬时增加相关。\",\n          \"effect_estimate\": \"摘要未报告效应量及P值。\",\n          \"statistical_unit_and_method\": \"冻结起始实时分析；患者、事件及试次层级统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated：术中观察性电生理研究。\",\n            \"domains\": [\n              {\"domain\": \"样本选择\", \"judgement\": \"unclear\", \"reason\": \"术中患者筛选及连续纳入未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"行为标签有效性\", \"judgement\": \"some_concerns\", \"reason\": \"使用已验证虚拟现实范式，但本研究内冻结标签验证细节未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"信号质量与伪迹\", \"judgement\": \"unclear\", \"reason\": \"微电极及EMG伪迹控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"混杂\", \"judgement\": \"unclear\", \"reason\": \"麻醉、药物及术中状态控制未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"重复测量/伪重复\", \"judgement\": \"unclear\", \"reason\": \"事件及试次嵌套患者的统计处理未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"多重比较\", \"judgement\": \"unclear\", \"reason\": \"时间频率分析多重比较校正未报告。\", \"source_locator\": \"Abstract Methods\"},\n              {\"domain\": \"模型过拟合/外部验证\", \"judgement\": \"not_assessable\", \"reason\": \"未报告预测模型。\", \"source_locator\": \"Abstract\"},\n              {\"domain\": \"选择性报告\", \"judgement\": \"unclear\", \"reason\": \"预注册及预设分析未报告。\", \"source_locator\": \"Abstract\"}\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"虚拟现实诱发冻结属于模拟任务，不应直接等同于自然直立行走中的实际FOG。摘要没有报告冻结事件数量。\",\n          \"quote\": \"freezing is related to transient increases in pathological subthalamic nucleus activity.\",\n          \"source_locator\": {\"section\": \"Abstract Results\", \"page\": null, \"figure_table\": null, \"supplement\": null},\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"31665229-E2\",\n          \"design\": \"术中虚拟现实步态诱发实验及STN微电极时间频率分析。\",\n          \"population\": \"8名接受STN-DBS手术的PD患者。\",\n          \