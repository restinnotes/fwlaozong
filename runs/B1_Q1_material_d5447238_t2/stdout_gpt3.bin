"36242900\",\n      \"doi\": \"10.1016/j.parkreldis.2022.10.002\",\n      \"title\": \"Freezing of gait depends on cortico-subthalamic network recruitment following STN-DBS in PD patients\",\n      \"year\": 2022\n    },\n    {\n      \"ref\": \"R15\",\n      \"pmid\": \"37701817\",\n      \"doi\": \"10.1093/braincomms/fcad238\",\n      \"title\": \"Optimal subthalamic stimulation sites and related networks for freezing of gait in Parkinson's disease\",\n      \"year\": 2023\n    },\n    {\n      \"ref\": \"R16\",\n      \"pmid\": \"40709562\",\n      \"doi\": \"10.1002/ana.70003\",\n      \"title\": \"Subthalamic Electrophysiological Mapping of Gait Initiation Dynamics and Freezing in Parkinson's Disease\",\n      \"year\": 2025\n    },\n    {\n      \"ref\": \"R17\",\n      \"pmid\": \"39470410\",\n      \"doi\": \"10.1093/brain/awae223\",\n      \"title\": \"Supraspinal contributions to defective antagonistic inhibition and freezing of gait in Parkinson's disease\",\n      \"year\": 2024\n    },\n    {\n      \"ref\": \"R18\",\n      \"pmid\": \"41131028\",\n      \"doi\": \"10.1038/s41531-025-01173-y\",\n      \"title\": \"Neural signatures of turn-induced freezing of gait in Parkinson's disease: insights from phase-specific cortico-subthalamic dynamics\",\n      \"year\": 2025\n    },\n    {\n      \"ref\": \"R19\",\n      \"pmid\": \"42236313\",\n      \"doi\": \"10.1111/ejn.70570\",\n      \"title\": \"Cognitive and Emotional Determinants of Subthalamic Oscillations During Freezing While Turning in Parkinson's Disease\",\n      \"year\": 2026\n    },\n    {\n      \"ref\": \"R20\",\n      \"pmid\": \"39884164\",\n      \"doi\": \"10.1016/j.clinph.2025.01.005\",\n      \"title\": \"Alpha and high beta subthalamic intermittent activity correlates with freezing of gait severity in Parkinson's disease\",\n      \"year\": 2025\n    },\n    {\n      \"ref\": \"R21\",\n      \"pmid\": \"18420482\",\n      \"doi\": \"10.1212/01.wnl.0000303972.16279.46\",\n      \"title\": \"STN-DBS frequency effects on freezing of gait in advanced Parkinson disease\",\n      \"year\": 2008\n    },\n    {\n      \"ref\": \"R22\",\n      \"pmid\": \"24165197\",\n      \"doi\": \"10.1111/ner.12131\",\n      \"title\": \"60-Hz frequency effect on gait in Parkinson's disease with subthalamic nucleus deep brain stimulation\",\n      \"year\": 2014\n    },\n    {\n      \"ref\": \"R23\",\n      \"pmid\": \"24449169\",\n      \"doi\": \"10.1002/mds.25810\",\n      \"title\": \"Low-frequency subthalamic nucleus stimulation in Parkinson's disease: a randomized clinical trial\",\n      \"year\": 2014\n    },\n    {\n      \"ref\": \"R24\",\n      \"pmid\": \"25540305\",\n      \"doi\": \"10.1212/WNL.0000000000001184\",\n      \"title\": \"Low-frequency stimulation of STN-DBS reduces aspiration and freezing of gait in patients with PD\",\n      \"year\": 2015\n    },\n    {\n      \"ref\": \"R25\",\n      \"pmid\": \"29654112\",\n      \"doi\": \"10.1136/jnnp-2018-318060\",\n      \"title\": \"Long-term effect of low frequency stimulation of STN on dysphagia, freezing of gait and other motor symptoms in PD\",\n      \"year\": 2018\n    },\n    {\n      \"ref\": \"R26\",\n      \"pmid\": \"27766724\",\n      \"doi\": \"10.1111/ene.13167\",\n      \"title\": \"Effect of high-frequency subthalamic neurostimulation on gait and freezing of gait in Parkinson's disease\",\n      \"year\": 2017\n    },\n    {\n      \"ref\": \"R27\",\n      \"pmid\": \"34376190\",\n      \"doi\": \"10.1186/s12984-021-00921-4\",\n      \"title\": \"Low-frequency STN-DBS provides acute gait improvements in Parkinson's disease: a double-blinded randomised cross-over feasibility trial\",\n      \"year\": 2021\n    },\n    {\n      \"ref\": \"R28\",\n      \"pmid\": \"40504072\",\n      \"doi\": \"10.1002/mdc3.70170\",\n      \"title\": \"Differential Effects of Levodopa and Stimulation on Post-Surgery Freezing of Gait in Subthalamic Nucleus Deep Brain Stimulation Parkinson's Disease Patients: A Clinical and Kinematic Analysis\",\n      \"year\": 2025\n    },\n    {\n      \"ref\": \"R29\",\n      \"pmid\": \"38948151\",\n      \"doi\": \"10.1093/nsr/nwae187\",\n      \"title\": \"Variable frequency deep brain stimulation of subthalamic nucleus to improve freezing of gait in Parkinson's disease\",\n      \"year\": 2024\n    },\n    {\n      \"ref\": \"R30\",\n      \"pmid\": \"26887333\",\n      \"doi\": \"10.1002/mds.26545\",\n      \"title\": \"Subthalamic stimulation may inhibit the beneficial effects of levodopa on akinesia and gait\",\n      \"year\": 2016\n    },\n    {\n      \"ref\": \"R31\",\n      \"pmid\": \"40677701\",\n      \"doi\": \"10.1093/braincomms/fcaf266\",\n      \"title\": \"Beta burst-driven adaptive deep brain stimulation for gait impairment and freezing of gait in Parkinson's disease\",\n      \"year\": 2025\n    },\n    {\n      \"ref\": \"R32\",\n      \"pmid\": \"41480041\",\n      \"doi\": \"10.64898/2025.12.17.25342333\",\n      \"title\": \"Low-Frequency Adaptive Deep Brain Stimulation for Parkinson's Disease\",\n      \"year\": 2025\n    },\n    {\n      \"ref\": \"R33\",\n      \"pmid\": \"40640214\",\n      \"doi\": \"10.1038/s41531-025-01067-z\",\n      \"title\": \"Theta-frequency subthalamic stimulation enhances conflict resolution in Parkinson's disease patients with freezing of gait through frontal cortex modulation\",\n      \"year\": 2025\n    },\n    {\n      \"ref\": \"R34\",\n      \"pmid\": \"39957196\",\n      \"doi\": \"10.1177/1877718X241292315\",\n      \"title\": \"Subthalamic and nigral stimulation for freezing of gait in Parkinson's disease: Randomized pilot trial\",\n      \"year\": 2025\n    },\n    {\n      \"ref\": \"R35\",\n      \"pmid\": \"42571859\",\n      \"doi\": \"10.1016/j.nbd.2026.107571\",\n      \"title\": \"Gait-cycle-locked cortico-subthalamic signatures underlying freezing of gait and their modulation in Parkinson's disease\",\n      \"year\": 2026\n    },\n    {\n      \"ref\": \"R36\",\n      \"pmid\": \"42239677\",\n      \"doi\": \"10.3389/fneur.2026.1793291\",\n      \"title\": \"An initial machine learning model applied to local field potential data from the subthalamic nucleus to detect freezing of gait in Parkinson's disease\",\n      \"year\": 2026\n    },\n    {\n      \"ref\": \"R37\",\n      \"pmid\": \"\",\n      \"doi\": \"10.64898/2026.08.13.744293\",\n      \"title\": \"Reduced entropy of subthalamic beta bursts predicts freezing of gait in Parkinson's disease\",\n      \"year\": 2026\n    },\n    {\n      \"ref\": \"R38\",\n      \"pmid\": \"33240199\",\n      \"doi\": \"10.3389/fneur.2020.571086\",\n      \"title\": \"Neural Correlates of Freezing of Gait in Parkinson's Disease: An Electrophysiology Mini-Review\",\n      \"year\": 2020\n    },\n    {\n      \"ref\": \"R39\",\n      \"pmid\": \"36185822\",\n      \"doi\": \"10.3389/fnsys.2022.995375\",\n      \"title\": \"Abnormal neural oscillations during gait and dual-task in Parkinson's disease\",\n      \"year\": 2022\n    },\n    {\n      \"ref\": \"R40\",\n      \"pmid\": \"28529730\",\n      \"doi\": \"10.1186/s40035-017-0083-7\",\n      \"title\": \"Effect of low versus high frequency stimulation on freezing of gait and other axial symptoms in Parkinson patients with bilateral STN DBS: a mini-review\",\n      \"year\": 2017\n    },\n    {\n      \"ref\": \"R41\",\n      \"pmid\": \"\",\n      \"doi\": \"10.3389/fnhum.2024.1495272\",\n      \"title\": \"Beta-gamma phase-amplitude coupling of scalp electroencephalography during walking preparation in Parkinson's disease differs depending on the freezing of gait\",\n      \"year\": 2024\n    }\n  ],\n  \"evidence\": [\n    {\n      \"eid\": \"E1\",\n      \"ref\": \"R1\",\n      \"design\": \"横断面患者间LFP/EEG比较及左旋多巴干预\",\n      \"population\": \"PD，有FOG与无FOG\",\n      \"n\": \"22（FOG 14，非FOG 8）\",\n      \"condition\": \"静息及药物干预\",\n      \"measure\": \"STN低/高β功率、皮层-STN coherence\",\n      \"finding\": \"FOG患者高β功率较高，左旋多巴后下降并伴随FOG改善\",\n      \"limitations\": \"不能直接说明单次FOG onset的神经变化；样本量较小\"\n    },\n    {\n      \"eid\": \"E2\",\n      \"ref\": \"R2\",\n      \"design\": \"同步LFP与步态运动学观察研究\",\n      \"population\": \"PD Freezer与Non-freezer\",\n      \"n\": \"13（5与8）\",\n      \"condition\": \"行走及主动骑行\",\n      \"measure\": \"STN β功率及频谱峰\",\n      \"finding\": \"Freezer运动启动时存在约18Hz窄带异常；骑行更强地抑制总体β\",\n      \"limitations\": \"不能证明18Hz活动直接导致冻结\"\n    },\n    {\n      \"eid\": \"E3\",\n      \"ref\": \"R3\",\n      \"design\": \"自由行走LFP与非线性动力学分析\",\n      \"population\": \"PD Freezer与Non-freezer\",\n      \"n\": \"14（8名Freezer）\",\n      \"condition\": \"药物OFF、DBS OFF，正常行走和FOG\",\n      \"measure\": \"STN β/α功率、Sample Entropy\",\n      \"finding\": \"无冻结行走时Freezer平均β较低但β熵较高；FOG期间α熵升高\",\n      \"limitations\": \"熵指标不能直接解释因果；结果依赖任务和算法\"\n    },\n    {\n      \"eid\": \"E4\",\n      \"ref\": \"R4\",\n      \"design\": \"随机交叉DBS干预与步态LFP记录\",\n      \"population\": \"PD Freezer与Non-freezer\",\n      \"n\": \"12（8名Freezer）\",\n      \"condition\": \"药物OFF，DBS OFF、60Hz、140Hz\",\n      \"measure\": \"STN β burst duration及步态运动学\",\n      \"finding\": \"Freezer具有延长的运动相关β burst；DBS缩短病理性长burst并改善步态\",\n      \"limitations\": \"样本量小；burst阈值和任务范式影响结果\"\n    },\n    {\n      \"eid\": \"E5\",\n      \"ref\": \"R5\",\n      \"design\": \"单任务与双任务行走LFP观察研究\",\n      \"population\": \"PD患者\",\n      \"n\": \"15；仅少数在实验中出现真实FOG\",\n      \"condition\": \"单任务和双任务行走\",\n      \"measure\": \"STN低β、θ、iFOG\",\n      \"finding\": \"15-21Hz低β和5-8Hz θ与易感步态相关\",\n      \"limitations\": \"主要测量FOG易感性，而非实际冻结发作\"\n    },\n    {\n      \"eid\": \"E6\",\n      \"ref\": \"R6\",\n      \"design\": \"真实步行同步LFP、EEG、运动学和DAT影像\",\n      \"population\": \"PD患者\",\n      \"n\": \"7，其中5人发生FOG\",\n      \"condition\": \"真实行走、过门诱发冻结\",\n      \"measure\": \"STN功率、β burst、皮层-STN coherence\",\n      \"finding\": \"STN局部功率和burst无显著变化；冻结前及冻结期间低频皮层-STN解耦\",\n      \"limitations\": \"仅14次冻结；均为过门诱发；任务覆盖有限\"\n    },\n    {\n      \"eid\": \"E7\",\n      \"ref\": \"R7\",\n      \"design\": \"术中虚拟现实诱发FOG及微电极记录\",\n      \"population\": \"PD接受STN-DBS手术患者\",\n      \"n\": \"8\",\n      \"condition\": \"术中VR步态冻结\",\n      \"measure\": \"STN MUA、θ/β活动、下肢EMG\",\n      \"finding\": \"FOG onset伴随STN多单位活动及θ/β活动短暂增加，随后出现异常肌肉放电\",\n      \"limitations\": \"MUA不是慢性DBS LFP；术中VR范式；样本小\"\n    },\n    {\n      \"eid\": \"E8\",\n      \"ref\": \"R8\",\n      \"design\": \"步态冻结前后头皮EEG观察研究\",\n      \"population\": \"PD伴明显FOG患者\",\n      \"n\": \"24\",\n      \"condition\": \"药物OFF，TUG、行走与冻结\",\n      \"measure\": \"额叶/中央θ功率及跨区域耦合\",\n      \"finding\": \"冻结期间额叶和中央θ增加；步行向冻结转换时θ耦合增加\",\n      \"limitations\": \"头皮EEG不能直接定位STN\"\n    },\n    {\n      \"eid\": \"E9\",\n      \"ref\": \"R9\",\n      \"design\": \"同步ECoG、STN LFP和运动捕捉\",\n      \"population\": \"PD伴FOG患者\",\n      \"n\": \"8\",\n      \"condition\": \"TUG真实步行\",\n      \"measure\": \"STN β功率、ECoG、coherence、FOG分类\",\n      \"finding\": \"FOG期间STN β功率升高；频带特征分类高于机会水平\",\n      \"limitations\": \"21份冻结数据达到较好质量；coherence对照为shuffled surrogate\"\n    },\n    {\n      \"eid\": \"E10\",\n      \"ref\": \"R10\",\n      \"design\": \"自由步行ECoG、运动捕捉和STN-DBS干预\",\n      \"population\": \"PD接受STN-DBS患者\",\n      \"n\": \"16\",\n      \"condition\": \"刺激ON/OFF，单任务和双任务\",\n      \"measure\": \"M1 β-γ PAC、FOG持续时间\",\n      \"finding\": \"高β-γ PAC与冻结风险和严重度相关；DBS降低PAC并改善FOG\",\n      \"limitations\": \"PAC下降不能解释全部DBS获益；不能直接证明PAC为唯一介导机制\"\n    },\n    {\n      \"eid\": \"E11\",\n      \"ref\": \"R11\",\n      \"design\": \"神经机器人步态编码研究\",\n      \"population\": \"PD患者\",\n      \"n\": \"18\",\n      \"condition\": \"受控腿部运动及步态组成任务\",\n      \"measure\": \"STN神经活动、肌肉活动启动/终止/幅度\",\n      \"finding\": \"STN编码腿部肌肉活动及步行状态\",\n      \"limitations\": \"受控运动范式不等于自然行走FOG\"\n    },\n    {\n      \"eid\": \"E12\",\n      \"ref\": \"R12\",\n      \"design\": \"术中单单位和多单位记录\",\n      \"population\": \"中度PD患者\",\n      \"n\": \"12\",\n      \"condition\": \"仰卧踏步、启动/停止提示\",\n      \"measure\": \"STN和SN神经元放电、β振荡\",\n      \"finding\": \"STN偏向运动执行调节，SNr偏向注意相关调节；冻结样不规则期间STN β增加\",\n      \"limitations\": \"仰卧踏步，不是自然直立步行；冻结样不规则不能完全等同临床FOG\"\n    },\n    {\n      \"eid\": \"E13\",\n      \"ref\": \"R13\",\n      \"design\": \"肌电频谱观察及STN/SNr刺激干预\",\n      \"population\": \"PD Freezer及健康对照\",\n      \"n\": \"9名Freezer、16名健康对照\",\n      \"condition\": \"药物OFF，刺激OFF、STN-DBS、SNr-DBS\",\n      \"measure\": \"TA/GA α和低β EMG\",\n      \"finding\": \"Freezer正常步行和冻结期间均有低频异常肌肉活动；STN刺激降低该活动\",\n      \"limitations\": \"未同步记录STN LFP，不能证明LFP变化介导肌电改善\"\n    },\n    {\n      \"eid\": \"E14\",\n      \"ref\": \"R14\",\n      \"design\": \"术前术后电极位置、VTA及tractography研究\",\n      \"population\": \"PD接受STN-DBS患者\",\n      \"n\": \"19\",\n      \"condition\": \"术前与术后\",\n      \"measure\": \"FOG、步态、皮层-STN连接\",\n      \"finding\": \"感觉运动连接与FOG改善相关，前额叶连接与恶化相关\",\n      \"limitations\": \"小样本；连接组相关不能直接证明通路因果\"\n    },\n    {\n      \"eid\": \"E15\",\n      \"ref\": \"R15\",\n      \"design\": \"回顾性VTA和连接组研究\",\n      \"population\": \"双侧HFS-STN-DBS且有FOG患者\",\n      \"n\": \"76\",\n      \"condition\": \"术后临床随访\",\n      \"measure\": \"VTA、纤维束、FOG-Q\",\n      \"finding\": \"背外侧STN及SMA/pre-SMA通路与改善相关；腹内侧及前额叶通路与恶化相关\",\n      \"limitations\": \"回顾性选择；仅76/776符合影像和资料标准；功能连接模型未通过LOOCV\"\n    },\n    {\n      \"eid\": \"E16\",\n      \"ref\": \"R16\",\n      \"design\": \"分区LFP、动力学、运动学和药物干预\",\n      \"population\": \"PD患者及健康对照\",\n      \"n\": \"38名PD、24名健康对照\",\n      \"condition\": \"DOPA OFF/ON，步态启动和冻结\",\n      \"measure\": \"267个STN双极记录位置，低β、高β、步态pace/rhythm/balance\",\n      \"finding\": \"FOG易感与实际发生对应不同STN空间和频段关联；药物部分恢复异常关系\",\n      \"limitations\": \"实际观察到FOG者12人；多个dipole和步态周期须按患者层级统计\"\n    },\n    {\n      \"eid\": \"E17\",\n      \"ref\": \"R17\",\n      \"design\": \"STN LFP、EMG、运动学和主动停止对照\",\n      \"population\": \"PD患者\",\n      \"n\": \"12\",\n      \"condition\": \"正常行走、转弯、冻结\",\n      \"measure\": \"STN activation-deactivation、拮抗肌co-contraction、STN-EMG coherence\",\n      \"finding\": \"冻结前及冻结期间存在STN和下肢肌肉时序协调异常\",\n      \"limitations\": \"冻结事件数量有限；部分亚型为trembling-in-place\"\n    },\n    {\n      \"eid\": \"E18\",\n      \"ref\": \"R18\",\n      \"design\": \"同步M1/PMC ECoG、STN LFP和转弯运动学\",\n      \"population\": \"PD患者\",\n      \"n\": \"19\",\n      \"condition\": \"药物OFF/ON，正常转弯与转弯冻结\",\n      \"measure\": \"分阶段α功率、PMC-STN coherence\",\n      \"finding\": \"转弯冻结存在相位特异性皮层-STN动态异常\",\n      \"limitations\": \"任务特异性；不能直接推广到所有FOG触发情境\"\n    },\n    {\n      \"eid\": \"E19\",\n      \"ref\": \"R19\",\n      \"design\": \"LFP与认知/情绪量表的线性混合效应模型\",\n      \"population\": \"PD转弯冻结患者\",\n      \"n\": \"13\",\n      \"condition\": \"正常转弯与冻结转弯\",\n      \"measure\": \"STN θ、α、β功率，MoCA、HADS\",\n      \"finding\": \"冻结转弯期间θ与焦虑正相关、与MoCA负相关\",\n      \"limitations\": \"相关性研究；不能证明焦虑导致STN θ变化\"\n    },\n    {\n      \"eid\": \"E20\",\n      \"ref\": \"R20\",\n      \"design\": \"静息LFP频谱及burst分析\",\n      \"population\": \"PD患者\",\n      \"n\": \"23（FOG 14，非FOG 9）\",\n      \"condition\": \"静息\",\n      \"measure\": \"STN α、高β功率及间歇振荡\",\n      \"finding\": \"α burst和高β burst幅度与FOG严重度相关\",\n      \"limitations\": \"静息记录不能直接代表冻结发生时的活动\"\n    },\n    {\n      \"eid\": \"E21\",\n      \"ref\": \"R21\",\n      \"design\": \"随机双盲交叉刺激研究\",\n      \"population\": \"严重轴性症状及FOG的PD患者\",\n      \"n\": \"13\",\n      \"condition\": \"60Hz、130Hz、不同电压和等能量条件\",\n      \"measure\": \"SWS、FOG次数、UPDRS\",\n      \"finding\": \"60Hz高电压等能量条件改善冻结\",\n      \"limitations\": \"样本小；临床选择性人群；震颤控制可能下降\"\n    },\n    {\n      \"eid\": \"E22\",\n      \"ref\": \"R22\",\n      \"design\": \"随机盲法频率交叉研究\",\n      \"population\": \"双侧STN-DBS且有步态投诉的PD患者\",\n      \"n\": \"20\",\n      \"condition\": \"60Hz与130Hz，其他参数不变\",\n      \"measure\": \"步幅和步态指标\",\n      \"finding\": \"未发现60Hz在主要步幅终点上的优势\",\n      \"limitations\": \"TEED未匹配，冻结难以在实验中稳定诱发\"\n    },\n    {\n      \"eid\": \"E23\",\n      \"ref\": \"R23\",\n      \"design\": \"随机双盲前瞻性交叉研究\",\n      \"population\": \"双侧STN-DBS的PD患者\",\n      \"n\": \"14\",\n      \"condition\": \"60Hz和130Hz，各自优化接触点\",\n      \"measure\": \"UPDRS、轴性症状、步态\",\n      \"finding\": \"60Hz最佳接触点较腹侧，轴性症状改善较好\",\n      \"limitations\": \"不是专门的真实FOG事件诱发研究\"\n    },\n    {\n      \"eid\": \"E24\",\n      \"ref\": \"R24\",\n      \"design\": \"随机双盲刺激交叉研究\",\n      \"population\": \"常规130Hz下仍有FOG的PD患者\",\n      \"n\": \"7\",\n      \"condition\": \"药物ON，60Hz、130Hz、DBS OFF\",\n      \"measure\": \"FOG、吞咽造影、UPDRS\",\n      \"finding\": \"60Hz改善FOG和吞咽，误吸事件降低\",\n      \"limitations\": \"样本极小，疗效外推有限\"\n    },\n    {\n      \"eid\": \"E25\",\n      \"ref\": \"R25\",\n      \"design\": \"前瞻性随机序列双盲交叉随访\",\n      \"population\": \"药物难治性FOG的STN-DBS患者\",\n      \"n\": \"11，10人完成长期随访\",\n      \"condition\": \"60Hz和130Hz，平均14.5个月随访\",\n      \"measure\": \"FOG、SWS、吞咽和UPDRS\",\n      \"finding\": \"60Hz长期改善FOG，但总体获益随时间减弱\",\n      \"limitations\": \"样本小；长期效应可能受到疾病进展影响\"\n    },\n    {\n      \"eid\": \"E26\",\n      \"ref\": \"R26\",\n      \"design\": \"系统综述及Meta-analysis\",\n      \"population\": \"PD-STN-DBS研究\",\n      \"n\": \"16项步态研究，6项提供FOG评分\",\n      \"condition\": \"不同术后随访时段\",\n      \"measure\": \"步态和FOG临床评分\",\n      \"finding\": \"HFS对药物OFF状态步态和FOG有总体获益\",\n      \"limitations\": \"原始研究异质性；药物ON状态效果不稳定\"\n    },\n    {\n      \"eid\": \"E27\",\n      \"ref\": \"R27\",\n      \"design\": \"双盲随机交叉可行性研究\",\n      \"population\": \"双侧STN-DBS的PD患者\",\n      \"n\": \"14\",\n      \"condition\": \"药物OFF，低频与高频刺激\",\n      \"measure\": \"步态节律和加速度指标\",\n      \"finding\": \"低频改善部分躯干节律指标\",\n      \"limitations\": \"不等于证明FOG事件减少\"\n    },\n    {\n      \"eid\": \"E28\",\n      \"ref\": \"R28\",\n      \"design\": \"横断面五条件临床及IMU研究\",\n      \"population\": \"术后持续FOG患者\",\n      \"n\": \"17\",\n      \"condition\": \"药物ON/OFF、刺激ON/OFF、60Hz/130Hz\",\n      \"measure\": \"FOG次数、SWS、IMU、轴性评分\",\n      \"finding\": \"60Hz总体FOG次数不显著优于130Hz，但个体响应异质\",\n      \"limitations\": \"样本小；非盲法；不同患者的药物-刺激交互不同\"\n    },\n    {\n      \"eid\": \"E29\",\n      \"ref\": \"R29\",\n      \"design\": \"前瞻性VFS试点及纵向随访\",\n      \"population\": \"STN-DBS且有FOG的PD患者\",\n      \"n\": \"28\",\n      \"condition\": \"HFS、LFS、VFS及6/12个月\",\n      \"measure\": \"TUG、冻结次数、UPDRS\",\n      \"finding\": \"VFS在步态和冻结指标上优于单独HFS或LFS\",\n      \"limitations\": \"非随机；未维持TEED一致；随访无对照组\"\n    },\n    {\n      \"eid\": \"E30\",\n      \"ref\": \"R30\",\n      \"design\": \"刺激位置与可逆性步态恶化临床研究\",\n      \"population\": \"STN-DBS后步态/运动不能恶化患者\",\n      \"n\": \"17纳入，12完成\",\n      \"condition\": \"药物ON/OFF、刺激ON/OFF及不同接触点\",\n      \"measure\": \"SWS、FOG、步态和电极位置\",\n      \"finding\": \"部分背侧/前方刺激可逆性恶化步态并抑制左旋多巴获益\",\n      \"limitations\": \"选择性纳入刺激恶化患者；不能代表所有STN-DBS患者\"\n    },\n    {\n      \"eid\": \"E31\",\n      \"ref\": \"R31\",\n      \"design\": \"双盲实验室beta-burst驱动aDBS试点\",\n      \"population\": \"PD-STN-DBS患者\",\n      \"n\": \"7\",\n      \"condition\": \"DBS OFF、aDBS、cDBS、随机刺激\",\n      \"measure\": \"β burst duration、冻结时间、步态运动学\",\n      \"finding\": \"aDBS可行且安全，改善步态，效果与cDBS相近\",\n      \"limitations\": \"样本小；急性实验室研究；尚未证明优于优化cDBS\"\n    },\n    {\n      \"eid\": \"E32\",\n      \"ref\": \"R32\",\n      \"design\": \"60Hz beta-burst自适应刺激预印本\",\n      \"population\": \"双侧STN-DBS患者\",\n      \"n\": \"8\",\n      \"condition\": \"60Hz cDBS/aDBS与临床140Hz\",\n      \"measure\": \"β burst duration、FOG、UPDRS\",\n      \"finding\": \"60Hz缩短β burst，基线FOG患者步态改善\",\n      \"limitations\": \"预印本；样本小；尚未同行评审\"\n    },\n    {\n      \"eid\": \"E33\",\n      \"ref\": \"R33\",\n      \"design\": \"认知任务和刺激状态fMRI干预研究\",\n      \"population\": \"PD患者及健康对照\",\n      \"n\": \"90名PD（52名FOG）及37名健康对照；刺激fMRI子组18名FOG\",\n      \"condition\": \"冲突任务、5Hz与130Hz STN刺激\",\n      \"measure\": \"Flanker冲突解决、前额叶BOLD\",\n      \"finding\": \"5Hz改善冲突解决能力和额叶激活\",\n      \"limitations\": \"并非真实步行FOG疗效试验\"\n    },\n    {\n      \"eid\": \"E34\",\n      \"ref\": \"R34\",\n      \"design\": \"双盲随机交叉STN-SNr联合刺激试验\",\n      \"population\": \"药物/常规刺激难治性FOG患者\",\n      \"n\": \"15进入至少一种联合刺激条件\",\n      \"condition\": \"STN单独、STN+高频SNr、STN+低频SNr\",\n      \"measure\": \"NFOG-Q、运动并发症、患者偏好\",\n      \"finding\": \"主要FOG终点无显著差异，约三分之一患者临床改善\",\n      \"limitations\": \"样本小；不能证明联合刺激整体优于STN单靶点\"\n    },\n    {\n      \"eid\": \"E35\",\n      \"ref\": \"R35\",\n      \"design\": \"步态周期锁定皮层-STN同步记录和刺激调节\",\n      \"population\": \"PD-FOG患者\",\n      \"n\": \"摘要未报告\",\n      \"condition\": \"FOG与非FOG步态周期、HFS/LFS、左旋多巴\",\n      \"measure\": \"S1/SPL低β、S1-STN θ coherence\",\n      \"finding\": \"步态周期相位依赖神经特征与冻结易感有关\",\n      \"limitations\": \"样本量及独立重复情况仍需进一步核实\"\n    },\n    {\n      \"eid\": \"E36\",\n      \"ref\": \"R36\",\n      \"design\": \"STN-LFP机器学习冻结检测\",\n      \"population\": \"PD患者\",\n      \"n\": \"5\",\n      \"condition\": \"VR物理、焦虑和认知负荷诱发任务\",\n      \"measure\": \"LFP功率、alpha/beta burst、机器学习分类\",\n      \"finding\": \"成功检测29次冻结中的24次，平均加权F1为0.67\",\n      \"limitations\": \"极小样本；需要跨中心和日常环境外部验证\"\n    },\n    {\n      \"eid\": \"E37\",\n      \"ref\": \"R37\",\n      \"design\": \"STN beta burst时间结构预印本\",\n      \"population\": \"PD患者\",\n      \"n\": \"4\",\n      \"condition\": \"稳定行走、冻结前和冻结期间\",\n      \"measure\": \"inter-burst interval entropy、时间变异性\",\n      \"finding\": \"冻结前burst间隔熵下降，LOPO AUC约0.825\",\n      \"limitations\": \"预印本；仅4人；高度探索性\"\n    }\n  ],\n  \"claims\": [\n    {\n      \"cid\": \"C1\",\n      \"text\": \"STN β活动与FOG相关，但不存在统一适用于所有患者和行为阶段的β功率变化方向。\",\n      \"level\": \"synthesis\",\n      \"status\": \"well-supported\",\n      \"uncertainty\": \"不同任务、药物状态、运动阶段和信号指标会改变β结果。\",\n      \"evidence\": [\n        {\"eid\": \"E1\", \"relation\": \"supports\"},\n        {\"eid\": \"E2\", \"relation\": \"supports\"},\n        {\"eid\": \"E3\", \"relation\": \"qualifies\"},\n        {\"eid\": \"E4\", \"relation\": \"supports\"},\n        {\"eid\": \"E5\", \"relation\": \"supports\"},\n        {\"eid\": \"E6\", \"relation\": \"contradicts\"},\n        {\"eid\": \"E9\", \"relation\": \"supports\"}\n      ]\n    },\n    {\n      \"cid\": \"C2\",\n      \"text\": \"延长的STN β burst是FOG易感性和部分冻结过程的重要候选生物标志物。\",\n      \"level\": \"synthesis\",\n      \"status\": \"supported\",\n      \"uncertainty\": \"尚未证明长burst是所有FOG发作的必要条件或充分原因。\",\n      \"evidence\": [\n        {\"eid\": \"E3\", \"relation\": \"qualifies\"},\n        {\"eid\": \"E4\", \"relation\": \"supports\"},\n        {\"eid\": \"E31\", \"relation\": \"supports\"},\n        {\"eid\": \"E37\", \"relation\": \"qualifies\"}\n      ]\n    },\n    {\n      \"cid\": \"C3\",\n      \"text\": \"FOG可以伴随低频皮层-STN耦合中断，而不一定伴随STN局部β功率显著改变。\",\n      \"level\": \"finding\",\n      \"status\": \"supported\",\n      \"uncertainty\": \"直接人体证据主要来自小样本真实步行研究，仍需独立重复。\",\n      \"evidence\": [\n        {\"eid\": \"E6\", \"relation\": \"supports\"},\n        {\"eid\": \"E9\", \"relation\": \"qualifies\"},\n        {\"eid\": \"E18\", \"relation\": \"supports\"}\n      ]\n    },\n    {\n      \"cid\": \"C4\",\n      \"text\": \"FOG易感状态、冻结前状态和冻结发生状态具有不同的STN神经活动模式。\",\n      \"level\": \"synthesis\",\n      \"status\": \"supported\",\n      \"uncertainty\": \"不同任务范式和FOG亚型仍可能改变具体神经特征。\",\n      \"evidence\": [\n        {\"eid\": \"E5\", \"relation\": \"supports\"},\n        {\"eid\": \"E6\", \"relation\": \"supports\"},\n        {\"eid\": \"E16\", \"relation\": \"supports\"},\n        {\"eid\": \"E18\", \"relation\": \"supports\"}\n      ]\n    },\n    {\n      \"cid\": \"C5\",\n      \"text\": \"STN后部感觉运动区和中央联合区与步态速度、节律和平衡之间存在不同的频段及空间关联。\",\n      \"level\": \"finding\",\n      \"status\": \"supported\",\n      \"uncertainty\": \"功能分区依赖个体解剖配准，不能直接等同于刺激最佳靶点。\",\n      \"evidence\": [\n        {\"eid\": \"E16\", \"relation\": \"supports\"},\n        {\"eid\": \"E15\", \"relation\": \"qualifies\"}\n      ]\n    },\n    {\n      \"cid\": \"C6\",\n      \"text\": \"STN活动异常与拮抗肌协调和下肢运动输出失调有关。\",\n      \"level\": \"synthesis\",\n      \"status\": \"supported\",\n      \"uncertainty\": \"现有研究尚未充分证明STN LFP异常是肌肉异常的直接原因。\",\n      \"evidence\": [\n        {\"eid\": \"E7\", \"relation\": \"supports\"},\n        {\"eid\": \"E12\", \"relation\": \"supports\"},\n        {\"eid\": \"E13\", \"relation\": \"supports\"},\n        {\"eid\": \"E17\", \"relation\": \"supports\"}\n      ]\n    },\n    {\n      \"cid\": \"C7\",\n      \"text\": \"认知和情绪因素能够调节STN低频活动及FOG相关行为。\",\n      \"level\": \"synthesis\",\n      \"status\": \"supported\",\n      \"uncertainty\": \"认知、焦虑与神经活动的方向依赖任务和行为阶段，尚未建立统一因果链。\",\n      \"evidence\": [\n        {\"eid\": \"E5\", \"relation\": \"supports\"},\n        {\"eid\": \"E19\", \"relation\": \"supports\"},\n        {\"eid\": \"E33\", \"relation\": \"supports\"}\n      ]\n    },\n    {\n      \"cid\": \"C8\",\n      \"text\": \"STN-DBS的FOG疗效受到刺激位置、纤维通路、药物状态和患者表型影响。\",\n      \"level\": \"synthesis\",\n      \"status\": \"well-supported\",\n      \"uncertainty\": \"个体化刺激预测仍需要前瞻性外部验证。\",\n      \"evidence\": [\n        {\"eid\": \"E14\", \"relation\": \"supports\"},\n        {\"eid\": \"E15\", \"relation\": \"supports\"},\n        {\"eid\": \"E28\", \"relation\": \"supports\"},\n        {\"eid\": \"E30\", \"relation\": \"supports\"}\n      ]\n    },\n    {\n      \"cid\": \"C9\",\n      \"text\": \"60Hz低频STN刺激能够改善部分患者的FOG，但不普遍优于130Hz。\",\n      \"level\": \"synthesis\",\n      \"status\": \"well-supported\",\n      \"uncertainty\": \"TEED、接触点、任务诱发和患者筛选导致研究异质性。\",\n      \"evidence\": [\n        {\"eid\": \"E21\", \"relation\": \"supports\"},\n        {\"eid\": \"E22\", \"relation\": \"contradicts\"},\n        {\"eid\": \"E23\", \"relation\": \"supports\"},\n        {\"eid\": \"E24\", \"relation\": \"supports\"},\n        {\"eid\": \"E25\", \"relation\": \"supports\"},\n        {\"eid\": \"E28\", \"relation\": \"qualifies\"}\n      ]\n    },\n    {\n      \"cid\": \"C10\",\n      \"text\": \"β burst驱动的aDBS具有初步可行性，但尚未证明优于优化后的连续DBS。\",\n      \"level\": \"finding\",\n      \"status\": \"supported\",\n      \"uncertainty\": \"样本量小，缺少长期家庭环境随机对照试验。\",\n      \"evidence\": [\n        {\"eid\": \"E31\", \"relation\": \"supports\"},\n        {\"eid\": \"E32\", \"relation\": \"qualifies\"}\n      ]\n    },\n    {\n      \"cid\": \"C11\",\n      \"text\": \"STN-SNr联合刺激可能使部分难治性FOG患者获益，但整体额外疗效尚未确立。\",\n      \"level\": \"synthesis\",\n      \"status\": \"contested\",\n      \"uncertainty\": \"响应者可能具有不同疾病病程和运动认知表型。\",\n      \"evidence\": [\n        {\"eid\": \"E12\", \"relation\": \"supports\"},\n        {\"eid\": \"E13\", \"relation\": \"qualifies\"},\n        {\"eid\": \"E34\", \"relation\": \"qualifies\"}\n      ]\n    },\n    {\n      \"cid\": \"C12\",\n      \"text\": \"STN神经活动时间结构、熵和步态相位指标可能提供超越平均功率的FOG预测信息。\",\n      \"level\": \"mechanism\",\n      \"status\": \"speculative\",\n      \"uncertainty\": \"不同熵指标并不等价，尚缺乏统一定义和外部验证。\",\n      \"evidence\": [\n        {\"eid\": \"E3\", \"relation\": \"supports\"},\n        {\"eid\": \"E35\", \"relation\": \"supports\"},\n        {\"eid\": \"E37\", \"relation\": \"supports\"}\n      ]\n    },\n    {\n      \"cid\": \"C13\",\n      \"text\": \"STN局部β活动增强是所有FOG的必要且充分原因。\",\n      \"level\": \"mechanism\",\n      \"status\": \"weak\",\n      \"uncertainty\": \"存在真实FOG期间STN局部功率无显著变化的研究，也存在不同频段和网络异常。\",\n      \"evidence\": [\n        {\"eid\": \"E4\", \"relation\": \"qualifies\"},\n        {\"eid\": \"E6\", \"relation\": \"contradicts\"},\n        {\"eid\": \"E16\", \"relation\": \"qualifies\"}\n      ]\n    }\n  ],\n  \"hypotheses\": [\n    {\n      \"hid\": \"H1\",\n      \"name\": \"STN病理性β burst驱动模型\",\n      \"text\": \"延长的STN β burst限制运动相关信息处理和步态执行灵活性，促使系统进入冻结状态。\",\n      \"claims\": [\n        {\"cid\": \"C1\", \"relation\": \"supports\"},\n        {\"cid\": \"C2\", \"relation\": \"supports\"},\n        {\"cid\": \"C13\", \"relation\": \"contradicts\"}\n      ],\n      \"predictions\": [\n        \"个体内长β burst应在FOG onset之前增加。\",\n        \"β burst duration比平均β功率具有更稳定的冻结预测能力。\",\n        \"选择性缩短病理性长burst应降低冻结风险。\",\n        \"保留正常短burst比全面抑制β更有利于步态。\"\n      ],\n      \"falsifiers\": [\n        \"独立队列中长β burst不预测FOG。\",\n        \"充分控制伪迹和行为阶段后长burst与FOG无关。\",\n        \"选择性改变burst duration不改变冻结风险。\"\n      ]\n    },\n    {\n      \"hid\": \"H2\",\n      \"name\": \"皮层-STN网络协调失败模型\",\n      \"text\": \"FOG主要由SMA、M1、PMC与STN之间的动态协调和信息传递失败造成，而非STN局部功率单独升高。\",\n      \"claims\": [\n        {\"cid\": \"C3\", \"relation\": \"supports\"},\n        {\"cid\": \"C4\", \"relation\": \"supports\"},\n        {\"cid\": \"C13\", \"relation\": \"supports\"}\n      ],\n      \"predictions\": [\n        \"低频皮层-STN耦合变化先于部分FOG事件。\",\n        \"网络时序指标比局部平均功率具有更高的跨任务预测价值。\",\n        \"恢复异常耦合时序能够改善步态控制。\"\n      ],\n      \"falsifiers\": [\n        \"独立队列中网络耦合不提供局部LFP之外的预测价值。\",\n        \"选择性改变网络耦合不影响冻结风险。\"\n      ]\n    },\n    {\n      \"hid\": \"H3\",\n      \"name\": \"认知-情绪资源竞争模型\",\n      \"text\": \"FOG易感患者的步态自动化能力下降，认知负荷、焦虑和环境复杂度超过可用控制资源后导致步态冻结。\",\n      \"claims\": [\n        {\"cid\": \"C7\", \"relation\": \"supports\"},\n        {\"cid\": \"C4\", \"relation\": \"supports\"}\n      ],\n      \"predictions\": [\n        \"双任务和焦虑负荷能够改变STN θ活动及联合区参与。\",\n        \"认知控制改善可能降低认知诱发FOG风险。\",\n        \"不同认知和情绪触发的FOG具有不同神经特征。\"\n      ],\n      \"falsifiers\": [\n        \"控制认知负荷和焦虑后，相关神经活动不能预测FOG。\",\n        \"针对认知控制的干预不改变认知诱发冻结。\"\n      ]\n    },\n    {\n      \"hid\": \"H4\",\n      \"name\": \"步态相位与神经动力学状态转换模型\",\n      \"text\": \"FOG是步态周期内神经活动时序、相位和复杂度组织失常所导致的非线性状态转换。\",\n      \"claims\": [\n        {\"cid\": \"C4\", \"relation\": \"supports\"},\n        {\"cid\": \"C12\", \"relation\": \"supports\"}\n      ],\n      \"predictions\": [\n        \"步态相位锁定指标优于整段频谱平均功率。\",\n        \"冻结前存在可重复的神经状态转换轨迹。\",\n        \"burst时间间隔熵和相位稳定性能够预测冻结风险。\"\n      ],\n      \"falsifiers\": [\n        \"独立患者和任务中步态相位指标不能提供增量预测价值。\",\n        \"神经状态转换特征不能稳定重复。\"\n      ]\n    },\n    {\n      \"hid\": \"H5\",\n      \"name\": \"解剖-网络选择性刺激模型\",\n      \"text\": \"STN-DBS的FOG疗效取决于刺激募集的功能亚区和连接纤维通路，而不只是频率或总能量。\",\n      \"claims\": [\n        {\"cid\": \"C5\", \"relation\": \"supports\"},\n        {\"cid\": \"C8\", \"relation\": \"supports\"},\n        {\"cid\": \"C9\", \"relation\": \"supports\"},\n        {\"cid\": \"C11\", \"relation\": \"qualifies\"}\n      ],\n      \"predictions\": [\n        \"个体化VTA和纤维连接能够预测刺激响应。\",\n        \"选择性募集感觉运动相关通路可减少FOG恶化。\",\n        \"不同患者的最佳刺激网络存在差异。\"\n      ],\n      \"falsifiers\": [\n        \"前瞻性多中心试验中个体化VTA不能预测FOG疗效。\",\n        \"控制刺激参数后纤维通路与临床响应无稳定关联。\"\n      ]\n    }\n  ]\n}\n```\n\n---\n\n## 第三部分：研究者使用建议\n\n本报告中的证据最适合支持以下三个后续项目：\n\n1. **STN β burst 与 FOG 的因果关系研究**：重点不是重复测量平均 β 功率，而是比较 burst duration、burst timing、相位和选择性刺激效果。\n2. **皮层-STN 网络状态转换研究**：重点比较真实 FOG onset 前的 θ–α coupling、M1 PAC 和 STN 空间分区。\n3. **个体化闭环 DBS 研究**：将 LFP、EMG、IMU、药物状态及个体化 VTA 结合，区分不同患者的冻结机制。\n\n需要保留的研究原则是：\n\n**原始数据、统计发现、跨研究综合、机制解释和待检验假说必须始终分开。**\n\n尤其不能因为一个机制可以解释多篇论文，就把它当成已经被实验验证的统一病理机制。\n\n本报告已将可核实的主要研究、证据、结论和竞争性假说整理为可持续更新的结构化资料。对于新发表的独立队列、随机对照试验和选择性神经干预，应优先更新相关 Evidence，再重新评估 Claims 和 Hypotheses，而不是直接覆盖旧结论。\n\n【完成】", "metadata": {"session_handle": "a7222e59-438c-41e2-8861-906a1addd798", "session_revision": 2, "session_ttl_max_hours": 6, "job_directory": "D:\\musicclaude\\gpt2agent-safechain\\runs\\gpt3\\pro-bridge-20261113T094315668465Z", "elapsed_seconds": 958.547, "completed_utc": "2026-11-13T09:59:14.212211+00:00", "model": "gpt-6-thinking", "thinking_effort": "max", "temporary": true, "unpersonalized": true, "generation_policy_verified": true, "request_policy": {"model": "gpt-6-thinking", "thinking_effort": "max", "history_and_training_disabled": true, "temporary_chat_requests_personalization": null, "is_do_not_remember": false, "continuation": true, "unpersonalized_inherited_verified": true, "body_sha256": "2b54953d9d8e5a5c98e1df71fd975b52245165f8143399a912e1437e3953e73b", "attachment_count": 0}, "stream_completion": {"sse_done": true, "message_completed": true, "independent_terminal_verified": true}, "profile": "yi/local-codex-auth", "account_sha256": "b3efb6361563c139233ed7b7ef61a7c9afe0bd48d4eb3525dbe31956b024d6da", "transport": "probridge-pure-http", "resume_requests": 0, "topic_connections": 0, "browser_started": false, "Docker_used": false, "automatic_retry": false, "initializer_pss_limit_mib": "not_applicable_no_browser", "attachment_count": 0, "code_sha256": {"tools\\chatgpt_web\\gpt3_cli.py": "96a4cdb6cd5d982f4d1de5b6ba8fae0cf23ee44aa3e41d7fdf6968e3fb590e48", "tools\\chatgpt_web\\gpt3_sessions.py": "83a3ed4ae1efa9f1a2b8ee3f144cc0dc9f668f995a33cc4222308cb3fa31f683", "tools\\chatgpt_web\\gpt3_attachments.py": "eedfa23885000025700f6306b1d1f4582896a7370734be506c156dee532fd7d7"}}, "screenshot_evidence": {"complete": true, "kind": "offline_actual_HTTP_response", "directory": "D:\\musicclaude\\gpt2agent-safechain\\runs\\gpt3\\pro-bridge-20261113T094315668465Z", "files": ["proof-offline.png"], "sha256": {"proof-offline.png": "30421d43ce5fe50b2b82b3b310ad496bc83945de99169378e82ff91fba049114"}}}
