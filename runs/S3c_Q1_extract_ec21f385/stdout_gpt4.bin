{"completed": true, "response": "<escape>{\n  \"papers\": [\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42301334\",\n        \"title\": \"The Noradrenergic Brain in Parkinson's Disease.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"综述摘要未列出具体原始研究PMID/DOI、患者队列或招募中心，不能建立原始研究间的队列关系。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"PMID42301334_E1\",\n          \"design\": \"关于帕金森病去甲肾上腺素系统的综述；摘要未提供具体检索方法、纳入研究数量或定量合并分析。\",\n          \"population\": \"综述涉及帕金森病患者的神经影像研究；原始研究患者数量及具体特征未在摘要报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未提及原始研究的独立样本分母、FOG患者数、事件数及电极数；摘要没有列出具体原始研究PMID/DOI。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"unclear\",\n          \"freezing_phenotype\": \"not_reported；综述仅提及freezing of gait，未区分akinetic、trembling-in-place等表现。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"unknown；摘要未报告相关FOG神经影像研究的药物测试状态。\",\n          \"DBS_state_and_parameters\": \"摘要未报告STN-DBS记录或刺激参数。\",\n          \"task\": \"未报告FOG对应的具体步行任务、冻结诱发条件或事件级分析。\",\n          \"recording_location\": \"综述涉及locus coeruleus（LC）及皮层、皮层下去甲肾上腺素系统；摘要未报告STN神经活动记录。\",\n          \"measure\": \"综述总结LC neuromelanin MRI信号降低及PET显示的去甲肾上腺素能去神经支配，并指出去甲肾上腺素功能障碍与FOG等短暂运动表现有关。\",\n          \"frequency_and_analysis_window\": \"不适用；摘要未报告STN电生理频段、时间窗或神经振荡分析。\",\n          \"finding\": \"综述指出去甲肾上腺素功能障碍参与PD的短暂运动表现，包括震颤和FOG。该结论属于综述性总结，不包含STN神经活动与FOG事件之间的直接比较。\",\n          \"effect_estimate\": \"未报告FOG特异性效应量、置信区间或P值。\",\n          \"statistical_unit_and_method\": \"二次文献综合；原始研究统计单位、统计方法及患者级效应无法从摘要恢复。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS；仅依据摘要进行初步判断，不能完成正式评价。\",\n            \"domains\": [\n              {\n                \"domain\": \"文献检索策略及覆盖完整性\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未提供数据库、检索式、检索时间及文献覆盖范围。\",\n                \"source_locator\": \"Abstract；Methods未提供可核查信息。\"\n              },\n              {\n                \"domain\": \"研究筛选与数据提取\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未报告研究筛选流程、独立提取人数或排除理由。\",\n                \"source_locator\": \"Abstract。\"\n              },\n              {\n                \"domain\": \"纳入原始研究的偏倚风险评价\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未报告原始研究偏倚风险评价方法。\",\n                \"source_locator\": \"Abstract。\"\n              },\n              {\n                \"domain\": \"证据综合及选择性报告\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要没有提供原始研究清单、定量综合方法或发表偏倚评价。\",\n                \"source_locator\": \"Abstract。\"\n              }\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"这是secondary source，不能作为新的独立患者队列或独立重复验证。摘要没有明确指出支持FOG结论的原始研究PMID/DOI，不能据此追溯具体患者、电生理指标或STN机制。\",\n          \"quote\": \"noradrenergic dysfunction, is also involved in transient motor manifestations such as tremor and freezing of gait.\",\n          \"source_locator\": {\n            \"section\": \"Abstract - Recent findings\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42310513\",\n        \"title\": \"Experiences of Anxiety and Its Relationship to Freezing of Gait in Parkinson's Disease: A Qualitative Study.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告12名参与者，但未提供可与其他给定论文匹配的中心、招募时间或队列重叠信息。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42310670\",\n        \"title\": \"Real-world gait study of Parkinson's disease using wearable sensors: a systematic review.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"系统综述纳入63项研究；摘要未提供具体研究清单和原始研究PMID/DOI，不能建立队列去重关系。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42310830\",\n        \"title\": \"Tackling Anxiety- and Stress-Related Freezing of Gait in People With Parkinson's Disease (TACKLING-FOG): Study Protocol for a Randomized Controlled Trial.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"NCT06302309\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要描述计划招募40名参与者及随机分组，但未提供实际入组或完成试验的患者数据；不能与其他论文建立实际队列重叠关系。\",\n        \"source_type\": \"unclear\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42397913\",\n        \"title\": \"Distinct contributions of two subpopulations of subthalamic neurons to levodopa-induced dyskinesia.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"动物实验摘要未报告动物品系、数量、实验批次或其他论文的重叠实验信息。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"PMID42397913_E1\",\n          \"design\": \"帕金森病小鼠模型中的投射特异性神经元功能操控实验，研究STN不同投射亚群与左旋多巴诱导异动症（LID）的关系。\",\n          \"population\": \"LID小鼠模型；摘要未报告动物品系、性别、年龄及动物数量。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未提及动物数量、各实验组分母、神经记录样本数及具体实验次数；FOG不是该研究报告的结局。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"not_reported；研究结局为LID和hypokinesia，未报告FOG。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"研究涉及levodopa及LID小鼠模型；摘要未报告剂量、给药时间及具体实验药物状态。\",\n          \"DBS_state_and_parameters\": \"未报告DBS实验。研究采用对STN投射特异性神经元的激活操控。\",\n          \"task\": \"LID小鼠模型中的运动表型评估及投射特异性神经元激活；未报告步行冻结诱发任务。\",\n          \"recording_location\": \"STN内投射至entopeduncular nucleus（EP）和tegmental reticular nucleus（RtTg）的不同神经元亚群。\",\n          \"measure\": \"投射特异性STN神经元活动模式及激活操控对异动症、运动低下的影响。EP投射神经元表现为U-shaped activation pattern；RtTg投射神经元表现为以抑制性反应为主。\",\n          \"frequency_and_analysis_window\": \"摘要未报告振荡频段、神经活动时间窗或功率分析。\",\n          \"finding\": \"EP投射STN神经元激活可缓解异动症，但加重帕金森状态下的运动低下。RtTg投射STN神经元单独激活未诱导明显高动力运动特征，联合levodopa时出现不同反应。摘要没有报告FOG测量或冻结事件。\",\n          \"effect_estimate\": \"报告方向性效应；摘要未提供效应量、置信区间或具体P值。\",\n          \"statistical_unit_and_method\": \"动物实验；具体动物级、细胞级或试次级统计单位及统计方法未在摘要报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"SYRCLE相关域的摘要级初步评价；未进行正式偏倚风险评估。\",\n            \"domains\": [\n              {\n                \"domain\": \"动物分组随机化\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未说明动物分组是否随机。\",\n                \"source_locator\": \"Abstract - Here, we investigated the functional roles。\"\n              },\n              {\n                \"domain\": \"实验实施及结局评价盲法\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未报告操作者或行为结局评价者是否盲法。\",\n                \"source_locator\": \"Abstract - Results。\"\n              },\n              {\n                \"domain\": \"样本排除及缺失数据\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未报告动物排除、实验失败或缺失数据。\",\n                \"source_locator\": \"Abstract。\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未提供预先设定的实验方案或完整结局列表。\",\n                \"source_locator\": \"Abstract。\"\n              }\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"该研究直接涉及STN神经元亚群，但研究对象是小鼠LID和hypokinesia，而不是FOG。不能将运动低下或异动症结果解释为冻结步态证据，也不能推断其对人类STN-FOG关系的支持。\",\n          \"quote\": \"Activation of EP-projecting STN neurons alleviated dyskinesia but worsened hypokinesia in the parkinsonian state.\",\n          \"source_locator\": {\n            \"section\": \"Abstract - Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42400317\",\n        \"title\": \"Topography of Regional Cerebral GABA<sub>A</sub> Receptor Availability in Parkinson's Disease Patients With Freezing of Gait.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告33名PD患者，但未提供研究中心、招募时间或可用于匹配其他论文的队列标识。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"PMID42400317_E1\",\n          \"design\": \"观察性横断面神经影像研究；使用[11C]-flumazenil PET和MRI比较PD患者中freezers与nonfreezers的区域GABAA受体可用性。\",\n          \"population\": \"33名PD患者，9名女性、24名男性；平均年龄68.34 ± 6.38岁；平均病程8.03 ± 4.73年；freezers 8人，nonfreezers 25人。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 33,\n          \"n_patients_with_FOG\": 8,\n          \"n_patients_with_valid_neural_data\": 33,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告筛选及入组总人数、FOG事件数和重复测量次数。33例用于PET/MRI组间比较；没有STN电生理电极或触点数据。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"freezers vs nonfreezers；摘要未报告akinetic、trembling-in-place或kinetic-no-trembling等亚型。FOG分组依据为MDS-UPDRS Part III OFF-state examination。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"FOG分组依据采用MDS-UPDRS Part III OFF-state examination；PET扫描时具体药物状态未报告。\",\n          \"DBS_state_and_parameters\": \"摘要未报告DBS临床状态、测试刺激状态或刺激参数。\",\n          \"task\": \"依据MDS-UPDRS Part III OFF-state examination进行freezer与nonfreezer分组；摘要未报告事件级步行任务或实际冻结事件采集。\",\n          \"recording_location\": \"全脑[11C]-flumazenil PET。报告差异区域包括小脑蚓部（尤其lobule VI）、左后扣带、后海马旁回/伞部、内侧枕颞回、右直回、右前扣带及邻近右上额回、左后壳核和苍白球。摘要未报告STN特异性结果。\",\n          \"measure\": \"PET测量区域GABAA受体可用性/结合；MRI用于影像研究。该指标不是STN局部场电位或STN神经元放电。\",\n          \"frequency_and_analysis_window\": \"不适用；PET受体可用性指标，无电生理频段。采用SPM12进行全脑voxel-based t-tests；扫描及时间窗信息未报告。\",\n          \"finding\": \"与nonfreezers相比，freezers在小脑蚓部、左后扣带、后海马旁回/伞部、内侧枕颞回、右直回、右前扣带及邻近右上额回表现出较低GABAA受体可用性；左后壳核和苍白球也观察到降低。该结果为患者表型级比较，不是冻结事件期间的STN活动变化。\",\n          \"effect_estimate\": \"报告组间降低方向；摘要未提供各区域效应量、置信区间或具体P值。\",\n          \"statistical_unit_and_method\": \"患者级freezer与nonfreezer组间比较；whole-brain voxel-based t-tests，使用SPM12。摘要未说明多重比较校正、协变量调整或区域效应量。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性神经影像研究领域级初评。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"FOG组仅8人，摘要未说明连续入组、筛选过程或排除患者数量。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"采用MDS-UPDRS Part III OFF-state examination划分freezers与nonfreezers，但摘要没有报告视频确认或事件级冻结记录，也未报告FOG亚型。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"信号质量与伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未报告PET扫描质量控制、图像配准、运动伪迹排除或有效扫描分母。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"摘要提供了病程和运动评分，但未说明组间比较是否对疾病严重程度、年龄或其他临床差异进行协变量调整。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"重复测量与伪重复\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未报告重复扫描或重复测量；无法评价更细层级的分析结构。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"进行了全脑voxel-based t-tests，但摘要未说明多重比较校正方法和统计阈值。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"模型过拟合与外部验证\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要报告的是组间比较，并未描述预测模型或外部验证。\",\n                \"source_locator\": \"Abstract。\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"仅有摘要，无法核查预先设定的影像区域、分析方案及未报告结果。\",\n                \"source_locator\": \"Abstract。\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"该研究支持FOG患者存在区域性GABAA受体可用性差异，但不提供STN局部神经活动证据。Freezer分组不等于事件级冻结记录，不能将PET受体可用性与STN beta功率或beta burst指标直接比较。\",\n          \"quote\": \"significantly reduced GABAA receptor availability in the individuals with freezing as compared to those without.\",\n          \"source_locator\": {\n            \"section\": \"Abstract - Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42417016\",\n        \"title\": \"Enhanced Gait Variability Index in Neurological and Geriatric Rehabilitation: A Scoping Review.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"综述纳入18项研究、1915名参与者；摘要未提供原始研究PMID/DOI及各研究队列明细。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42421444\",\n        \"title\": \"Noninvasive Brain Stimulation for Parkinson's Disease: Therapeutic Applications and Clinical Perspectives.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"综述摘要未提供具体原始研究PMID/DOI或患者队列信息。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42422531\",\n        \"title\": \"Reduced pre-movement subthalamic beta desynchronization marks motor deficit in Parkinson's disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告16名植入Medtronic Activa PC+S系统的PD患者，但未提供研究中心、招募时间或与其他论文队列重叠的作者说明。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"PMID42422531_E1\",\n          \"design\": \"人类观察性神经电生理与运动学研究；在植入感知型DBS系统的PD患者中记录STN-LFP，并通过提示运动任务分析运动前beta去同步化及其与运动障碍的关系。\",\n          \"population\": \"16名PD患者，10名男性、6名女性；平均年龄57.9 ± 10.5岁；均植入Medtronic Activa PC+S sensing DBS system。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 16,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": 16,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告筛选/入组总人数、有效电极触点数、各任务试次数及FOG患者数。虽然记录了16人的STN-LFP，但未提供单独的信号质量排除统计。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"not_reported；摘要没有报告FOG诊断、冻结亚型或冻结事件。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"Med-Off；具体停药时间和剂量信息未报告。\",\n          \"DBS_state_and_parameters\": \"测试时DBS stimulation OFF；患者植入Medtronic Activa PC+S sensing DBS systems。刺激频率、幅度、脉宽、触点及方向性未报告。\",\n          \"task\": \"提示性sit-to-stand、stand-to-walk和wrist flexion-extension任务；研究运动启动前的神经活动。\",\n          \"recording_location\": \"STN local field potentials（STN-LFP）。\",\n          \"measure\": \"STN beta-band power；运动前beta去同步化，以静息基线归一化的beta功率量化。分析其与临床运动障碍严重程度及随后运动加速度的关系。\",\n          \"frequency_and_analysis_window\": \"beta频段13-30 Hz；pre-movement initiation window；以resting baseline归一化。摘要未报告运动前窗口的精确时间边界、滤波细节或时间分辨率。\",\n          \"finding\": \"所有任务均观察到运动前STN beta去同步化。更强的运动前beta去同步化与较轻的bradykinesia及更强的随后运动加速度相关。摘要没有报告Freezer与Non-freezer比较，也没有将神经活动与随后实际发生的FOG事件关联。\",\n          \"effect_estimate\": \"报告方向性关联；摘要未提供回归系数、效应量或置信区间。原摘要中P值文字为重复的P P P < 0.05，无法据此确定具体统计量或各任务对应P值。\",\n          \"statistical_unit_and_method\": \"使用linear mixed-effects models分析beta去同步化与临床运动障碍及运动加速度的关系。模型层级、患者级与试次级统计单位及随机效应结构未在摘要报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性电生理研究领域级初评。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"样本为植入感知型DBS系统的16名PD患者，摘要未说明招募流程、筛选标准及是否存在未纳入的植入患者。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"研究未报告FOG事件标签或Freezer分组，不能评价FOG行为标签有效性。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"信号质量与伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未提供LFP伪迹排除、接触点质量、运动伪迹控制或有效信号比例。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"Med-Off和刺激OFF条件得到报告，但摘要未说明其他临床变量、任务顺序或运动学差异的调整方式。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"重复测量与伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"使用linear mixed-effects models，但摘要未提供患者、任务和试次的层级结构及随机效应设置。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"包含多个任务和临床/运动学结局，摘要未报告多重比较校正。\",\n                \"source_locator\": \"Abstract - Results。\"\n              },\n              {\n                \"domain\": \"模型过拟合与外部验证\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要描述关联分析，没有报告预测模型或外部验证。\",\n                \"source_locator\": \"Abstract。\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未提供预注册、完整分析方案或所有任务的具体效应结果。\",\n                \"source_locator\": \"Abstract。\"\n              }\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"该研究是STN beta与运动启动/运动障碍的直接电生理证据，但不是STN活动与FOG的直接证据。运动前beta去同步化不能自动命名为pre-FOG beta变化，因为摘要没有报告同一试次随后发生冻结事件。不能将一般stand-to-walk启动窗口等同于FOG前窗口。\",\n          \"quote\": \"greater pre-movement beta desynchronization, less severe bradykinesia and more vigorous movement\",\n          \"source_locator\": {\n            \"section\": \"Abstract - Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42423496\",\n        \"title\": \"Performance of a Personalized Smart Cueing Device to Detect Freezing of Gait in Parkinson's Disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告24名PD患者，但未提供中心、招募时间或与其他论文队列重叠的信息。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42438839\",\n        \"title\": \"Brain markers of cognitive-motor control of gait function in Parkinson's disease: links with physical activity and aerobic fitness.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"叙述性综述纳入14项观察性研究；摘要未列出原始研究PMID/DOI及队列信息。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42438840\",\n        \"title\": \"Structural and functional brain changes following diverse exercise interventions in Parkinson's disease: an MRI-based narrative review.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"叙述性综述纳入18项干预试验；摘要未提供原始研究PMID/DOI或患者队列去重信息。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42460839\",\n        \"title\": \"Pharmacologically Modulating the Noradrenergic Arousal System to Reduce Freezing of Gait in Parkinson's Disease: Study Protocol of the International AnTi-FREEZE Study.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要描述计划招募60名患者的多中心交叉试验，但未提供实际入组、随机化或完成试验的患者资料。\",\n        \"source_type\": \"unclear\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42483310\",\n        \"title\": \"Breaking the Freeze: The Role of Cognitive Function in Freezing of Gait in Parkinson's Disease.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"叙述性综述摘要未提供具体原始研究PMID/DOI、纳入研究数量或患者队列信息。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"PMID42483310_E1\",\n          \"design\": \"叙述性综述，综合PD患者认知功能、神经影像、行为和康复研究；摘要未提供系统检索及定量合并方法。\",\n          \"population\": \"PD患者中有FOG和无FOG的人群；原始研究患者数量和具体队列特征未在摘要报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告原始研究样本分母、FOG事件数或神经记录数据分母；未提供可追溯的原始研究PMID/DOI。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"freezers；摘要未报告具体FOG运动学亚型。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"unknown；摘要未提供相关原始神经影像研究的Med-On/Med-Off条件。\",\n          \"DBS_state_and_parameters\": \"摘要未报告STN-DBS或其他DBS电生理数据。\",\n          \"task\": \"综述涵盖认知、行为、神经影像及康复研究；提及dual-task demands和emotional load，但未提供具体原始研究的FOG事件级任务条件。\",\n          \"recording_location\": \"综述提及frontal、prefrontal、posterior parietal cortex、ventral striatum、precuneus及amygdala等区域；摘要未报告STN特异性神经活动结果。\",\n          \"measure\": \"综述层面的脑活动、脑区连接及认知执行功能关联；包括额叶和顶叶活动及ventral striatum-precuneus-amygdala耦合。\",\n          \"frequency_and_analysis_window\": \"摘要未报告电生理频段、信号分析窗口、归一化方法或时间分辨率。\",\n          \"finding\": \"综述报告freezers存在额叶、前额叶和后顶叶皮层的异常活动，以及ventral striatum、precuneus和amygdala之间的异常耦合。该结果是综述层面的FOG表型关联，不是STN局部活动或事件级STN-FOG关联。\",\n          \"effect_estimate\": \"定性总结；摘要未报告合并效应量、置信区间或P值。\",\n          \"statistical_unit_and_method\": \"二次文献综合；原始研究的患者级或事件级统计单位及统计方法未在摘要报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS；仅摘要级初评，不能完成正式评价。\",\n            \"domains\": [\n              {\n                \"domain\": \"检索策略与研究覆盖\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要仅描述targeted searches，未提供数据库检索式、检索时间或检索完整性。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"研究筛选与数据提取\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未报告筛选流程、纳入研究数量及数据提取方法。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"原始研究偏倚风险评价\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未说明是否对原始神经影像和行为研究进行偏倚风险评价。\",\n                \"source_locator\": \"Abstract。\"\n              },\n              {\n                \"domain\": \"证据综合与选择性报告\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未提供原始研究列表、定量综合或发表偏倚分析。\",\n                \"source_locator\": \"Abstract。\"\n              }\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"属于secondary source，不能将综述中多个脑区的总结视为新的独立患者队列。摘要没有给出具体原始研究PMID/DOI，无法核查各脑区结果是否来自相同队列或不同任务。其报告的皮层-边缘系统活动不能直接替代STN-LFP证据。\",\n          \"quote\": \"Findings consistently demonstrate altered activity and connectivity within corticostriatal and corticolimbic circuits in freezers\",\n          \"source_locator\": {\n            \"section\": \"Abstract - Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42484421\",\n        \"title\": \"Feasibility of Real-Time Autonomous Functional Electrical Stimulation for Freezing of Gait.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告26名参与者，但未提供中心、招募时间或与其他研究队列重叠的说明。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42484650\",\n        \"title\": \"Effect of continuous subcutaneous foslevodopa/foscarbidopa infusion on gait in advanced Parkinson's disease: a real-world wearable-based study.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要未报告患者总数、中心及招募时间，不能与其他论文进行队列匹配。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42495269\",\n        \"title\": \"Freezing of gait and the effects of vibrotactile cueing in Parkinson's disease-a study protocol of a cross-sectional multimodal brain imaging approach in virtual walking scenarios.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"DRKS00034584\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要描述计划招募30名PD伴FOG患者，属于研究方案；没有实际完成的患者队列或神经影像结果。\",\n        \"source_type\": \"unclear\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42522567\",\n        \"title\": \"Distinct roles of the human cuneiform and pedunculopontine nuclei in gait and freezing of gait.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告4名PD患者及CuN/PPN双区域记录，但未提供中心、招募时间、植入设备或与其他研究队列重叠的作者说明。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"PMID42522567_E1\",\n          \"design\": \"人类侵入性神经电生理与生物力学研究；在4名伴有多巴胺治疗抵抗性FOG的PD患者中同步记录CuN和PPN局部场电位，并分析步态启动期间的区域性时间-频谱活动。\",\n          \"population\": \"4名伴dopa-resistant FOG的PD患者；摘要未报告年龄、性别、病程及其他临床特征。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 4,\n          \"n_patients_with_FOG\": 4,\n          \"n_patients_with_valid_neural_data\": 4,\n          \"n_FOG_events\": null,\n          \"n_trials\": 153,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告筛选/入组总人数、电极及触点数量、独立FOG事件数。153为摘要报告的38个FOG+试次与115个FOG−试次之和，不能将38个FOG+试次替代为38个独立冻结事件。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"unclear\",\n          \"freezing_phenotype\": \"not_reported；原文使用dopa-resistant FOG，未报告akinetic、trembling-in-place或其他具体亚型。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"摘要未报告记录及步态任务测试时的Med-On/Med-Off状态、剂量和给药时间。\",\n          \"DBS_state_and_parameters\": \"研究评估CuN、PPN及sham stimulation对步态启动的影响；摘要未报告临床DBS状态、具体刺激频率、幅度、脉宽、触点或方向性。\",\n          \"task\": \"步态启动；神经活动与anticipatory postural adjustments（APA）及step execution对齐。摘要还报告FOG+和FOG−试次比较。\",\n          \"recording_location\": \"Cuneiform nucleus（CuN）和pedunculopontine nucleus（PPN）的local field potentials；不是STN记录。\",\n          \"measure\": \"CuN和PPN的alpha、beta频段LFP活动。CuN alpha活动在APA前增加并与stepping rhythm相关；PPN beta去同步化发生于postural adjustments，随后在step execution阶段出现alpha调制。\",\n          \"frequency_and_analysis_window\": \"alpha和beta频段；摘要未报告具体Hz边界。分析时间与APA及step execution对齐，但未报告精确时间窗、静息基线归一化方式或功率计算方法。\",\n          \"finding\": \"步态启动时CuN和PPN表现出不同的时间-频谱活动模式。CuN alpha活动在APA之前增加并与stepping rhythm相关；PPN则在postural adjustments期间出现明显beta去同步化，随后在step execution期间出现alpha调制。该结果描述步态启动神经组织，不等同于FOG事件前STN活动。\",\n          \"effect_estimate\": \"报告CuN alpha与stepping rhythm的相关方向；摘要未提供相关系数、效应量、置信区间或具体P值。\",\n          \"statistical_unit_and_method\": \"神经活动与APA及step execution的时间对齐分析；涉及4名患者。摘要未提供患者级与试次级统计模型及重复测量处理方式。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性侵入性电生理研究领域级初评。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"仅4名伴dopa-resistant FOG的患者，属于高度特定的临床样本；摘要未报告招募流程及患者筛选标准。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要报告FOG+和FOG−试次，但未说明冻结事件的具体判定标准、视频确认方式或独立临床评审流程。\",\n                \"source_locator\": \"Abstract - Methods/Results。\"\n              },\n              {\n                \"domain\": \"信号质量与伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未报告CuN/PPN电极接触质量、信号伪迹排除、运动伪迹处理或有效触点比例。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未报告药物状态、刺激状态及患者间临床差异的控制方式。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"重复测量与伪重复\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"38个FOG+试次和115个FOG−试次来自4名患者；摘要未说明是否采用患者层级模型或校正试次嵌套结构。\",\n                \"source_locator\": \"Abstract - Results。\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"同时涉及两个核团、多个频段和多个步态阶段，摘要未报告多重比较校正。\",\n                \"source_locator\": \"Abstract - Results。\"\n              },\n              {\n                \"domain\": \"模型过拟合与外部验证\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"该证据为步态阶段神经活动描述，不足以从摘要确认是否建立预测模型或进行外部验证。\",\n                \"source_locator\": \"Abstract。\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未提供预注册方案、全部频段分析或所有患者级结果。\",\n                \"source_locator\": \"Abstract。\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"该研究记录的是CuN和PPN，而不是STN。其步态启动活动模式不能作为STN-FOG直接证据。摘要未提供频段精确边界、患者级统计模型或FOG事件确认方法。4名患者的多个试次不能视为独立患者重复验证。\",\n          \"quote\": \"Alpha-band activity in the CuN increased prior to APA and correlated with stepping rhythm, whereas the PPN showed prominent beta-band desynchronization during postural adjustments\",\n          \"source_locator\": {\n            \"section\": \"Abstract - Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"PMID42522567_E2\",\n          \"design\": \"人类侵入性神经电生理观察性研究；在4名伴dopa-resistant FOG的PD患者中比较FOG+与FOG−步态启动试次，寻找与随后冻结事件相关的神经活动变化。\",\n          \"population\": \"4名伴dopa-resistant FOG的PD患者。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 4,\n          \"n_patients_with_FOG\": 4,\n          \"n_patients_with_valid_neural_data\": 4,\n          \"n_FOG_events\": null,\n          \"n_trials\": 153,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要报告38个FOG+试次及115个FOG−试次，但未报告独立FOG事件总数、每个试次内事件数量及电极/触点数量；试次数不能替代事件数。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"pre_FOG_event_associated\",\n          \"freezing_phenotype\": \"not_reported；摘要未区分akinetic、trembling-in-place或其他FOG亚型。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"unknown；摘要未报告测试时的Med-On/Med-Off状态。\",\n          \"DBS_state_and_parameters\": \"记录CuN及PPN LFP，并评估CuN、PPN及sham stimulation的效果；FOG+与FOG−神经比较对应的刺激状态和参数未在摘要报告。\",\n          \"task\": \"步态启动；FOG+ trials（n=38）与FOG− trials（n=115）比较。摘要明确指出冻结发生于步态启动之后，且异常神经活动先于冻结。\",\n          \"recording_location\": \"Mesencephalic locomotor region（MLR），包括CuN和PPN；摘要未报告STN记录。\",\n          \"measure\": \"FOG相关的MLR alpha-band synchronization及PPN beta活动调制；比较FOG+与FOG−试次中的神经活动。\",\n          \"frequency_and_analysis_window\": \"alpha和beta频段；未提供精确Hz边界。关注步态启动至随后FOG发生的相关时间段；摘要未给出精确pre-FOG时间窗。\",\n          \"finding\": \"在随后发生FOG的试次中，冻结前出现MLR范围内过度且时间定位异常的alpha-band synchronization，以及异常PPN beta活动调制；与115个FOG−试次相比差异达到P<0.05。该结果属于同一试次随后出现冻结的事件相关前期变化，但记录区域为CuN/PPN而非STN。\",\n          \"effect_estimate\": \"FOG+与FOG−试次比较达到P<0.05；摘要未报告效应量、置信区间、具体统计检验或各频段的精确效应大小。\",\n          \"statistical_unit_and_method\": \"试次级比较：38个FOG+试次与115个FOG−试次；患者总数为4。摘要未报告患者内聚类校正、混合模型结构或患者级效应估计。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性事件相关侵入性电生理研究领域级初评。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"仅纳入4名dopa-resistant FOG患者，患者数量很少且临床表型特定。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要提供FOG+和FOG−标签及冻结发生描述，但未说明标签是否经过视频、临床评审或预先定义的运动学阈值确认。\",\n                \"source_locator\": \"Abstract - Methods/Results。\"\n              },\n              {\n                \"domain\": \"信号质量与伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未提供运动期间LFP伪迹处理、信号质量控制及有效触点信息。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告药物状态、刺激状态、步态启动条件及患者临床差异的调整。\",\n                \"source_locator\": \"Abstract - Methods。\"\n              },\n              {\n                \"domain\": \"重复测量与伪重复\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"153个试次嵌套于4名患者；摘要没有说明患者内相关性或试次重复测量的处理方式。\",\n                \"source_locator\": \"Abstract - Results。\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"分析涉及多个脑区、频段和步态阶段；摘要未报告多重比较校正。\",\n                \"source_locator\": \"Abstract - Results。\"\n              },\n              {\n                \"domain\": \"模型过拟合与外部验证\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要没有给出完整预测模型、交叉验证或外部验证信息。\",\n                \"source_locator\": \"Abstract。\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"无法从摘要核查所有频段、分析窗口和患者级结果是否完整报告。\",\n                \"source_locator\": \"Abstract。\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"这是所给论文中较明确的事件相关神经电生理证据，但信号来自CuN/PPN而非STN。FOG+试次与独立冻结事件数不能互换。仅4名患者，试次级显著性不能自动解释为患者级可重复效应。摘要没有提供精确频段边界、pre-FOG窗口或行为标签确认方法。\",\n          \"quote\": \"freezing was preceded by exaggerated and mistimed alpha-band synchronization across the MLR and abnormal modulation of PPN beta activity compared with non-freezing trials\",\n          \"source_locator\": {\n            \"section\": \"Abstract - Results\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42552260\",\n        \"title\": \"Freezing of Gait: A Tribute to Nir Giladi.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"摘要报告44名PD患者，但未提供研究中心、招募时间或与其他论文患者队列重叠的信息。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:42552316\",\n        \"title\": \"Vestibular nucleus stimulation for ameliorating locomotor dynamics in a Parkinsonian mouse model.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"unknown\",\n        \"cohort_id_candidate\": \"unknown\",\n        \"cohort_relation_basis\": \"动物实验摘要未报告动物数量、品系、实验批次及与其他研究的重叠情况。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "43995ea7-0b09-4d11-a913-a1895a1f06d0", "session_revision": 0, "session_ttl_max_hours": 6, "job_directory": "D:\\musicclaude\\gpt2agent-safechain\\runs\\gpt4\\pro-bridge-20261113T134430123730Z", "elapsed_seconds": 546.046, "completed_utc": "2026-11-13T13:53:36.178524+00:00", "model": "gpt-6-thinking", "thinking_effort": "max", "temporary": true, "unpersonalized": true, "generation_policy_verified": true, "request_policy": {"model": "gpt-6-thinking", "thinking_effort": "max", "history_and_training_disabled": true, "temporary_chat_requests_personalization": false, "is_do_not_remember": false, "continuation": false, "unpersonalized_inherited_verified": false, "body_sha256": "30927c32e91335b833e4d2b758011f946f3fee33a3f427ff4264b6d7898be4bc", "attachment_count": 0}, "stream_completion": {"sse_done": true, "message_completed": true, "independent_terminal_verified": true}, "profile": "Nozomi Kasaki / gpt4", "account_sha256": "bbd4fd636d4b6714d2b42b89e341bdb5bbe7c34f7d141aec76b444be8343fe54", "transport": "probridge-pure-http", "resume_requests": 0, "topic_connections": 0, "browser_started": false, "Docker_used": false, "automatic_retry": false, "initializer_pss_limit_mib": "not_applicable_no_browser", "attachment_count": 0, "code_sha256": {"tools\\chatgpt_web\\gpt3_cli.py": "96a4cdb6cd5d982f4d1de5b6ba8fae0cf23ee44aa3e41d7fdf6968e3fb590e48", "tools\\chatgpt_web\\gpt3_sessions.py": "83a3ed4ae1efa9f1a2b8ee3f144cc0dc9f668f995a33cc4222308cb3fa31f683", "tools\\chatgpt_web\\gpt3_attachments.py": "eedfa23885000025700f6306b1d1f4582896a7370734be506c156dee532fd7d7"}}, "screenshot_evidence": {"complete": true, "kind": "offline_actual_HTTP_response", "directory": "D:\\musicclaude\\gpt2agent-safechain\\runs\\gpt4\\pro-bridge-20261113T134430123730Z", "files": ["proof-offline.png"], "sha256": {"proof-offline.png": "b35235bd27751fc4c9cafe1b751803bef247b7e16b8a753e8441565686a61bf9"}}}
