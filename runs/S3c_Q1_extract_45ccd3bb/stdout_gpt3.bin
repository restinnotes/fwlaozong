{"completed": true, "response": "<escape>{\n  \"papers\": [\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39383230\",\n        \"title\": \"Bidirectional regulation of motor circuits using magnetogenetic gene therapy.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39383230\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39383230\",\n        \"cohort_relation_basis\": \"原始小鼠实验。摘要未报告实验中心、具体招募时间和样本数量；没有证据确认与本批其他论文存在重叠队列。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39383230_E1\",\n          \"design\": \"动物实验；AAV介导磁遗传基因表达与磁场调控；STN抑制性变体实验。\",\n          \"population\": \"PitX2-Cre帕金森病小鼠；具体帕金森病模型诱导方式及动物数量未在摘要报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未提及动物总数、有效分析数量及电极数量；患者相关分母不适用。摘要未报告FOG事件数量。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"not_reported；论文在另一项纹状体实验中使用motor freezing术语，但不能据此认定为PD-FOG。\",\n          \"medication_phenotype\": \"不适用（动物模型）。\",\n          \"experimental_medication_state\": \"摘要未报告药物处理状态。\",\n          \"DBS_state_and_parameters\": \"未报告DBS干预。STN为基因构建体表达位置，不是DBS电极记录或刺激位置。\",\n          \"task\": \"磁场暴露后评估神经元活性及运动行为；具体行为测试任务未报告。\",\n          \"recording_location\": \"STN；通过表达抑制性磁遗传构建体和c-fos表达评估，不是STN LFP或单/多单位电生理记录。\",\n          \"measure\": \"氯离子门控突变的anti-ferritin nanobody-TRPV1构建体；c-fos表达。\",\n          \"frequency_and_analysis_window\": \"不适用；摘要未报告STN电生理频段或分析窗口。\",\n          \"finding\": \"在PitX2-Cre帕金森病小鼠STN表达氯离子门控抑制变体后，c-fos表达降低。摘要还报告运动旋转行为改变，但没有报告自然步行中的FOG事件，不能将该结果解释为STN活动与FOG的直接关联。\",\n          \"effect_estimate\": \"c-fos表达降低；具体效应量、置信区间及P值未报告。\",\n          \"statistical_unit_and_method\": \"动物级或细胞级统计单位未报告；具体统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"动物实验偏倚域初评；摘要级，非已验证专用风险评估。\",\n            \"domains\": [\n              {\n                \"domain\": \"动物分配及随机化\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未报告动物分组随机化方法。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"实验人员及结局评估盲法\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未报告实验人员或c-fos评估人员是否盲法。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告动物数量、纳入排除标准及样本量计算。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"缺失数据\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告缺失动物或数据排除情况。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"结局测量\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"报告c-fos变化，但未提供测量及定量评估细节。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"只有摘要，无法比较预设结局与实际报告结局。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"STN证据是磁遗传抑制后c-fos表达下降，不是自然FOG事件中的STN神经活动记录。摘要中诱导motor freezing的实验发生在纹状体，而不是STN，不能把两项实验合并为STN-FOG证据。\",\n          \"quote\": \"Expression of this variant in the subthalamic nucleus in PitX2-Cre parkinsonian mice resulted in reduced c-fos expression\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39390087\",\n        \"title\": \"Deep learning-based detection of affected body parts in Parkinson's disease and freezing of gait using time-series imaging.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39390087\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39390087\",\n        \"cohort_relation_basis\": \"摘要明确报告90名参与者，其中60名PD患者（30名freezers、30名nonfreezers）和30名年龄匹配对照。未报告中心和招募时间，不能确认与其他研究的队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39390087_E1\",\n          \"design\": \"横断面观察性研究；基于360°转弯任务运动学数据的卷积神经网络分类研究。\",\n          \"population\": \"60名PD患者（30名FOG患者、30名无FOG患者）及30名年龄匹配健康对照。\",\n          \"n_enrolled\": 90,\n          \"n_analyzed\": 90,\n          \"n_patients_with_FOG\": 30,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"参与者数量及FOG患者数量明确。FOG事件数量、每人试次数和神经数据数量不适用或未报告；本研究分析运动学数据而非神经记录。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"freezer vs nonfreezer；摘要未报告akinetic、trembling-in-place等具体冻结表现。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"摘要未报告Med-On或Med-Off测试状态。\",\n          \"DBS_state_and_parameters\": \"摘要未报告DBS治疗或刺激参数。\",\n          \"task\": \"参与者以自选速度完成360°转弯任务。\",\n          \"recording_location\": \"身体运动学标记点；非STN神经记录。\",\n          \"measure\": \"身体标记点位置和加速度的time-series imaging；卷积神经网络用于freezer、nonfreezer和control分类。\",\n          \"frequency_and_analysis_window\": \"运动学时间序列转化为TS图像；具体采样频率、时间窗口及归一化方式未报告。\",\n          \"finding\": \"在freezer、nonfreezer和control分类中，左侧肱骨外上髁（LELB，较受累侧）和左侧髂后上棘（LPSI）被识别为相关身体部位；LPSI在加速度TS图像中具有最高分类准确性。该结果反映患者表型分类，不是事件级FOG预测或STN神经活动证据。\",\n          \"effect_estimate\": \"LPSI在加速度TS图像中的分类准确性最高；具体准确率、置信区间及P值未在摘要报告。\",\n          \"statistical_unit_and_method\": \"患者组别分类；卷积神经网络；数据划分、交叉验证及独立测试集情况未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性机器学习分类研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告招募来源、连续入组和排除流程。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告freezer与nonfreezer的临床诊断标准及FOG确认方法。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"报告预处理，但未报告运动学数据质量控制和标记点缺失处理细节。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"控制组年龄匹配，但未报告疾病严重度、药物状态等混杂控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告试次级数据如何聚合到患者级分类。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告身体部位筛选和多重检验校正方法。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"摘要报告最高准确性，但未说明独立测试集、交叉验证或外部验证。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"只有摘要，无法判断全部分析结果是否报告。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"这是freezer与nonfreezer表型分类研究，不是实际冻结事件的神经生理研究。没有STN记录、FOG事件级时间定位或事件前神经活动数据。\",\n          \"quote\": \"The LPSI marker in the acceleration TS images displayed the highest accuracy.\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39464215\",\n        \"title\": \"Cerebellar activity in hemi-parkinsonian rats during volitional gait and freezing.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39464215\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39464215\",\n        \"cohort_relation_basis\": \"摘要报告20只6-OHDA或sham处理大鼠，14、21和28天进行测量。与其他动物研究的模型、样本及队列重叠情况未知。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39464215_E1\",\n          \"design\": \"6-OHDA单侧损毁动物实验；纵向行为学与微型皮层电图记录。\",\n          \"population\": \"6-OHDA单侧损毁半帕金森大鼠及sham对照大鼠；年龄4至5个月；总数20只。\",\n          \"n_enrolled\": 20,\n          \"n_analyzed\": 20,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"20只动物总数明确；患者分母不适用。摘要未报告发生冻结的动物数、冻结事件数、有效电极数及试次数。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"during_FOG\",\n          \"freezing_phenotype\": \"freezing；动物冻结表现的具体运动学分类未报告。\",\n          \"medication_phenotype\": \"不适用（动物模型）。\",\n          \"experimental_medication_state\": \"6-OHDA或对照vehicle损毁；14、21、28天观察。\",\n          \"DBS_state_and_parameters\": \"未报告DBS。\",\n          \"task\": \"跑道上的自主行走及冻结行为。\",\n          \"recording_location\": \"小脑蚓部；micro-electrocorticography。\",\n          \"measure\": \"小脑蚓部振荡活动；摘要未明确具体功率、振荡频段或其他信号指标。\",\n          \"frequency_and_analysis_window\": \"摘要未报告具体频段边界、分析窗口、基线或归一化方法。\",\n          \"finding\": \"摘要指出冻结期间小脑振荡活动下降。这是小脑而非STN的神经活动结果。研究对象为动物，摘要未提供足以确认其冻结表现与人类临床FOG完全等价的行为学标准。\",\n          \"effect_estimate\": \"振荡活动下降；具体效应量、置信区间及冻结阶段的P值未报告。\",\n          \"statistical_unit_and_method\": \"摘要未明确冻结阶段分析采用动物级、事件级还是试次级统计；具体统计模型未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；动物观察性电生理与行为学研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"总样本20只，但未报告分组数量、随机化和样本量依据。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要称walking and freezing，但未报告冻结识别及视频验证标准。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告微型皮层电图伪迹排除及有效信号比例。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告运动速度、损毁程度和其他变量的冻结阶段控制方法。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"存在14、21、28天重复观察，但冻结事件与动物级统计的处理方式未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告时间点和信号指标的多重比较校正。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未报告预测模型。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"只有摘要，无法核查完整结果和预设结局。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"该结果支持小脑活动与动物冻结行为相关，但不能作为STN活动与临床PD-FOG的直接证据。没有冻结事件数、事件级效应量及具体频段信息。\",\n          \"quote\": \"The decrease in cerebellar oscillatory activity during freezing may be indicative of neurological changes during freezing of gait\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39464218\",\n        \"title\": \"Cerebellar activity in PINK1 knockout rats during volitional gait.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39464218\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39464218\",\n        \"cohort_relation_basis\": \"摘要报告PINK1 knockout大鼠4只及wild-type大鼠4只。与PMID:39464215虽然研究小脑和步态，但动物模型及样本描述不同，不能仅凭主题相似认定同一研究或队列。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39464218_E1\",\n          \"design\": \"遗传动物模型横断面电生理比较研究。\",\n          \"population\": \"8月龄PINK1 knockout大鼠4只及年龄匹配wild-type大鼠4只。\",\n          \"n_enrolled\": 8,\n          \"n_analyzed\": 8,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"动物数量明确；患者相关分母不适用。摘要未报告有效记录电极数量及试次数；未研究实际FOG事件。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"non_event_gait\",\n          \"freezing_phenotype\": \"not_reported。\",\n          \"medication_phenotype\": \"不适用（动物模型）。\",\n          \"experimental_medication_state\": \"未报告药物干预。\",\n          \"DBS_state_and_parameters\": \"未报告DBS。\",\n          \"task\": \"跑道上的自主行走。\",\n          \"recording_location\": \"小脑蚓部VIa-c及VII小叶；micro-electrocorticographic array。\",\n          \"measure\": \"局部场电位功率谱及相干性；beta和alpha频段功率。\",\n          \"frequency_and_analysis_window\": \"摘要仅报告beta和alpha频段，未给出具体边界、窗口、基线及归一化方式。\",\n          \"finding\": \"PINK1 knockout大鼠在行走期间，小脑蚓部VIb、VIc和VII小叶beta功率降低，VII小叶alpha功率降低，相对于wild-type对照存在显著差异。没有报告冻结事件或FOG-like现象。\",\n          \"effect_estimate\": \"beta和alpha功率下降；P<0.05；具体效应量及置信区间未报告。\",\n          \"statistical_unit_and_method\": \"动物组间比较；功率谱分析及相干性分析；具体检验方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；动物观察性电生理研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"每组仅4只动物，摘要未报告随机化及样本量依据。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"报告自主行走，但未报告具体步态事件识别标准。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告电生理信号伪迹和质量控制细节。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告运动速度、年龄以外因素及疾病严重度控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告动物内重复试次与动物级统计单位的处理。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"多个小叶及频段被比较，摘要未说明校正方法。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"未报告预测模型。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"仅摘要，无法判断预设分析及完整结果。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"这是小脑而非STN的非冻结步态电生理证据。不能将行走期间beta功率降低解释为FOG期间STN beta变化。\",\n          \"quote\": \"Cerebellar vermis power was hypoactive in the beta (VIb, VIc and VII) and alpha (VII) bands\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39466340\",\n        \"title\": \"Effects of puerarin on gait disturbance in a 6-hydroxydopamine mouse model of Parkinson's disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39466340\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39466340\",\n        \"cohort_relation_basis\": \"原始ICR小鼠6-OHDA实验。摘要未报告样本量和研究中心；不能确认与其他6-OHDA动物研究存在队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39466340_E1\",\n          \"design\": \"动物药理干预实验；6-OHDA帕金森病模型；比较puerarin与vehicle及其他药物处理。\",\n          \"population\": \"成年雄性ICR小鼠，右侧内侧前脑束单侧6-OHDA注射。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告动物总数及各治疗组数量。患者相关分母不适用。未报告FOG事件数量和有效电极数量。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"non_event_gait\",\n          \"freezing_phenotype\": \"not_reported；研究的是gait cycle disturbance，不是FOG。\",\n          \"medication_phenotype\": \"不适用（动物模型）。\",\n          \"experimental_medication_state\": \"恢复2周后，puerarin 20或50 mg/kg腹腔注射，每日一次，持续21天；vehicle为生理盐水。摘要还提及DA激动剂及NMDAR拮抗剂比较。\",\n          \"DBS_state_and_parameters\": \"未报告DBS。\",\n          \"task\": \"运动、步态周期及旋转测试。\",\n          \"recording_location\": \"SNc、STR、STN及初级运动皮层；LFP记录。\",\n          \"measure\": \"STN及其他区域beta波LFP；平均功率变化。\",\n          \"frequency_and_analysis_window\": \"摘要仅报告beta wave，未提供频段边界、分析窗口、基线及归一化方法。\",\n          \"finding\": \"6-OHDA小鼠存在步态周期紊乱。Puerarin改善步态周期紊乱，但在STN和纹状体中未改变已经减弱的beta波LFP。该结果显示行为改善与STN beta功率变化并非同步，但没有FOG事件级数据。\",\n          \"effect_estimate\": \"步态周期紊乱改善；STN及STR attenuated beta LFP无变化；具体效应量、置信区间和P值未报告。\",\n          \"statistical_unit_and_method\": \"动物级行为及LFP比较；具体统计模型和重复测量处理方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"ROBINS-I相关域改编；动物非随机干预研究；摘要级评估。\",\n            \"domains\": [\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未提供基线组间平衡和潜在混杂因素控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告各组动物数量及分配流程。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"干预分类\",\n                \"judgement\": \"low\",\n                \"reason\": \"摘要明确报告PUE剂量、vehicle及每日给药时间。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"偏离预定干预\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告依从性、处理偏离及共同干预。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"缺失数据\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告动物脱落及LFP数据排除。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"结局测量\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告步态分析和LFP定量评估是否盲法。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未提供预设结局及完整结果。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"研究对象为动物步态周期紊乱，不是临床FOG。STN beta不变不能直接解释为STN beta与FOG无关；研究没有事件级冻结记录。\",\n          \"quote\": \"PUE treatment induced no changes in the attenuated LFP of the beta wave in the STR and STN\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"39466340_E2\",\n          \"design\": \"动物药理干预实验；脑区间LFP相干性分析。\",\n          \"population\": \"成年雄性ICR小鼠，单侧6-OHDA帕金森病模型。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告动物数、有效LFP记录数和试次数；患者及FOG事件分母不适用或未报告。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"not_reported。\",\n          \"medication_phenotype\": \"不适用（动物模型）。\",\n          \"experimental_medication_state\": \"6-OHDA模型；PUE、vehicle及其他药物比较，具体该项相干性结果对应的处理组未在摘要明确区分。\",\n          \"DBS_state_and_parameters\": \"未报告DBS。\",\n          \"task\": \"摘要未明确该相干性结果对应的具体行为任务。\",\n          \"recording_location\": \"SNc与STN。\",\n          \"measure\": \"SNc-STN delta-wave coherence。\",\n          \"frequency_and_analysis_window\": \"delta频段；具体频率边界、窗口和归一化方法未报告。\",\n          \"finding\": \"摘要报告PD动物中存在SNc-STN delta-wave coherence。未报告该相干性与实际FOG事件或冻结易感性的关系。\",\n          \"effect_estimate\": \"报告存在delta-wave coherence；数值、组间效应量及P值未报告。\",\n          \"statistical_unit_and_method\": \"相干性分析；具体统计单位及检验方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"ROBINS-I相关域改编；动物非随机干预及电生理研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告组间基线平衡及药物处理对相干性的影响。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告动物数和记录成功率。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"干预分类\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"相干性结果对应的具体治疗组未在摘要明确说明。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"偏离预定干预\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"缺失数据\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告记录排除及数据缺失情况。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"结局测量\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告相干性分析窗口及伪迹控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"无法根据摘要判断预设相干性结局是否全部报告。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"delta相干性不能与beta功率或beta burst混为一谈；摘要没有提供相干性方向、幅度或FOG事件关联。\",\n          \"quote\": \"SNc-STN delta-wave coherence was shown in PD animals.\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39516465\",\n        \"title\": \"A framework for translational therapy development in deep brain stimulation.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": null,\n        \"cohort_id_candidate\": null,\n        \"cohort_relation_basis\": \"综述，不构成独立患者或动物队列。摘要未指出具体原始研究的PMID或DOI。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39518496\",\n        \"title\": \"Evaluating the Effects of Frequency of Subthalamic Nucleus Deep Brain Stimulation on Postural Control in Parkinson's Disease: A Case-Series Study.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39518496\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39518496\",\n        \"cohort_relation_basis\": \"摘要报告20名接受双侧STN-DBS的PD患者。单中心与招募时间信息未提供，不能确认与其他DBS队列是否重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39518496_E1\",\n          \"design\": \"病例系列研究；随机顺序的患者内DBS频率条件比较。\",\n          \"population\": \"20名接受双侧STN-DBS的PD患者，平均年龄61.2±10.1岁。\",\n          \"n_enrolled\": 20,\n          \"n_analyzed\": 20,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"患者总数明确。摘要未报告FOG患者人数、FOG事件数、具体SOT试次数和电极数量；本研究没有报告STN神经信号记录。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"not_reported。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"摘要未报告测试时Med-On或Med-Off状态。\",\n          \"DBS_state_and_parameters\": \"双侧STN-DBS；随机频率条件为60 Hz、130 Hz及180 Hz。幅度、脉宽、触点和方向性未报告。\",\n          \"task\": \"Computerized Dynamic Posturography；六种Sensory Organization Test（SOT）条件。\",\n          \"recording_location\": \"未进行STN神经活动记录；STN仅为DBS刺激靶点。\",\n          \"measure\": \"SOT6 equilibrium score；客观姿势平衡结局。\",\n          \"frequency_and_analysis_window\": \"DBS频率60、130、180 Hz；具体单次测试时间及信号分析窗口未报告。\",\n          \"finding\": \"三个刺激频率条件下，大多数SOT条件的平衡分数无显著差异；SOT6存在显著差异，60 Hz条件下平衡表现更好。该结果是姿势控制的刺激参数效应，不是FOG事件或STN神经活动证据。\",\n          \"effect_estimate\": \"SOT6：P=0.003；其余SOT条件P>0.05。具体效应量及置信区间未报告。\",\n          \"statistical_unit_and_method\": \"患者内频率条件比较；具体统计模型及多重比较校正未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"RoB 2相关域；随机顺序的患者内刺激条件病例系列，摘要级初评。\",\n            \"domains\": [\n              {\n                \"domain\": \"随机化过程\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"摘要报告频率参数随机安排，但未报告序列生成和分配隐藏。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"偏离预定干预\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告刺激参数执行偏离及盲法。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"缺失结局数据\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告缺失患者或SOT测量排除情况。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"结局测量\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"SOT为客观仪器测量，但评估者盲法及测量重复性未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"只有摘要，无法核查预设结局及所有SOT条件结果。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"没有实际FOG事件记录，没有STN LFP或单/多单位记录。SOT6平衡改善不能等同于FOG减少。\",\n          \"quote\": \"60 Hz showed better equilibrium performance in SOT6\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39546883\",\n        \"title\": \"Regional gray matter volumes are not predictive of axial symptom response to subthalamic deep brain stimulation in Parkinsonian patients.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39546883\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39546883\",\n        \"cohort_relation_basis\": \"单中心回顾性研究，94名PD患者，术前及术后3至6个月评估。未提供中心名称及招募时间，不能确认与其他DBS研究队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39546883_E1\",\n          \"design\": \"单中心回顾性观察性预后研究；MRI脑区体积与STN-DBS术后轴性症状改善程度的预测分析。\",\n          \"population\": \"94名PD患者，接受STN-DBS；术前及术后3至6个月评估。\",\n          \"n_enrolled\": 94,\n          \"n_analyzed\": 94,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"患者总数明确。摘要未报告FOG患者人数、冻结事件数和有效神经记录数量；研究使用结构MRI而非STN电生理。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"FOG-Q表型评估；未报告akinetic、trembling-in-place等具体冻结表现。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"术前及术后药物状态未在摘要报告。\",\n          \"DBS_state_and_parameters\": \"STN-DBS；术后3至6个月评估；刺激频率、幅度、脉宽及触点未报告。\",\n          \"task\": \"MDS-UPDRS III、Berg Balance Scale、FOG-Q及Ziegler Course临床和仪器化评估。\",\n          \"recording_location\": \"MRI测量中脑、脑桥、中脑小脑脚及皮质灰质体积；无STN神经信号记录。\",\n          \"measure\": \"MR PIGD index及其他脑区灰质体积；与术后轴性症状改善的回归及偏最小二乘相关分析。\",\n          \"frequency_and_analysis_window\": \"不适用；结构MRI体积测量，不是神经振荡频段分析。\",\n          \"finding\": \"STN-DBS后轴性症状改善具有异质性，但MR PIGD index及其他皮质灰质体积均不能预测术后轴性症状改善程度。FOG-Q被纳入临床评估，但摘要未提供其独立预测效应。\",\n          \"effect_estimate\": \"未发现MR PIGD index或其他皮质脑区体积具有预测作用；具体回归系数、置信区间及P值未报告。\",\n          \"statistical_unit_and_method\": \"患者级预后分析；回归分析及partial least squares correlation analysis。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"ROBINS-I相关域改编；回顾性观察性预后研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告疾病严重度、药物反应及手术参数等潜在混杂控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"单中心回顾性设计，摘要未报告筛选及排除患者数量。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"预测指标测量\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告MRI体积测量的盲法及重复性。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"结局测量\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"临床量表和Ziegler Course被使用，但未报告评估者盲法及FOG事件确认。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"缺失数据\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告术前术后配对数据完整性。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未报告模型内部验证、外部验证或过拟合校正。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"无法根据摘要判断所有影像指标和临床结局是否均被报告。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"研究检验的是结构灰质体积对轴性症状改善的预测能力，不是STN神经活动与FOG的关系。FOG-Q不能替代事件级冻结记录。\",\n          \"quote\": \"Neither the MR PIGD index nor other cortical brain volumes predicted the extent of the postoperative, axial symptom improvement.\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39556446\",\n        \"title\": \"Modulating the cholinergic system-Novel targets for deep brain stimulation in Parkinson's disease.\",\n        \"publication_status\": \"review\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": null,\n        \"cohort_id_candidate\": null,\n        \"cohort_relation_basis\": \"综述文章，不构成独立患者队列。摘要未明确列出具体原始研究PMID或DOI，不能将综述中的概括视为独立重复验证。\",\n        \"source_type\": \"secondary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39556446_E1\",\n          \"design\": \"综述；讨论PD胆碱能系统、轴性症状及不同DBS靶点。\",\n          \"population\": \"综述涉及PD患者及既有基础和临床研究；具体原始研究数量及队列数量未在摘要报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"二级综述，无独立患者分母。摘要未提供具体纳入研究及其样本分母。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"FOG作为轴性症状被讨论；未报告具体冻结表现。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"摘要讨论左旋多巴及DBS治疗，但没有提供单项研究的测试药物状态。\",\n          \"DBS_state_and_parameters\": \"综述讨论STN及GPi DBS治疗原发运动症状，以及PPN和NBM等胆碱能靶点；没有提供可提取的单项STN刺激参数。\",\n          \"task\": \"不适用；综述。\",\n          \"recording_location\": \"讨论胆碱能系统、PPN、NBM及基底节网络；摘要没有提供STN神经活动记录结果。\",\n          \"measure\": \"综述层面的临床症状及治疗机制概括；没有报告可量化的STN LFP、beta功率或burst指标。\",\n          \"frequency_and_analysis_window\": \"摘要未报告神经振荡频段及分析窗口。\",\n          \"finding\": \"综述指出，左旋多巴及STN或GPi DBS能够改善PD原发运动症状，但对轴性症状及认知障碍的改善有限；提出PPN和NBM等胆碱能靶点作为潜在治疗方向。该内容是二级文献概括，不是新的FOG患者队列或STN神经活动实验。\",\n          \"effect_estimate\": \"未报告可提取的独立效应量、置信区间或P值。\",\n          \"statistical_unit_and_method\": \"综述；摘要未报告系统检索、纳入标准、合并分析或统计方法。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"AMSTAR 2/ROBIS相关域；仅摘要，无法完成有效系统综述质量评估。\",\n            \"domains\": [\n              {\n                \"domain\": \"研究问题及纳入标准\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未提供详细纳入标准。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"检索策略\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未报告数据库及完整检索策略。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"研究筛选及数据提取\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未报告筛选和提取流程。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"原始研究偏倚风险评价\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未报告原始研究风险评价。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"证据综合\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未提供定量或定性综合方法细节。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"发表偏倚\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未报告发表偏倚评估。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"not_assessed\"\n          },\n          \"limitations\": \"不能将该综述作为STN神经活动与FOG关系的独立患者证据。摘要没有给出支持具体结论的原始研究PMID/DOI，需获得全文后追溯引用。\",\n          \"quote\": \"they often fall short in mitigating axial symptoms and cognitive impairment.\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39606789\",\n        \"title\": \"Beta-gamma phase-amplitude coupling of scalp electroencephalography during walking preparation in Parkinson's disease differs depending on the freezing of gait.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39606789\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39606789\",\n        \"cohort_relation_basis\": \"摘要报告11名PD患者及其EEG试次。未提供中心和招募时间，无法判断与其他FOG队列是否重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39606789_E1\",\n          \"design\": \"观察性人体神经电生理研究；步行准备及行走期间头皮EEG事件条件分析。\",\n          \"population\": \"11名PD患者；平均年龄59.1±6.9岁，病程13.9±4.1年，男性7名。\",\n          \"n_enrolled\": 11,\n          \"n_analyzed\": 11,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": 24,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"共分析24个试次：无FOG试次18个，有FOG试次6个；另有4个试次因伪迹排除。6个FOG试次不能直接等同于6个独立FOG事件或6名FOG患者。有效EEG患者数量及电极数未报告。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"pre_FOG_event_associated\",\n          \"freezing_phenotype\": \"FOG；摘要未区分akinetic、trembling-in-place及其他表现。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"摘要未报告Med-On或Med-Off状态。\",\n          \"DBS_state_and_parameters\": \"摘要未报告DBS治疗或刺激参数。\",\n          \"task\": \"步行准备及随后步行；按同一试次是否出现FOG进行分类。\",\n          \"recording_location\": \"头皮EEG；sensorimotor area。\",\n          \"measure\": \"beta-gamma phase-amplitude coupling（PAC）。\",\n          \"frequency_and_analysis_window\": \"beta-gamma PAC；步行准备阶段；具体beta和gamma边界、PAC计算窗口、基线及归一化方式未报告。\",\n          \"finding\": \"在无FOG试次中，sensorimotor area beta-gamma PAC在步行准备期间下降（P=0.011）；在随后出现FOG的试次中没有观察到相同下降（P=0.64）。由于比较的是同一试次随后是否出现FOG，属于事件相关的步行准备阶段证据，但不是STN活动证据。\",\n          \"effect_estimate\": \"无FOG试次：P=0.011；有FOG试次：P=0.64。效应量及置信区间未报告。\",\n          \"statistical_unit_and_method\": \"试次条件比较；linear mixed-effects model；具体随机效应结构未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性神经电生理及预测研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"仅11名PD患者，摘要未说明招募方式和排除标准。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未说明FOG判定者、视频验证及具体冻结标准。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"明确有4个试次因伪迹排除，但未报告伪迹类型和排除规则。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告药物状态、步速及疾病严重度对PAC的控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"24个试次来自11名患者；使用LME，但SVM预测是否按患者分组验证未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告不同脑区、阶段和频段比较的多重检验校正。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"SVM准确率为71.2%，但摘要未报告独立测试集及外部验证。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"无法从摘要判断所有PAC指标及预设分析是否完整报告。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"头皮EEG PAC不能作为STN LFP beta功率或beta burst的替代指标。FOG确认方式、PAC频段边界和患者级独立验证情况未报告。\",\n          \"quote\": \"In the trials without FOG (n = 18), beta-gamma PAC in the sensorimotor area decreased during gait preparation (p = 0.011)\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"39606789_E2\",\n          \"design\": \"观察性人体神经电生理研究；同一试次FOG状态分层的步行期PAC分析。\",\n          \"population\": \"11名PD患者；24个有效试次，其中6个试次出现FOG。\",\n          \"n_enrolled\": 11,\n          \"n_analyzed\": 11,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": 24,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"6个有FOG试次并非已确认的6个独立事件；另4个试次因伪迹排除。患者级FOG人数未报告。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"during_FOG\",\n          \"freezing_phenotype\": \"FOG；具体表现未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"摘要未报告Med-On或Med-Off状态。\",\n          \"DBS_state_and_parameters\": \"未报告DBS。\",\n          \"task\": \"步行期间，按试次是否出现FOG分组。\",\n          \"recording_location\": \"头皮EEG；sensorimotor area。\",\n          \"measure\": \"beta-gamma phase-amplitude coupling。\",\n          \"frequency_and_analysis_window\": \"beta-gamma PAC；步行期间；具体频段边界和事件锁定窗口未报告。\",\n          \"finding\": \"出现FOG的试次中，步行期间sensorimotor area PAC增加。\",\n          \"effect_estimate\": \"P=0.0042；具体效应量及置信区间未报告。\",\n          \"statistical_unit_and_method\": \"试次级分析；linear mixed-effects model；具体随机效应结构未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性神经电生理研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"样本仅11名PD患者。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告FOG事件的视频或临床确认方式。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"4个试次因伪迹排除，具体处理方法未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告药物状态和步态速度控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"试次嵌套于患者；LME使用情况已报告，但模型结构不明。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告多重比较校正。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"本项为PAC组间比较，不是独立预测模型结果。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"仅摘要，无法判断全部PAC分析是否报告。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"没有STN神经记录，且没有报告FOG事件的精确起止时间，因此无法比较STN信号在冻结发生前、冻结期间和恢复期的变化。\",\n          \"quote\": \"PAC increased during walking in trials with FOG (p = 0.0042)\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"39606789_E3\",\n          \"design\": \"观察性人体神经电生理研究；PAC与临床轴性症状评分的相关分析。\",\n          \"population\": \"11名PD患者。\",\n          \"n_enrolled\": 11,\n          \"n_analyzed\": 11,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": 24,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"患者FOG人数未报告；4个试次因伪迹排除。患者级有效数据人数未明确。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"PIGD临床评分关联；不是独立冻结事件分类。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"摘要未报告。\",\n          \"DBS_state_and_parameters\": \"未报告DBS。\",\n          \"task\": \"步行开始后20秒的步行期间PAC测量。\",\n          \"recording_location\": \"头皮EEG；sensorimotor area。\",\n          \"measure\": \"beta-gamma PAC与PIGD评分相关性。\",\n          \"frequency_and_analysis_window\": \"步行开始后20秒；beta-gamma频段边界未报告。\",\n          \"finding\": \"步行开始后20秒的PAC与PIGD评分呈正相关。该结果是临床表型相关性，不是FOG事件级关联。\",\n          \"effect_estimate\": \"Pearson相关系数r=0.406，P=0.032。\",\n          \"statistical_unit_and_method\": \"患者级相关分析；Pearson相关。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性神经电生理相关研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"样本仅11名患者。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"PIGD评分的具体构成和评估方法未在摘要详细报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"存在4个试次伪迹排除。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告年龄、药物状态和病程等相关混杂控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"相关分析采用患者级还是试次聚合值未完全说明。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告多重检验校正。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"本项为相关分析。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"只有摘要。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"PIGD不是FOG事件数量或冻结严重度的直接替代；该结果不能推断PAC与STN神经活动之间存在关联。\",\n          \"quote\": \"PAC 20 s after the start of walking was positively correlated with the PIGD score\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39702816\",\n        \"title\": \"Evaluating gait and postural responses to subthalamic stimulation and levodopa: A prospective study using wearable technology.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39702816\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39702816\",\n        \"cohort_relation_basis\": \"前瞻性STN-DBS术前术后研究，33名PD患者。未提供中心及招募时间，不能确认与其他STN-DBS队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39702816_E1\",\n          \"design\": \"前瞻性术前术后观察性干预研究；可穿戴传感器评估药物及刺激状态下的步态。\",\n          \"population\": \"33名PD患者，术前及STN-DBS术后6个月评估。\",\n          \"n_enrolled\": 33,\n          \"n_analyzed\": 33,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"患者总数明确；摘要未报告FOG患者数、冻结事件数、试次数及有效神经记录数。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"non_event_gait\",\n          \"freezing_phenotype\": \"not_reported；摘要没有事件级FOG结果。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"术前两种及术后四种条件，包含OFF/ON medication与OFF/ON stimulation状态；具体给药剂量及时间未报告。\",\n          \"DBS_state_and_parameters\": \"STN-DBS术后6个月；比较刺激ON与OFF状态；频率、幅度、脉宽和触点未报告。\",\n          \"task\": \"步态及姿势测试；测量速度、步长、步频、转弯和其他时空步态参数。\",\n          \"recording_location\": \"可穿戴运动传感器；没有STN LFP或单/多单位神经记录。\",\n          \"measure\": \"步态速度。\",\n          \"frequency_and_analysis_window\": \"可穿戴传感器采集；采样频率和分析窗口未报告。\",\n          \"finding\": \"STN刺激在改善步态速度方面优于左旋多巴。该结果是一般步态参数，不是FOG事件减少，也不是STN神经活动与FOG的直接关系。\",\n          \"effect_estimate\": \"标准化反应均值（SRM）提示刺激优于左旋多巴；具体SRM数值及置信区间未报告。\",\n          \"statistical_unit_and_method\": \"患者级术前术后治疗反应；SRM；具体比较模型未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"ROBINS-I相关域；前瞻性非随机术前术后干预研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"刺激和药物状态被比较，但手术前后时间效应及其他治疗变化未在摘要说明。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告连续入组及患者排除流程。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"干预分类\",\n                \"judgement\": \"low\",\n                \"reason\": \"摘要明确区分OFF/ON药物及刺激状态。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"偏离预定干预\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告实际刺激和药物依从性。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"缺失数据\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告术前术后数据缺失情况。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"结局测量\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"使用可穿戴传感器，但未报告评估者盲法及有效数据标准。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"无法根据摘要核查所有预设步态结局。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"本研究没有报告FOG事件级结局，也没有STN神经活动记录。不能将一般步态速度改善等同于FOG改善。\",\n          \"quote\": \"stimulation outperformed levodopa in enhancing gait speed\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39728063\",\n        \"title\": \"Cerebral Amyloid-β Deposition, Axial Features, and Cognitive Alterations in Patients with Parkinson's Disease Treated with Bilateral STN-DBS: A Long-Term Cohort Study.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39728063\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39728063\",\n        \"cohort_relation_basis\": \"19名双侧STN-DBS患者，术后5年随访。摘要未报告中心和招募时间，不能确认与其他长期DBS队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39743499\",\n        \"title\": \"Modified Ratio of Tremor/Postural Instability Gait Difficulty Score as an Indicator of Short-Term Outcomes of Subthalamic Nucleus Deep Brain Stimulation in Parkinson's Disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39743499\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39743499\",\n        \"cohort_relation_basis\": \"前瞻性研究，39名连续接受STN-DBS的PD患者。未报告中心和招募时间，无法确认与其他队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": []\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39755754\",\n        \"title\": \"N2GNet tracks gait performance from subthalamic neural signals in Parkinson's disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39755754\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39755754\",\n        \"cohort_relation_basis\": \"摘要报告18名PD患者进行原地踏步并采集STN LFP。未提供中心、招募时间及设备型号，不能确认与其他STN记录队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39755754_E1\",\n          \"design\": \"人体STN电生理观察研究；深度学习回归模型开发及步态性能追踪。\",\n          \"population\": \"18名PD患者，进行原地踏步任务。\",\n          \"n_enrolled\": 18,\n          \"n_analyzed\": 18,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": 18,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要报告18名患者采集了STN LFP，但没有报告FOG患者人数、FOG事件数、试次数及电极触点数量。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"non_event_gait\",\n          \"freezing_phenotype\": \"not_reported；研究未报告FOG事件或FOG-like现象。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"摘要未报告Med-On或Med-Off状态。\",\n          \"DBS_state_and_parameters\": \"使用STN神经信号；是否在刺激ON或OFF状态记录，以及刺激频率、幅度、脉宽和触点，摘要未报告。\",\n          \"task\": \"stepping in place；使用地面反作用力追踪重心及体重转移。\",\n          \"recording_location\": \"STN local field potentials；两个lead的beta功率用于比较。\",\n          \"measure\": \"N2GNet神经到步态回归模型；综合频段STN LFP预测地面反作用力所代表的weight shifts；与两个lead的beta power比较。\",\n          \"frequency_and_analysis_window\": \"综合频段，不局限于beta；具体频段边界、窗口、基线及归一化方法未报告。\",\n          \"finding\": \"N2GNet对体重转移的追踪相关性高于两个lead的beta power，并且优于其他被评估模型设计。研究没有报告该模型对FOG事件或冻结前状态的识别能力。\",\n          \"effect_estimate\": \"N2GNet与weight shifts的相关性强于beta power；具体相关系数、效应量、置信区间及P值未报告。\",\n          \"statistical_unit_and_method\": \"连续步态性能回归；模型间相关性比较；患者级和试次级统计单位未明确报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性STN电生理及机器学习研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"样本仅18名患者，摘要未报告招募和排除标准。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"以地面反作用力和weight shifts作为步态表现标签，但不是临床FOG事件标签。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告STN LFP质量控制、刺激伪迹及数据排除规则。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告药物状态、刺激状态及步态速度等变量控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告患者内多个时间窗口和试次的统计处理。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"评估多个模型设计，但未报告多重比较校正。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"摘要报告模型优于其他设计，但未说明独立测试集及外部验证。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"仅摘要，无法核查完整模型比较结果。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"这是目前所给论文中较直接的STN LFP-步态性能证据，但其终点是原地踏步中的weight shifts，不是自然行走FOG。不能把综合频段模型的优势解释为其已识别FOG特异性神经活动。\",\n          \"quote\": \"N2GNet effectively leverages a comprehensive frequency band, not limited to the beta range, to track gait performance solely from STN LFPs.\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39759396\",\n        \"title\": \"Attenuated afferent inhibition correlated with impaired gait performance in Parkinson's disease patients with freezing of gait.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39759396\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39759396\",\n        \"cohort_relation_basis\": \"摘要报告25名LR-FOG、15名LUR-FOG、28名NO-FOG PD患者及22名健康对照，总计90人。未报告研究中心和招募时间，无法确认与其他FOG队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39759396_E1\",\n          \"design\": \"横断面临床神经生理比较研究；TMS配对刺激及步态评估。\",\n          \"population\": \"25名左旋多巴反应性FOG患者（LR-FOG）、15名左旋多巴不反应性FOG患者（LUR-FOG）、28名无FOG的PD患者及22名健康对照。\",\n          \"n_enrolled\": 90,\n          \"n_analyzed\": 90,\n          \"n_patients_with_FOG\": 40,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"四组患者人数明确，FOG患者40人。摘要未报告实际冻结事件数、TMS有效记录数量及重复试次数。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"LR-FOG与LUR-FOG；分别为左旋多巴反应性和不反应性FOG。未报告akinetic或trembling-in-place等具体表现。\",\n          \"medication_phenotype\": \"LR-FOG与LUR-FOG；这是患者对左旋多巴反应的表型分组，不等同于本次测试的Med-On或Med-Off状态。\",\n          \"experimental_medication_state\": \"摘要未报告PAS、TMS及步态测试时的具体药物状态。\",\n          \"DBS_state_and_parameters\": \"摘要未报告DBS。\",\n          \"task\": \"10-meter timed Up and Go；便携式步态分析系统评估时空步态参数。\",\n          \"recording_location\": \"TMS评估的感觉运动皮层相关传入抑制；不是STN记录。\",\n          \"measure\": \"Short-latency afferent inhibition（SAI）；与FOG分组和步态表现比较。\",\n          \"frequency_and_analysis_window\": \"SAI；具体刺激间隔、强度及分析窗口未在摘要报告。\",\n          \"finding\": \"与健康对照和无FOG的PD患者相比，LR-FOG及LUR-FOG患者SAI降低。摘要还报告SAI降低与步态时空参数受损及FOG量表评分相关。\",\n          \"effect_estimate\": \"SAI在两个FOG亚组中降低；具体效应量、置信区间及P值未报告。\",\n          \"statistical_unit_and_method\": \"患者级组间比较及相关分析；具体统计检验方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；横断面神经生理及临床表型研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要报告各组数量，但未说明招募来源及连续入组情况。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"FOG分组及左旋多巴反应判定的具体标准未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告TMS及PAS测量的信号质量和排除标准。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告年龄、病程、认知状态及药物状态的调整。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告重复测量的患者内统计处理。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"SAI、LAI及多个步态参数均被比较，校正方法未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未报告预测模型。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"只有摘要，无法判断全部神经生理及临床结果是否报告。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"SAI是感觉运动整合指标，不是STN局部神经活动。患者分组属于FOG易感性或表型比较，没有实际冻结事件的时间锁定神经记录。\",\n          \"quote\": \"Compared to HC and NO-FOG PD patients, SAI was decreased in FOG PD subgroups.\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"39759396_E2\",\n          \"design\": \"横断面临床神经生理比较研究；TMS配对刺激及步态评估。\",\n          \"population\": \"25名LR-FOG、15名LUR-FOG、28名NO-FOG PD患者及22名健康对照。\",\n          \"n_enrolled\": 90,\n          \"n_analyzed\": 90,\n          \"n_patients_with_FOG\": 40,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"组别人数明确；LAI有效数据人数、FOG事件数及试次数未报告。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"LR-FOG与LUR-FOG。\",\n          \"medication_phenotype\": \"左旋多巴反应性与不反应性FOG分组。\",\n          \"experimental_medication_state\": \"摘要未报告测试时具体药物状态。\",\n          \"DBS_state_and_parameters\": \"未报告DBS。\",\n          \"task\": \"10-meter timed Up and Go及TMS配对刺激。\",\n          \"recording_location\": \"感觉运动皮层相关传入抑制评估；非STN记录。\",\n          \"measure\": \"Long-latency afferent inhibition（LAI）。\",\n          \"frequency_and_analysis_window\": \"LAI；具体刺激间隔、分析窗口和归一化方式未报告。\",\n          \"finding\": \"与健康对照相比，LR-FOG和LUR-FOG患者LAI均降低；但与NO-FOG患者比较时，只有LUR-FOG组表现出显著LAI降低。\",\n          \"effect_estimate\": \"两个FOG亚组相对于HC降低；仅LUR-FOG相对于NO-FOG显著降低。具体效应量及P值未报告。\",\n          \"statistical_unit_and_method\": \"患者级组间比较；具体统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；横断面神经生理研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未说明连续招募及患者筛选。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告FOG分组的临床确认标准。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告LAI测量质量控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告药物状态、病程和疾病严重度控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告患者内重复测量处理。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"同时比较SAI、LAI及多个组别，校正方法未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"未报告预测模型。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"仅摘要，无法评估完整结果报告。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"unclear\"\n          },\n          \"limitations\": \"LAI结果提示感觉运动整合异常可能与FOG表型有关，但不能推断其是FOG发生的直接原因，也不能推断STN beta或其他STN活动发生了相同变化。\",\n          \"quote\": \"only LUR-FOG PD showed significant reduction of LAI in comparison to NO-FOG PD group.\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39789469\",\n        \"title\": \"Do the gait domains change in PD patients with freezing of gait during their 'interictal' period?\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39789469\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39789469\",\n        \"cohort_relation_basis\": \"横断面研究，245名PD患者（167名无FOG、78名有FOG）和68名健康对照。未报告研究中心和招募时间，无法确认与其他FOG队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39789469_E1\",\n          \"design\": \"横断面观察性研究；可穿戴惯性传感器步态分析及探索性因子分析。\",\n          \"population\": \"68名健康对照、167名无FOG的PD患者及78名FOG患者，总计313人。\",\n          \"n_enrolled\": 313,\n          \"n_analyzed\": 313,\n          \"n_patients_with_FOG\": 78,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"参与者数量及FOG分组人数明确。没有神经电生理数据；实际FOG事件数和步态试次数未报告。\",\n          \"endpoint_class\": \"D_susceptibility\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"FOG患者interictal period；冻结事件间歇期的步态表型。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"摘要未报告测试时药物状态。\",\n          \"DBS_state_and_parameters\": \"摘要未报告DBS。\",\n          \"task\": \"可穿戴惯性传感器步态评估；interictal period。\",\n          \"recording_location\": \"身体可穿戴惯性传感器；非脑神经记录。\",\n          \"measure\": \"六个步态域；其中gait phase domain用于FOG与non-FOG组比较。\",\n          \"frequency_and_analysis_window\": \"惯性传感器时间序列；采样频率和分析窗口未报告。\",\n          \"finding\": \"在FOG患者的interictal period，gait phase domain与无FOG的PD患者存在差异。该步态域被报告为FOG的独立风险因素，属于冻结间歇期表型而不是事件前STN神经活动。\",\n          \"effect_estimate\": \"PD-FOG与PD-nFOG比较：Cohen's d=-0.46，校正后P=0.004；独立风险因素OR=1.64，95% CI 1.05-2.55，P=0.030。\",\n          \"statistical_unit_and_method\": \"患者级组间比较；探索性因子分析及多变量回归；具体模型细节未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；横断面观察性表型和风险预测研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未报告招募中心、连续入组及排除标准。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"FOG诊断及interictal状态的具体判定标准未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告惯性传感器数据质量及无效步态数据处理。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"报告性别、PIGD及运动并发症风险因素，但其他混杂控制细节不明。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告多个步态周期如何聚合至患者级分析。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"六个步态域被分析，具体多重比较校正策略未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"报告风险模型，但摘要未说明内部及外部验证。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"只有摘要，无法评估全部因子和模型结果。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"这是interictal步态表型研究，不是冻结事件前的时间锁定神经记录；没有STN活动指标。不能将gait phase domain异常解释为STN beta异常。\",\n          \"quote\": \"The gait phase domain was different in the PD-FOG group compared to the PD-nFOG group (p corrected = 0.004, Cohen's d = -0.46).\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39796914\",\n        \"title\": \"Refinement of an Algorithm to Detect and Predict Freezing of Gait in Parkinson Disease Using Wearable Sensors.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39796914\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39796914\",\n        \"cohort_relation_basis\": \"摘要说明使用此前收集的数据，但未提供原始研究PMID、样本量、中心和招募时间。与其他研究的队列重叠关系unknown。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39796914_E1\",\n          \"design\": \"既有数据的算法开发及预测性能评估；可穿戴传感器FOG检测与预测。\",\n          \"population\": \"PD患者；使用研究团队此前收集的数据；具体患者数量和人口学特征未在摘要报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未提及患者数、FOG患者数、实际事件数、试次数和传感器数量。\",\n          \"endpoint_class\": \"B_objective_natural\",\n          \"event_phase\": \"pre_FOG_event_associated\",\n          \"freezing_phenotype\": \"FOG；具体akinetic或trembling表现未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"摘要未报告。\",\n          \"DBS_state_and_parameters\": \"未报告DBS。\",\n          \"task\": \"使用既有可穿戴传感器步态数据进行FOG检测及预测。\",\n          \"recording_location\": \"身体可穿戴传感器；非STN神经记录。\",\n          \"measure\": \"pFOG算法；回顾性检测和未来FOG预测。\",\n          \"frequency_and_analysis_window\": \"采样频率在算法比较中包括60 Hz及30 Hz；预测提前时间和分析窗口未报告。\",\n          \"finding\": \"pFOG算法能够预测即将发生的FOG，但假阳性率较高。摘要未提供预测窗口、敏感度、特异度或独立患者级验证结果。\",\n          \"effect_estimate\": \"能够预测后续FOG；假阳性率较高；具体数值未报告。\",\n          \"statistical_unit_and_method\": \"算法事件检测和预测；具体混淆矩阵、事件级统计及患者级验证方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性可穿戴设备FOG检测及预测研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"使用既有数据，但原始队列来源及患者数量未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告FOG事件的临床或视频参考标准。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"报告采样率比较，但未提供信号伪迹及无效数据处理细节。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告药物状态、步速和任务难度的预测混杂控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告同一患者多个事件在训练和测试集中的分配方式。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"评估多种任务和采样率，校正方法未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"假阳性率较高，且摘要未报告独立外部验证。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"只有摘要，无法核查完整性能指标。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"这是FOG行为检测及预测方法研究，没有STN神经信号。假阳性率较高限制了其预测结果作为FOG事件标签的可靠性。\",\n          \"quote\": \"the algorithm was able to predict upcoming FOG episodes, but false positive rates were high.\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39957196\",\n        \"title\": \"Subthalamic and nigral stimulation for freezing of gait in Parkinson's disease: Randomized pilot trial.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39957196\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39957196\",\n        \"cohort_relation_basis\": \"双盲、交叉、随机pilot trial；摘要报告至少15名接受过一种联合刺激的FOG患者。未报告中心和招募时间，无法确认与其他DBS队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39957196_E1\",\n          \"design\": \"双盲、交叉、随机pilot trial；不同STN-SNr刺激方案比较。\",\n          \"population\": \"接受STN-DBS且存在FOG的PD患者；15名患者至少接受过一种联合刺激。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 15,\n          \"n_patients_with_FOG\": 15,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要报告15名患者至少接受一种联合刺激，但未明确总随机化人数及完整分析人数。所有研究对象为FOG患者；实际冻结事件数及电极触点数量未报告。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"临床FOG；具体冻结表现未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"摘要未报告各刺激条件下的Med-On或Med-Off状态。\",\n          \"DBS_state_and_parameters\": \"S：高频STN-DBS；C1：高频STN-DBS联合SNr刺激；C2：高频STN-DBS联合低频SNr刺激。每种方案持续1个月。具体频率数值、幅度、脉宽及触点未报告。\",\n          \"task\": \"临床随访及New Freezing of Gait Questionnaire（NFOG-Q）评估；不是事件级步行记录。\",\n          \"recording_location\": \"无STN神经活动记录；STN及SNr为刺激靶点。\",\n          \"measure\": \"NFOG-Q总分变化。\",\n          \"frequency_and_analysis_window\": \"刺激条件持续1个月；NFOG-Q评估时间点及评分变化窗口未在摘要进一步说明。\",\n          \"finding\": \"S、C1和C2三种刺激条件之间NFOG-Q评分变化没有显著差异。该结果没有证明联合STN-SNr刺激在总体患者水平显著改善FOG。\",\n          \"effect_estimate\": \"三组间NFOG-Q变化无显著差异；具体组间差值、置信区间及P值未报告。\",\n          \"statistical_unit_and_method\": \"患者级交叉条件比较；具体交叉模型及携带效应分析未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"RoB 2；随机交叉试验，摘要级初评。\",\n            \"domains\": [\n              {\n                \"domain\": \"随机化过程\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"报告随机交叉设计，但未报告随机序列生成和分配隐藏。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"偏离预定干预\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"报告双盲，但未报告具体盲法执行、刺激偏离及交叉期间携带效应。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"缺失结局数据\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"仅报告15名患者至少接受一种联合刺激，未提供完整随机化及缺失数据流程。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"结局测量\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"NFOG-Q为主观量表，双盲设计有利于减少测量偏倚，但评估流程未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未提供预注册方案及全部次要结局分析细节。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"主要终点为NFOG-Q而非实际冻结事件数量或持续时间。临床刺激效果不能直接证明某种STN神经活动模式与FOG相关。\",\n          \"quote\": \"No significant difference in NFOG-Q scores was found between S, C1, and C2\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"39957196_E2\",\n          \"design\": \"双盲、交叉、随机pilot trial；STN-SNr联合刺激的患者个体反应分析。\",\n          \"population\": \"接受STN-DBS且存在FOG的PD患者；15名患者至少接受一种联合刺激。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": 15,\n          \"n_patients_with_FOG\": 15,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告完整随机化人数、事件数量和具体达到临床改善阈值的患者数，仅报告约三分之一。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"临床FOG；未报告具体冻结类型。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"未报告。\",\n          \"DBS_state_and_parameters\": \"S为高频STN-DBS；C1为高频STN联合SNr刺激；C2为高频STN联合低频SNr刺激；每种条件1个月。\",\n          \"task\": \"NFOG-Q临床量表。\",\n          \"recording_location\": \"无神经记录；STN及SNr为刺激靶点。\",\n          \"measure\": \"NFOG-Q个体变化及临床显著改善阈值。\",\n          \"frequency_and_analysis_window\": \"每个刺激条件持续1个月；具体量表评估时间点未报告。\",\n          \"finding\": \"约三分之一患者在联合刺激条件下表现出至少8分的NFOG-Q临床显著改善。该个体反应不能替代组间显著性检验，也没有对应的STN神经活动记录。\",\n          \"effect_estimate\": \"约1/3患者达到NFOG-Q改善≥8分；具体人数及各联合刺激条件分布未报告。\",\n          \"statistical_unit_and_method\": \"患者级临床反应阈值分析；具体统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"RoB 2；随机交叉试验，摘要级初评。\",\n            \"domains\": [\n              {\n                \"domain\": \"随机化过程\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"摘要报告随机交叉设计，但随机序列生成和分配隐藏细节缺失。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"偏离预定干预\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"双盲设计已报告，但未提供各条件执行及携带效应信息。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"缺失结局数据\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告各条件完成情况及缺失患者数据。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"结局测量\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"NFOG-Q为患者报告量表；评估者盲法及个体阈值的预设依据未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未提供完整预注册及分析方案。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"个体临床反应可能被总体平均结果掩盖，但摘要没有提供患者特征、基线FOG严重程度及反应者预测因素，无法提出确定的响应机制。\",\n          \"quote\": \"one-third of patients showed a clinically significant improvement (≥8 points) with combined stimulations.\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39965098\",\n        \"title\": \"Low β predicts motor output and cell degeneration in the A53T Parkinson's disease rat model.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39965098\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39965098\",\n        \"cohort_relation_basis\": \"原始研究包括AAV-A53T-alpha-synuclein大鼠纵向实验及人类PD数据的转化分析。摘要没有提供大鼠数量和人类数据队列来源，无法确认与其他研究的队列重叠。\",\n        \"source_type\": \"mixed\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39965098_E1\",\n          \"design\": \"AAV-A53T alpha-synuclein大鼠纵向动物实验；STN和运动皮层LFP与运动表现及神经退行性变化关联分析。\",\n          \"population\": \"AAV1/2-A53T alpha-synuclein PD大鼠及empty-vector对照；纵向观察8周。动物数量未在摘要报告。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要未报告动物总数、各组数量及有效电极数。患者相关分母不适用；没有FOG事件计数。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"non_event_gait\",\n          \"freezing_phenotype\": \"not_reported；研究报告运动障碍和运动输出，没有报告FOG。\",\n          \"medication_phenotype\": \"不适用（动物模型）。\",\n          \"experimental_medication_state\": \"AAV-A53T alpha-synuclein模型；纵向8周；未报告药物干预。\",\n          \"DBS_state_and_parameters\": \"未报告DBS。\",\n          \"task\": \"cylinder test及其他行为学运动表现评估。\",\n          \"recording_location\": \"STN及motor cortex；LFP。\",\n          \"measure\": \"低beta及高beta功率、beta burst参数，包括STN long-burst probability；与运动损伤和多巴胺能纤维退变关联。\",\n          \"frequency_and_analysis_window\": \"beta定义为13-30 Hz；摘要未报告具体burst持续时间阈值、分析窗口、基线及归一化方法。\",\n          \"finding\": \"A53T大鼠早期运动缺陷伴随beta功率和burst参数增加；STN高beta功率及burst参数与运动损伤和黑质纹状体多巴胺能神经退变相关。该结果支持STN beta与一般运动障碍的关系，但没有报告FOG。\",\n          \"effect_estimate\": \"STN beta功率及burst参数增加；与运动损伤和多巴胺能退变相关；具体效应量、相关系数、置信区间及P值未报告。\",\n          \"statistical_unit_and_method\": \"纵向动物级行为和LFP分析；多变量分析；具体模型结构和重复测量处理未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性动物电生理及预测研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要未报告动物数量、随机化和纳入排除标准。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"报告cylinder test和运动损伤，但没有FOG事件标签。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告STN和运动皮层LFP伪迹控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告疾病进展、运动表现和多巴胺能退变之间的混杂控制细节。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"纵向8周测量，但未报告动物内重复测量和burst级统计单位处理。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"涉及多个频段、burst参数和脑区，校正方法未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"使用多变量预测模型，但摘要未报告独立测试集及外部验证。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"只有摘要，无法核查全部频段和burst指标。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"这是STN beta与一般运动损伤及神经退变的动物证据，不是FOG特异性证据。不能据此认定高beta或long burst是FOG的特异性标志。\",\n          \"quote\": \"Increased β power and burst parameters accompanied early motor deficits\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"39965098_E2\",\n          \"design\": \"转化分析；大鼠beta活动及多巴胺摄取指标与人类PD运动严重度的关联。\",\n          \"population\": \"人类PD患者；摘要未报告具体样本数量、招募来源及是否为独立患者队列。\",\n          \"n_enrolled\": null,\n          \"n_analyzed\": null,\n          \"n_patients_with_FOG\": null,\n          \"n_patients_with_valid_neural_data\": null,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"人类转化分析的患者数量、数据来源和有效神经数据数量均未在摘要报告；FOG患者及事件数未报告。\",\n          \"endpoint_class\": \"E_questionnaire_rest\",\n          \"event_phase\": \"not_applicable\",\n          \"freezing_phenotype\": \"not_reported。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"摘要明确指出人类运动严重度终点为UPDRS III Med-OFF；人类神经信号采集时的药物状态未明确报告。\",\n          \"DBS_state_and_parameters\": \"人类患者是否接受DBS及STN记录方式未在摘要明确说明。\",\n          \"task\": \"人类PD运动严重度评估；UPDRS III Med-OFF。\",\n          \"recording_location\": \"摘要没有明确说明人类beta信号的具体解剖记录位置及数据来源。\",\n          \"measure\": \"beta活动与dopamine uptake；与UPDRS III Med-OFF运动严重度关联。\",\n          \"frequency_and_analysis_window\": \"beta频段；具体人类数据频段边界、记录窗口和归一化方式未报告。\",\n          \"finding\": \"作者报告大鼠模型结果具有向人类PD转化的相关性，beta活动及多巴胺摄取与人类PD患者UPDRS III Med-OFF运动损伤相关。摘要未报告该关系是否针对FOG亚评分或实际冻结事件。\",\n          \"effect_estimate\": \"报告存在关联；具体人类样本效应量、相关系数、置信区间及P值未报告。\",\n          \"statistical_unit_and_method\": \"人类患者级运动严重度关联；多变量分析；人类数据来源和模型细节未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；转化性观察研究及预测分析。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"人类队列数量、招募来源和纳入标准未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"使用UPDRS III Med-OFF，但没有FOG事件级标签。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"人类beta数据的具体记录来源和信号质量未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告人类药物状态、病程及多巴胺摄取的混杂控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"人类数据的统计单位及重复测量结构未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告多指标模型的多重比较校正。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"报告转化预测模型，但未提供人类独立验证细节。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"仅摘要，无法核查人类分析的完整结果。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"人类转化分析的样本量、STN记录来源和FOG亚组结果均未报告。UPDRS III总体运动严重度不能替代FOG特异性终点。\",\n          \"quote\": \"linking β activity and dopamine uptake to motor impairment (UPDRS III Med-OFF) in human PD patients.\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    },\n    {\n      \"publication\": {\n        \"ref\": \"PMID:39973482\",\n        \"title\": \"Metabolic connectivity of freezing in Parkinson's disease.\",\n        \"publication_status\": \"published\",\n        \"version_of_candidate\": null,\n        \"study_id_candidate\": \"study_candidate_PMID_39973482\",\n        \"cohort_id_candidate\": \"cohort_candidate_PMID_39973482\",\n        \"cohort_relation_basis\": \"摘要报告26名PD患者接受两次FDG-PET检查，其中12人在脑葡萄糖摄取期间出现实际FOG。未报告中心及招募时间，无法确认与其他FOG研究队列重叠。\",\n        \"source_type\": \"primary\",\n        \"basis\": \"abstract\",\n        \"fulltext_checked\": false\n      },\n      \"evidence\": [\n        {\n          \"eid_local\": \"39973482_E1\",\n          \"design\": \"人体观察性代谢影像研究；同一患者静息及实际步行条件下FDG-PET代谢连接比较。\",\n          \"population\": \"26名PD患者，全部在off-drug状态接受两次FDG-PET；其中12名在步行期间脑葡萄糖摄取过程中出现实际FOG。\",\n          \"n_enrolled\": 26,\n          \"n_analyzed\": 26,\n          \"n_patients_with_FOG\": 12,\n          \"n_patients_with_valid_neural_data\": 26,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"患者及实际FOG患者数量明确。摘要未报告冻结事件数量、重复步行试次数和具体PET有效数据排除情况；无电极记录。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"susceptibility\",\n          \"freezing_phenotype\": \"real FoG；具体akinetic、trembling-in-place等表现未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"全部患者off-drug状态。\",\n          \"DBS_state_and_parameters\": \"摘要未报告DBS治疗或刺激参数。\",\n          \"task\": \"第一次PET在静息30分钟后进行；第二次PET在实际步行30分钟后进行。FOG组依据步行期间实际出现FOG划分。\",\n          \"recording_location\": \"全脑FDG-PET代谢连接矩阵；不是STN LFP或直接神经电活动记录。\",\n          \"measure\": \"静息条件下脑区间代谢连接。\",\n          \"frequency_and_analysis_window\": \"静息30分钟后的FDG摄取条件；代谢连接计算窗口及归一化方法未报告。\",\n          \"finding\": \"在静息条件下，FOG组相对于non-freezing组表现为脑区间整体代谢连接降低。由于该静息条件并非冻结事件本身，因此是FOG表型相关的非事件期网络差异。\",\n          \"effect_estimate\": \"整体代谢连接降低；具体连接系数、效应量、置信区间及P值未报告。\",\n          \"statistical_unit_and_method\": \"患者组别及条件级代谢连接矩阵比较；具体统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性代谢影像及脑网络连接研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"总样本26人，FOG组12人；招募来源及排除流程未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要报告实际FOG，但未说明视频或临床确认方法。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告PET图像质量控制、配准和运动伪迹处理。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"所有患者均为off-drug，但未报告其他临床严重度及认知差异控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"同一患者接受两种条件，但配对统计和连接矩阵重复测量处理未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"涉及多脑区连接矩阵，但摘要未报告多重比较校正。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"摘要未报告预测模型。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"仅摘要，无法核查所有脑区连接结果。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"静息条件结果是FOG患者组的表型相关性，不是冻结事件发生时的神经信号。PET代谢连接不能与STN LFP功率、burst或相位调制直接比较。\",\n          \"quote\": \"In the rest condition, the freezing group showed globally reduced metabolic connectivity between brain regions compared to the non-freezing group.\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"39973482_E2\",\n          \"design\": \"人体观察性代谢影像研究；实际步行条件下FOG组与non-freezing组的网络连接比较。\",\n          \"population\": \"26名off-drug PD患者；12名患者在脑葡萄糖摄取期间出现实际FOG。\",\n          \"n_enrolled\": 26,\n          \"n_analyzed\": 26,\n          \"n_patients_with_FOG\": 12,\n          \"n_patients_with_valid_neural_data\": 26,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"摘要报告12名FOG患者，但未报告实际冻结事件数量和每名患者的冻结次数。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"during_FOG\",\n          \"freezing_phenotype\": \"real FoG；具体表现类型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"off-drug。\",\n          \"DBS_state_and_parameters\": \"未报告DBS。\",\n          \"task\": \"实际直立步行30分钟后的FDG-PET代谢摄取；12名患者在摄取期间出现实际FOG。\",\n          \"recording_location\": \"全脑FDG-PET代谢连接网络。\",\n          \"measure\": \"小脑、小脑-皮层环路、顶叶-额叶及视觉皮层代谢连接。\",\n          \"frequency_and_analysis_window\": \"步行30分钟后的FDG摄取；具体代谢时间窗及连接归一化方式未报告。\",\n          \"finding\": \"在步行条件下，FOG组观察到小脑、小脑-皮层环路和顶叶-额叶区域的代谢连接增强，并伴随较高视觉皮层募集。该结果反映实际步行条件下的网络代谢差异，但不是事件级STN信号。\",\n          \"effect_estimate\": \"连接增强及视觉皮层募集增加；具体连接系数、效应量、置信区间和P值未报告。\",\n          \"statistical_unit_and_method\": \"患者组别及步行条件连接矩阵比较；具体统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性代谢影像研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"总样本26人，FOG组12人，样本量有限。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要没有报告实际FOG的独立视频评审或临床确认流程。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告PET运动伪迹、图像配准及代谢信号质量控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"off-drug状态一致，但步行能力和疾病严重度等混杂未说明。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"同一患者静息与步行条件的配对分析方法未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"多个脑网络和连接区域被比较，校正方法未报告。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"没有报告预测模型。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"摘要不足以判断所有连接分析是否报告。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"步行条件的PET代谢信号具有时间积分特征，不等同于冻结发生瞬间的神经振荡。不能据此推断STN beta在FOG期间升高或降低。\",\n          \"quote\": \"During gait, enhanced connectivity was observed in the cerebellum, cerebello-cortical loops and parieto-frontal regions, with high recruitment of the visual cortex in the freezing group.\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        },\n        {\n          \"eid_local\": \"39973482_E3\",\n          \"design\": \"人体观察性代谢影像研究；步行条件下特定脑网络连接的组间比较。\",\n          \"population\": \"26名off-drug PD患者；12名在步行摄取期间出现实际FOG。\",\n          \"n_enrolled\": 26,\n          \"n_analyzed\": 26,\n          \"n_patients_with_FOG\": 12,\n          \"n_patients_with_valid_neural_data\": 26,\n          \"n_FOG_events\": null,\n          \"n_trials\": null,\n          \"n_electrodes_contacts\": null,\n          \"missing_reason\": \"冻结事件数和重复步行次数未报告；没有STN电极记录。\",\n          \"endpoint_class\": \"unclear\",\n          \"event_phase\": \"during_FOG\",\n          \"freezing_phenotype\": \"real FoG；具体运动学类型未报告。\",\n          \"medication_phenotype\": \"unknown\",\n          \"experimental_medication_state\": \"off-drug。\",\n          \"DBS_state_and_parameters\": \"未报告DBS。\",\n          \"task\": \"实际步行30分钟后的FDG-PET摄取条件。\",\n          \"recording_location\": \"小脑网络及occipito-frontal网络；全脑PET代谢连接。\",\n          \"measure\": \"小脑网络内部代谢连接及occipito-frontal连接。\",\n          \"frequency_and_analysis_window\": \"步行后FDG代谢摄取条件；具体连接计算窗口未报告。\",\n          \"finding\": \"尽管FOG组在步行期间表现出部分小脑及小脑-皮层网络连接增强，但小脑网络内部连接仍低于non-freezing组；同时occipito-frontal连接高于non-freezing组。不同网络方向并不一致。\",\n          \"effect_estimate\": \"小脑内部连接降低；occipito-frontal连接升高；具体效应量、置信区间及P值未报告。\",\n          \"statistical_unit_and_method\": \"患者组别连接矩阵比较；具体统计方法未报告。\",\n          \"risk_of_bias\": {\n            \"tool_or_framework\": \"adapted_not_validated；观察性代谢影像研究。\",\n            \"domains\": [\n              {\n                \"domain\": \"样本选择\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"FOG组仅12人，摘要未提供招募和排除流程。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"行为标签有效性\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"FOG事件的确认方法未在摘要说明。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"信号质量及伪迹\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告PET图像质量控制和连接矩阵稳定性。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"混杂\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告步态严重度、视觉依赖和疾病阶段等因素控制。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"重复测量及伪重复\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"未报告患者内重复条件及网络连接统计结构。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"多重比较\",\n                \"judgement\": \"some_concerns\",\n                \"reason\": \"比较多个网络连接，摘要未报告校正方法。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"模型过拟合及外部验证\",\n                \"judgement\": \"not_assessable\",\n                \"reason\": \"未报告预测模型。\",\n                \"source_locator\": \"Abstract\"\n              },\n              {\n                \"domain\": \"选择性报告\",\n                \"judgement\": \"unclear\",\n                \"reason\": \"只有摘要，不能确认所有网络连接均已报告。\",\n                \"source_locator\": \"Abstract\"\n              }\n            ],\n            \"overall\": \"some_concerns\"\n          },\n          \"limitations\": \"该结果显示网络内部和网络间连接可以呈现不同方向，不能用一个整体的脑连接增强或降低概括。没有STN特异性记录，也没有事件级神经时间序列。\",\n          \"quote\": \"connectivity inside cerebellar networks remained lower in the freezing group than in the non-freezing group, while occipito-frontal connectivity was higher in the freezing group.\",\n          \"source_locator\": {\n            \"section\": \"Abstract\",\n            \"page\": null,\n            \"figure_table\": null,\n            \"supplement\": null\n          },\n          \"basis\": \"abstract\"\n        }\n      ]\n    }\n  ]\n}</escape>", "metadata": {"session_handle": "a0a7e9a1-ab3d-406c-8711-21506885ea08", "session_revision": 0, "session_ttl_max_hours": 6, "job_directory": "D:\\musicclaude\\gpt2agent-safechain\\runs\\gpt3\\pro-bridge-20261113T133119275209Z", "elapsed_seconds": 781.469, "completed_utc": "2026-11-13T13:44:20.750262+00:00", "model": "gpt-6-thinking", "thinking_effort": "max", "temporary": true, "unpersonalized": true, "generation_policy_verified": true, "request_policy": {"model": "gpt-6-thinking", "thinking_effort": "max", "history_and_training_disabled": true, "temporary_chat_requests_personalization": false, "is_do_not_remember": false, "continuation": false, "unpersonalized_inherited_verified": false, "body_sha256": "7d4bc428358d5680413aba818ff7772d2a2731bbe46b627e2023f29da2311e2b", "attachment_count": 0}, "stream_completion": {"sse_done": true, "message_completed": true, "independent_terminal_verified": true}, "profile": "yi/local-codex-auth", "account_sha256": "b3efb6361563c139233ed7b7ef61a7c9afe0bd48d4eb3525dbe31956b024d6da", "transport": "probridge-pure-http", "resume_requests": 0, "topic_connections": 0, "browser_starte